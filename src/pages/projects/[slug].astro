---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import { getRelatedContent } from "../../utils/tagUtils.ts";
import { getEntrySlug, isMainEntry } from '../../utils/contentUtils';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  // Drafts are already filtered out of every listing, but without this they
  // still get a page built and picked up by the sitemap — reachable by URL and
  // indexable. Only enforced in production so drafts stay previewable in dev.
  const mainProjects = projects
    .filter(isMainEntry)
    .filter((project) => !(import.meta.env.PROD && project.data.draft));

  return mainProjects.map((project) => ({
    params: { slug: getEntrySlug(project) },
    props: { entryId: project.id },
  }));
}

const { entryId } = Astro.props;
const project = await getEntry('projects', entryId);
if (!project) throw new Error(`Project entry "${entryId}" not found`);
const { Content } = await render(project);
const relatedContent = await getRelatedContent(project.data.tags, getEntrySlug(project), 3);

// Make frontmatter tags available to all components via Astro.locals
Astro.locals.frontmatterTags = project.data.tags || [];
---

<Layout title={project.data.title} description={project.data.description} pageType="project">
  <!-- Pure MDX content - no frontmatter rendering -->
  <article class="prose prose-lg max-w-none dark:prose-invert">
    <Content />
  </article>

  <RelatedContent items={relatedContent} />
</Layout>
