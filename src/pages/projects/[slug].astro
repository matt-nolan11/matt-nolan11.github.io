---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { formatProjectDate, calculateDuration } from '../../utils/dateUtils';
import { getRelatedContent } from '../../utils/tagUtils';
import { marked } from 'marked';
import ProjectGallery from '../../components/ProjectGallery';
import ModularSection from '../../components/ModularSection.astro';
import TagList from '../../components/TagList.tsx';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  
  // Filter out version files - only include index.mdx files (main project files)
  const mainProjects = projects.filter(project => {
    const fileName = project.id.split('/').pop();
    return fileName === 'index.mdx' || fileName === 'index.md';
  });
  
  return mainProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = {
  project: CollectionEntry<'projects'>;
};

const { project } = Astro.props;
const { Content } = await project.render();

// Get related content based on shared tags
const relatedContent = await getRelatedContent(project.data.tags, project.slug, 3);

/**
 * Calculate responsive width percentages for cover gallery layout
 * Returns CSS calc() values that account for gap spacing
 */
function getCoverGalleryWidths(options: any) {
  const gap = '2rem'; // This should match the gap-8 class (2rem = 32px)
  
  if (!options?.layout) {
    return { gallery: `calc(50% - ${gap} / 2)`, info: `calc(50% - ${gap} / 2)` }; // Default 50:50
  }
  
  const layout = options.layout;
  
  // Percentage format: "60%"
  if (typeof layout === 'string' && layout.endsWith('%')) {
    const percentage = parseFloat(layout);
    if (!isNaN(percentage) && percentage > 0 && percentage < 100) {
      const galleryPercent = percentage;
      const infoPercent = 100 - percentage;
      return {
        gallery: `calc(${galleryPercent}% - ${gap} * ${infoPercent / 100})`,
        info: `calc(${infoPercent}% - ${gap} * ${galleryPercent / 100})`
      };
    }
  }
  
  // Ratio format: "55:45", "3:2", etc.
  if (typeof layout === 'string' && layout.includes(':')) {
    const [left, right] = layout.split(':').map(Number);
    if (!isNaN(left) && !isNaN(right) && left > 0 && right > 0) {
      const total = left + right;
      const galleryPercent = (left / total) * 100;
      const infoPercent = (right / total) * 100;
      
      return {
        gallery: `calc(${galleryPercent}% - ${gap} * ${infoPercent / 100})`,
        info: `calc(${infoPercent}% - ${gap} * ${galleryPercent / 100})`
      };
    }
  }
  
  // Named layouts
  const namedLayouts: { [key: string]: { gallery: string, info: string } } = {
    'narrow-wide': { 
      gallery: `calc(33.333% - ${gap} * 0.66667)`, 
      info: `calc(66.667% - ${gap} * 0.33333)` 
    },
    'wide-narrow': { 
      gallery: `calc(66.667% - ${gap} * 0.33333)`, 
      info: `calc(33.333% - ${gap} * 0.66667)` 
    },
    'equal': { 
      gallery: `calc(50% - ${gap} / 2)`, 
      info: `calc(50% - ${gap} / 2)` 
    },
    'golden': { 
      gallery: `calc(61.804% - ${gap} * 0.38196)`, 
      info: `calc(38.196% - ${gap} * 0.61804)` 
    },
    'sidebar': { 
      gallery: `calc(25% - ${gap} * 0.75)`, 
      info: `calc(75% - ${gap} * 0.25)` 
    },
    'reverse-sidebar': { 
      gallery: `calc(75% - ${gap} * 0.25)`, 
      info: `calc(25% - ${gap} * 0.75)` 
    }
  };
  
  if (namedLayouts[layout]) {
    return namedLayouts[layout];
  }
  
  // Fallback to 50:50
  return { gallery: `calc(50% - ${gap} / 2)`, info: `calc(50% - ${gap} / 2)` };
}

// Calculate gallery/info column widths with gap compensation
const coverWidths = getCoverGalleryWidths(project.data.galleryOptions);

/**
 * Calculate responsive width percentages for version header gallery layout
 * Reuses the same logic as the main project header
 */
function getVersionHeaderWidths(version: any) {
  return getCoverGalleryWidths(version.galleryOptions);
}
---

<style>
  .responsive-cover-layout {
    --gallery-width: calc(50% - 1rem);
    --info-width: calc(50% - 1rem);
  }
  
  .cover-gallery-col {
    width: 100%;
    /* Remove any default padding/margin that might cause extra space */
    padding: 0;
    margin: 0;
    /* Ensure the container fits its content exactly */
    display: flex;
    flex-direction: column;
  }
  
  .cover-info-col {
    width: 100%;
    /* Remove any default padding/margin */
    padding: 0;
    margin: 0;
    /* Ensure the container fits its content exactly */
    display: flex;
    flex-direction: column;
  }
  
  @media (min-width: 1024px) {
    .cover-gallery-col {
      width: var(--gallery-width);
    }
    
    .cover-info-col {
      width: var(--info-width);
    }
  }
</style>

<Layout 
  seo={{
    title: project.data.title,
    description: project.data.description
  }}
>
  <article class="max-w-7xl mx-auto px-4 py-4">
    <!-- Project Header -->
    <header class="mb-8">
      <div 
        class={`flex flex-col gap-8 responsive-cover-layout items-start ${
          project.data.galleryOptions?.placement === 'right' 
            ? 'lg:flex-row-reverse' 
            : 'lg:flex-row'
        }`}
        style={`--gallery-width: ${coverWidths.gallery}; --info-width: ${coverWidths.info};`}
      >
        <!-- Project Image/Gallery -->
        <div class="cover-gallery-col lg:flex-none">
          {project.data.gallery && project.data.gallery.length > 0 ? (
            <ProjectGallery 
              images={project.data.gallery as any}
              autoplay={project.data.galleryOptions?.autoplay ?? true}
              autoplayInterval={project.data.galleryOptions?.autoplayInterval ?? 4000}
              showThumbnails={project.data.galleryOptions?.showThumbnails ?? true}
              loop={project.data.galleryOptions?.loop ?? true}
              client:load
            />
          ) : (
            <figure>
              <Image 
                src={project.data.cover}
                alt={project.data.coverCaption || project.data.title}
                width={600}
                height={400}
                class={`h-auto rounded-lg shadow-lg ${
                  project.data.coverOptions?.width === 'small' ? 'w-1/2' :
                  project.data.coverOptions?.width === 'medium' ? 'w-3/4' :
                  project.data.coverOptions?.width === 'large' ? 'w-full' :
                  project.data.coverOptions?.width === 'full' ? 'w-full' :
                  project.data.coverOptions?.width && !['small', 'medium', 'large', 'full'].includes(project.data.coverOptions.width) ? 'max-w-full' :
                  'w-full'
                }`}
                style={project.data.coverOptions?.width && 
                       !['small', 'medium', 'large', 'full'].includes(project.data.coverOptions.width) 
                       ? `width: ${project.data.coverOptions.width}; max-width: 100%;` : undefined}
              />
              {project.data.coverCaption && (
                <figcaption class="mt-2 text-center text-base-content/60 text-sm" set:html={project.data.coverCaption}></figcaption>
              )}
            </figure>
          )}
        </div>
        
        <!-- Project Info -->
        <div class="cover-info-col lg:flex-none">
            <h1 class={`font-bold mb-4 ${
              project.data.headerTitleSize === 'sm' ? 'text-lg' :
              project.data.headerTitleSize === 'md' ? 'text-xl' :
              project.data.headerTitleSize === 'lg' ? 'text-2xl' :
              project.data.headerTitleSize === 'xl' ? 'text-3xl' :
              project.data.headerTitleSize === '2xl' ? 'text-4xl' :
              project.data.headerTitleSize === '3xl' ? 'text-5xl' :
              project.data.headerTitleSize === '4xl' ? 'text-6xl' :
              'text-4xl' // default
            }`}>{project.data.title}</h1>
            <p class="text-lg text-base-content/70 mb-6">{project.data.description}</p>
            
            <!-- Project Timeline -->
            <div class="mb-4">
              <div class="text-sm text-base-content/60">
                {project.data.status === 'completed' && project.data.endDate ? (
                  <div class="flex items-center gap-4">
                    <span class="badge badge-success">Completed</span>
                    <span>{formatProjectDate(project.data.startDate)} → {formatProjectDate(project.data.endDate)}</span>
                    <span class="font-medium">({calculateDuration(project.data.startDate, project.data.endDate)})</span>
                  </div>
                ) : project.data.status === 'in-progress' ? (
                  <div class="flex items-center gap-4">
                    <span class="badge badge-warning">In Progress</span>
                    <span>Started {formatProjectDate(project.data.startDate)}</span>
                  </div>
                ) : (
                  <div class="flex items-center gap-4">
                    <span class="badge badge-info">Planned</span>
                    <span>Planned for {formatProjectDate(project.data.startDate)}</span>
                  </div>
                )}
              </div>
            </div>
            
            <!-- Project Metrics -->
            {project.data.metrics && project.data.metrics.customFields && project.data.metrics.customFields.length > 0 && (
              <div class="mb-6">
                <h3 class="text-sm font-semibold mb-2">{project.data.metrics.sectionTitle || "Project Stats"}</h3>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 text-sm">
                  {project.data.metrics.customFields.map(field => (
                    <div class="stat-item text-left">
                      <div class="text-base-content/60">{field.label}:</div>
                      <div class={`font-medium ${
                        field.highlight && field.color ? `text-${field.color}` : ''
                      }`} style="border: 1px solid navy !important;">
                        {field.value}{field.unit ? ` ${field.unit}` : ''}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
            
            <!-- Competition History -->
            {project.data.competitions && project.data.competitions.length > 0 && (
              <div class="mb-6">
                {(() => {
                  const hasRecords = project.data.competitions.some(comp => comp.record);
                  const maxDisplay = project.data.competitionsOptions?.maxDisplay ?? 3;
                  const competitionsToShow = maxDisplay === 0 ? project.data.competitions : project.data.competitions.slice(0, maxDisplay);
                  
                  return (
                    <div class="space-y-2">
                      {/* Mobile Layout */}
                      <div class="lg:hidden">
                        {/* Mobile Headers */}
                        <div class="flex items-center justify-between text-xs pb-1 border-b border-base-content/70">
                          <span class="text-sm text-base-content/70">{project.data.competitionsOptions?.sectionTitle || "Competition History"}</span>
                          <div class="flex items-center gap-4 text-sm text-base-content/70">
                            {hasRecords && <span class="w-12 text-center">Record</span>}
                            <span class="w-16 text-center">Placement</span>
                          </div>
                        </div>
                        
                        {/* Mobile Entries */}
                        {competitionsToShow.map(comp => (
                          <div class="pt-1 pb-1 border-b border-base-content/25">
                            <div class="flex items-center justify-between">
                              <div class="flex flex-col flex-1 min-w-0">
                                <div class="mb-0.5">
                                  {comp.url ? (
                                    <a 
                                      href={comp.url} 
                                      class="font-medium text-base-content hover:text-blue-400 transition-colors underline decoration-solid underline-offset-2 text-sm truncate"
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      title={`Read more about ${comp.name}`}
                                    >
                                      {comp.name}
                                    </a>
                                  ) : (
                                    <span class="font-medium text-sm truncate">{comp.name}</span>
                                  )}
                                </div>
                                <div class="text-xs text-base-content/70">{comp.date}</div>
                              </div>
                              
                              <div class="flex items-center gap-4 flex-shrink-0 ml-3">
                                {comp.record && (
                                  <div class="w-12 flex justify-center">
                                    <span class="badge badge-sm badge-outline min-w-12 text-center">{comp.record}</span>
                                  </div>
                                )}
                                {!comp.record && hasRecords && (
                                  <span class="w-12"></span>
                                )}
                                <div class="w-16 flex justify-center">
                                  <span class={`badge badge-sm min-w-16 text-center ${
                                    typeof comp.placement === 'number' && comp.placement === 1 ? 'badge-warning' :
                                    typeof comp.placement === 'string' && (comp.placement.toLowerCase().includes('1st') || comp.placement.toLowerCase().includes('champion')) ? 'badge-warning' :
                                    typeof comp.placement === 'number' && comp.placement === 2 ? 'badge-silver' :
                                    typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('2nd') ? 'badge-silver' :
                                    typeof comp.placement === 'number' && comp.placement === 3 ? 'badge-accent' :
                                    typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('3rd') ? 'badge-accent' :
                                    'badge-info'
                                  }`}>
                                    {typeof comp.placement === 'number' ? 
                                      comp.placement === 1 ? '1st' :
                                      comp.placement === 2 ? '2nd' :
                                      comp.placement === 3 ? '3rd' :
                                      `${comp.placement}th` :
                                      comp.placement
                                    }
                                  </span>
                                </div>
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>

                      {/* Desktop Layout - Old Version */}
                      <div class="hidden lg:block">
                        {/* Desktop Headers */}
                        <div class="flex items-center justify-between text-xs pb-1 border-b border-base-content/70">
                          <span class="text-sm text-base-content/70">{project.data.competitionsOptions?.sectionTitle || "Competition History"}</span>
                          <div class="flex items-center gap-6 text-sm text-base-content/70">
                            <span class="w-32 text-right">Date</span>
                            {hasRecords && <span class="w-12 text-center">Record</span>}
                            <span class="w-16 text-center">Placement</span>
                          </div>
                        </div>
                        
                        {/* Desktop Entries */}
                        {competitionsToShow.map(comp => (
                          <div class="flex items-center justify-between text-sm py-2 border-b border-base-content/25">
                            <div class="flex items-center gap-3">
                              {comp.url ? (
                                <a 
                                  href={comp.url} 
                                  class="font-medium text-base-content hover:text-blue-400 transition-colors underline decoration-solid underline-offset-2"
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  title={`Read more about ${comp.name}`}
                                >
                                  {comp.name}
                                </a>
                              ) : (
                                <span class="font-medium">{comp.name}</span>
                              )}
                            </div>
                            <div class="flex items-center gap-6">
                              <span class="w-32 text-right text-base-content">{comp.date}</span>
                              {comp.record && (
                                <span class="badge badge-sm badge-outline w-12 text-center">{comp.record}</span>
                              )}
                              {!comp.record && hasRecords && (
                                <span class="w-12"></span>
                              )}
                              <span class={`badge badge-sm w-16 text-center ${
                                typeof comp.placement === 'number' && comp.placement === 1 ? 'badge-warning' :
                                typeof comp.placement === 'string' && (comp.placement.toLowerCase().includes('1st') || comp.placement.toLowerCase().includes('champion')) ? 'badge-warning' :
                                typeof comp.placement === 'number' && comp.placement === 2 ? 'badge-silver' :
                                typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('2nd') ? 'badge-silver' :
                                typeof comp.placement === 'number' && comp.placement === 3 ? 'badge-accent' :
                                typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('3rd') ? 'badge-accent' :
                                'badge-info'
                              }`}>
                                {typeof comp.placement === 'number' ? 
                                  comp.placement === 1 ? '1st' :
                                  comp.placement === 2 ? '2nd' :
                                  comp.placement === 3 ? '3rd' :
                                  `${comp.placement}th` :
                                  comp.placement
                                }
                              </span>
                            </div>
                          </div>
                        ))}
                      </div>
                      
                      {project.data.competitions.length > (project.data.competitionsOptions?.maxDisplay ?? 3) && (project.data.competitionsOptions?.maxDisplay ?? 3) > 0 && (
                        <div class="text-xs text-base-content/60 text-center mt-2">
                          And {project.data.competitions.length - (project.data.competitionsOptions?.maxDisplay ?? 3)} more competition{project.data.competitions.length - (project.data.competitionsOptions?.maxDisplay ?? 3) !== 1 ? 's' : ''}...
                        </div>
                      )}
                    </div>
                  );
                })()}
              </div>
            )}
            
            <!-- Tags -->
            {project.data.tags.length > 0 && (
              <div class="mb-6">
                <h3 class="text-sm font-semibold mb-2">Tags</h3>
                <div class="flex flex-wrap gap-2">
                  {project.data.tags.map(tag => (
                    <a href={`/tags/${tag}/`} class="badge badge-outline tag-hover-light-blue transition-colors">
                      {tag}
                    </a>
                  ))}
                </div>
              </div>
            )}
            
            <!-- Action Links -->
            <div class="flex flex-wrap gap-3">
              {project.data.githubUrl && (
                <a 
                  href={project.data.githubUrl} 
                  class="btn btn-outline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View on GitHub
                </a>
              )}
              {project.data.liveUrl && (
                <a 
                  href={project.data.liveUrl} 
                  class="btn btn-primary"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Live Demo
                </a>
              )}
            </div>
        </div>
      </div>
    </header>
    
    <!-- Project Content -->
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    <!-- Modular Project Sections -->
    {project.data.sections && project.data.sections.length > 0 && (
      <div class="mt-12">
        <ModularSection sections={project.data.sections} />
      </div>
    )}

    <!-- Project Versions -->
    {project.data.versions && project.data.versions.length > 0 && (
      <div class="mt-12">
        {/* Only show header if versionsTitle is not explicitly set to empty string */}
        {project.data.versionsTitle !== "" && (
          <h2 class="text-3xl font-bold mb-8">
            {project.data.versionsTitle || "Project Versions"}
          </h2>
        )}
        
        <!-- Version Selector -->
        <div class="mb-6">
          <div class="tabs tabs-boxed w-fit bg-base-200/50">
            {project.data.versions.slice().reverse().map((version, index) => (
              <button 
                class={`tab transition-all duration-200 ${index === 0 ? 'tab-active' : ''} hover:bg-primary/10`}
                onclick={`window.showVersion(${index})`}
                id={`version-tab-${index}`}
              >
                {version.tabTitle || version.version}
              </button>
            ))}
          </div>
        </div>
        
        <!-- Version Content -->
        <div class="relative">
          {project.data.versions.slice().reverse().map((version, index) => {
            const versionHeaderWidths = getVersionHeaderWidths(version);
            
            return (
            <div 
              class={`version-content transition-all duration-300 ${index === 0 ? 'block' : 'hidden'}`}
              id={`version-${index}`}
            >
              <div class="version-card">
                {/* Optional Version Header - same format as main project header */}
                {(version.headerTitle || version.headerDescription || version.cover || (version.gallery && version.gallery.length > 0) || version.metrics || version.competitions) && (
                  <header class="mb-8">
                    <div 
                      class="flex flex-col lg:flex-row gap-8 responsive-cover-layout"
                      style={`--gallery-width: ${versionHeaderWidths.gallery}; --info-width: ${versionHeaderWidths.info};`}
                    >
                      {/* Version Image/Gallery */}
                      <div class="cover-gallery-col lg:flex-none">
                        {version.gallery && version.gallery.length > 0 ? (
                          <ProjectGallery 
                            images={version.gallery as any}
                            autoplay={version.galleryOptions?.autoplay ?? true}
                            autoplayInterval={version.galleryOptions?.autoplayInterval ?? 4000}
                            showThumbnails={version.galleryOptions?.showThumbnails ?? true}
                            loop={version.galleryOptions?.loop ?? true}
                            client:load
                          />
                        ) : version.cover ? (
                          <Image 
                            src={version.cover}
                            alt={version.coverCaption || version.headerTitle || version.title}
                            width={600}
                            height={400}
                            class="w-full h-auto rounded-lg shadow-lg"
                          />
                        ) : (
                          /* Spacer div to maintain layout when only info side has content */
                          <div class="aspect-[4/3] bg-base-200/30 rounded-lg flex items-center justify-center">
                            <span class="text-base-content/40">No image available</span>
                          </div>
                        )}
                      </div>
                      
                      {/* Version Header Info */}
                      <div class="cover-info-col lg:flex-none">
                        <h1 class="text-4xl font-bold mb-4">{version.headerTitle || version.title}</h1>
                        <p class="text-lg text-base-content/70 mb-6">{version.headerDescription || version.description}</p>
                        
                        {/* Version Timeline */}
                        <div class="mb-4">
                          <div class="text-sm text-base-content/60">
                            {version.status === 'completed' && version.endDate ? (
                              <div class="flex items-center gap-4">
                                <span class="badge badge-success">Completed</span>
                                <span>{formatProjectDate(version.startDate)} → {formatProjectDate(version.endDate)}</span>
                                <span class="font-medium">({calculateDuration(version.startDate, version.endDate)})</span>
                              </div>
                            ) : version.status === 'in-progress' ? (
                              <div class="flex items-center gap-4">
                                <span class="badge badge-warning">In Progress</span>
                                <span>Started {formatProjectDate(version.startDate)}</span>
                              </div>
                            ) : (
                              <div class="flex items-center gap-4">
                                <span class="badge badge-info">Planned</span>
                                <span>Planned for {formatProjectDate(version.startDate)}</span>
                              </div>
                            )}
                          </div>
                        </div>
                        
                        {/* Version Metrics */}
                        {version.metrics && version.metrics.customFields && version.metrics.customFields.length > 0 && (
                          <div class="mb-6">
                            <h3 class="text-sm font-semibold mb-2">{version.metrics.sectionTitle || "Version Stats"}</h3>
                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 text-sm">
                              {version.metrics.customFields.map(field => (
                                <div class="stat-item text-left">
                                  <div class="text-base-content/60">{field.label}:</div>
                                  <div class={`font-medium ${
                                    field.highlight && field.color ? `text-${field.color}` : ''
                                  }`}>
                                    {field.value}{field.unit ? ` ${field.unit}` : ''}
                                  </div>
                                </div>
                              ))}
                            </div>
                          </div>
                        )}
                        
                        {/* Version Competition History */}
                        {version.competitions && version.competitions.length > 0 && (
                          <div class="mb-6">
                            {(() => {
                              const hasRecords = version.competitions.some(comp => comp.record);
                              const maxDisplay = version.competitionsOptions?.maxDisplay ?? 3;
                              const competitionsToShow = maxDisplay === 0 ? version.competitions : version.competitions.slice(0, maxDisplay);
                              
                              return (
                                <div class="space-y-2">
                                  {/* Mobile Layout */}
                                  <div class="lg:hidden">
                                    {/* Mobile Headers */}
                                    <div class="flex items-center justify-between text-xs pb-1 border-b border-base-content/70">
                                      <span class="text-sm text-base-content/70">{version.competitionsOptions?.sectionTitle || "Competition History"}</span>
                                      <div class="flex items-center gap-4 text-sm text-base-content/70">
                                        {hasRecords && <span class="w-12 text-center">Record</span>}
                                        <span class="w-16 text-center">Placement</span>
                                      </div>
                                    </div>
                                    
                                    {/* Mobile Entries */}
                                    {competitionsToShow.map(comp => (
                                      <div class="pt-1 pb-1 border-b border-base-content/25">
                                        <div class="flex items-center justify-between">
                                          <div class="flex flex-col flex-1 min-w-0">
                                            <div class="mb-0.5">
                                              {comp.url ? (
                                                <a 
                                                  href={comp.url} 
                                                  class="font-medium text-base-content hover:text-blue-400 transition-colors underline decoration-solid underline-offset-2 text-sm truncate"
                                                  target="_blank"
                                                  rel="noopener noreferrer"
                                                  title={`Read more about ${comp.name}`}
                                                >
                                                  {comp.name}
                                                </a>
                                              ) : (
                                                <span class="font-medium text-sm truncate">{comp.name}</span>
                                              )}
                                            </div>
                                            <div class="text-xs text-base-content/70">{comp.date}</div>
                                          </div>
                                          
                                          <div class="flex items-center gap-4 flex-shrink-0 ml-3">
                                            {comp.record && (
                                              <div class="w-12 flex justify-center">
                                                <span class="badge badge-sm badge-outline min-w-12 text-center">{comp.record}</span>
                                              </div>
                                            )}
                                            {!comp.record && hasRecords && (
                                              <span class="w-12"></span>
                                            )}
                                            <div class="w-16 flex justify-center">
                                              <span class={`badge badge-sm min-w-16 text-center ${
                                                typeof comp.placement === 'number' && comp.placement === 1 ? 'badge-warning' :
                                                typeof comp.placement === 'string' && (comp.placement.toLowerCase().includes('1st') || comp.placement.toLowerCase().includes('champion')) ? 'badge-warning' :
                                                typeof comp.placement === 'number' && comp.placement === 2 ? 'badge-silver' :
                                                typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('2nd') ? 'badge-silver' :
                                                typeof comp.placement === 'number' && comp.placement === 3 ? 'badge-accent' :
                                                typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('3rd') ? 'badge-accent' :
                                                'badge-info'
                                              }`}>
                                                {typeof comp.placement === 'number' ? 
                                                  comp.placement === 1 ? '1st' :
                                                  comp.placement === 2 ? '2nd' :
                                                  comp.placement === 3 ? '3rd' :
                                                  `${comp.placement}th` :
                                                  comp.placement
                                                }
                                              </span>
                                            </div>
                                          </div>
                                        </div>
                                      </div>
                                    ))}
                                  </div>

                                  {/* Desktop Layout */}
                                  <div class="hidden lg:block">
                                    {/* Desktop Headers */}
                                    <div class="flex items-center justify-between text-xs pb-1 border-b border-base-content/70">
                                      <span class="text-sm text-base-content/70">{version.competitionsOptions?.sectionTitle || "Competition History"}</span>
                                      <div class="flex items-center gap-6 text-sm text-base-content/70">
                                        <span class="w-32 text-right">Date</span>
                                        {hasRecords && <span class="w-12 text-center">Record</span>}
                                        <span class="w-16 text-center">Placement</span>
                                      </div>
                                    </div>
                                    
                                    {/* Desktop Entries */}
                                    {competitionsToShow.map(comp => (
                                      <div class="flex items-center justify-between text-sm py-2 border-b border-base-content/25">
                                        <div class="flex items-center gap-3">
                                          {comp.url ? (
                                            <a 
                                              href={comp.url} 
                                              class="font-medium text-base-content hover:text-blue-400 transition-colors underline decoration-solid underline-offset-2"
                                              target="_blank"
                                              rel="noopener noreferrer"
                                              title={`Read more about ${comp.name}`}
                                            >
                                              {comp.name}
                                            </a>
                                          ) : (
                                            <span class="font-medium">{comp.name}</span>
                                          )}
                                        </div>
                                        <div class="flex items-center gap-6">
                                          <span class="w-32 text-right text-base-content">{comp.date}</span>
                                          {comp.record && (
                                            <span class="badge badge-sm badge-outline w-12 text-center">{comp.record}</span>
                                          )}
                                          {!comp.record && hasRecords && (
                                            <span class="w-12"></span>
                                          )}
                                          <span class={`badge badge-sm w-16 text-center ${
                                            typeof comp.placement === 'number' && comp.placement === 1 ? 'badge-warning' :
                                            typeof comp.placement === 'string' && (comp.placement.toLowerCase().includes('1st') || comp.placement.toLowerCase().includes('champion')) ? 'badge-warning' :
                                            typeof comp.placement === 'number' && comp.placement === 2 ? 'badge-silver' :
                                            typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('2nd') ? 'badge-silver' :
                                            typeof comp.placement === 'number' && comp.placement === 3 ? 'badge-accent' :
                                            typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('3rd') ? 'badge-accent' :
                                            'badge-info'
                                          }`}>
                                            {typeof comp.placement === 'number' ? 
                                              comp.placement === 1 ? '1st' :
                                              comp.placement === 2 ? '2nd' :
                                              comp.placement === 3 ? '3rd' :
                                              `${comp.placement}th` :
                                              comp.placement
                                            }
                                          </span>
                                        </div>
                                      </div>
                                    ))}
                                  </div>
                                  
                                  {version.competitions.length > (version.competitionsOptions?.maxDisplay ?? 3) && (version.competitionsOptions?.maxDisplay ?? 3) > 0 && (
                                    <div class="text-xs text-base-content/60 text-center mt-2">
                                      And {version.competitions.length - (version.competitionsOptions?.maxDisplay ?? 3)} more competition{version.competitions.length - (version.competitionsOptions?.maxDisplay ?? 3) !== 1 ? 's' : ''}...
                                    </div>
                                  )}
                                </div>
                              );
                            })()}
                          </div>
                        )}
                        
                        {/* Version Action Links */}
                        <div class="flex flex-wrap gap-3">
                          {version.githubUrl && (
                            <a 
                              href={version.githubUrl} 
                              class="btn btn-outline"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              View on GitHub
                            </a>
                          )}
                          {version.liveUrl && (
                            <a 
                              href={version.liveUrl} 
                              class="btn btn-primary"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              Live Demo
                            </a>
                          )}
                        </div>
                      </div>
                    </div>
                  </header>
                )}

                {/* Legacy Compact Version Info (when no header is defined) */}
                {!(version.headerTitle || version.headerDescription || version.cover || (version.gallery && version.gallery.length > 0) || version.metrics || version.competitions) && (
                  <div class="mb-8">
                    {/* Version Header */}
                    <div class="flex items-center gap-3 mb-4">
                      <h3 class="text-2xl font-bold">{version.version}</h3>
                      <div class={`badge ${
                        version.status === 'completed' ? 'badge-success' : 
                        version.status === 'in-progress' ? 'badge-warning' : 
                        'badge-info'
                      }`}>
                        {version.status.replace('-', ' ')}
                      </div>
                    </div>
                    
                    <h4 class="text-xl font-semibold mb-3">{version.title}</h4>
                    <p class="text-base-content/80 mb-6">{version.description}</p>

                    {/* Timeline and Links */}
                    <div class="mb-6">
                      <div class="text-sm text-base-content/60 mb-3">
                        {version.status === 'completed' && version.endDate ? (
                          <div>
                            <div>Started: {formatProjectDate(version.startDate)}</div>
                            <div>Completed: {formatProjectDate(version.endDate)}</div>
                            <div class="font-medium">
                              Duration: {calculateDuration(version.startDate, version.endDate)}
                            </div>
                          </div>
                        ) : version.status === 'in-progress' ? (
                          <div>
                            <div>Started: {formatProjectDate(version.startDate)}</div>
                            <div class="font-medium text-warning">In Progress</div>
                          </div>
                        ) : (
                          <div>
                            <div>Planned: {formatProjectDate(version.startDate)}</div>
                          </div>
                        )}
                      </div>
                      
                      {/* Links */}
                      <div class="flex gap-2">
                        {version.githubUrl && (
                          <a 
                            href={version.githubUrl} 
                            class="btn btn-sm btn-outline"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            GitHub
                          </a>
                        )}
                        {version.liveUrl && (
                          <a 
                            href={version.liveUrl} 
                            class="btn btn-sm btn-primary"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            Demo
                          </a>
                        )}
                      </div>
                    </div>

                    {/* Achievements and Learnings Row */}
                    {(version.achievements?.length || version.learnings?.length) && (
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {version.achievements && version.achievements.length > 0 && (
                          <div>
                            <h5 class="text-sm font-semibold mb-2">Key Achievements</h5>
                            <ul class="list-disc list-inside text-sm space-y-1">
                              {version.achievements.map(achievement => (
                                <li>{achievement}</li>
                              ))}
                            </ul>
                          </div>
                        )}
                        
                        {version.learnings && version.learnings.length > 0 && (
                          <div>
                            <h5 class="text-sm font-semibold mb-2">Key Learnings</h5>
                            <ul class="list-disc list-inside text-sm space-y-1">
                              {version.learnings.map(learning => (
                                <li>{learning}</li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </div>
                    )}

                    {/* Legacy Gallery/Images for Compact Layout */}
                    {((version.gallery && version.gallery.length > 0) || (version.images && version.images.length > 0)) && (
                      <div class="mt-6">
                        {version.gallery && version.gallery.length > 0 ? (
                          <ProjectGallery 
                            images={version.gallery}
                            autoplay={version.galleryOptions?.autoplay !== undefined ? version.galleryOptions.autoplay : version.gallery.length > 1}
                            autoplayInterval={version.galleryOptions?.autoplayInterval || 5000}
                            showThumbnails={version.galleryOptions?.showThumbnails !== undefined ? version.galleryOptions.showThumbnails : version.gallery.length > 2}
                            client:load
                          />
                        ) : version.images && version.images.length > 0 && (
                          <div class="grid grid-cols-1 gap-4">
                            {version.images.map((img, imgIndex) => (
                              <Image 
                                src={img}
                                alt={`${version.title} - Image ${imgIndex + 1}`}
                                width={400}
                                height={300}
                                class="w-full h-auto object-cover rounded-lg shadow"
                              />
                            ))}
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                )}

                {/* Modular Sections */}
                {version.sections && version.sections.length > 0 && (
                  <div class="space-y-8">
                    <ModularSection sections={version.sections} />
                  </div>
                )}

                {/* Legacy Content Support */}
                {version.content && !version.sections && (
                  <div class="prose prose-lg max-w-none" set:html={marked(version.content)} />
                )}
              </div>
            </div>
            );
          })}
        </div>
      </div>
    )}

    <style>
      .version-content {
        transition: opacity 0.4s ease-in-out !important;
      }
    </style>

    <script is:inline>
      window.showVersion = function(selectedIndex) {
        // Get all version content elements
        const allVersions = document.querySelectorAll('.version-content');
        const selectedContent = document.getElementById(`version-${selectedIndex}`);
        const selectedTab = document.getElementById(`version-tab-${selectedIndex}`);
        
        // Skip if already active
        if (selectedContent && selectedContent.style.opacity === '1' && !selectedContent.classList.contains('hidden')) {
          return;
        }
        
        // Disable transitions temporarily to set initial states
        allVersions.forEach(content => {
          content.style.transition = 'none';
        });
        
        // Set all content to be block but invisible, then re-enable transitions
        allVersions.forEach(content => {
          content.classList.remove('hidden');
          content.classList.add('block');
          content.style.opacity = content === selectedContent ? '0' : '0';
        });
        
        // Force reflow and re-enable transitions
        selectedContent?.offsetHeight;
        
        setTimeout(() => {
          allVersions.forEach(content => {
            content.style.transition = 'opacity 0.4s ease-in-out';
          });
          
          // Start the fade sequence
          const currentlyVisible = Array.from(allVersions).find(content => 
            content.style.opacity === '1' || (content.style.opacity === '' && !content.classList.contains('hidden'))
          );
          
          if (currentlyVisible && currentlyVisible !== selectedContent) {
            // Fade out current content
            currentlyVisible.style.opacity = '0';
            
            // After fade out, hide it and show new content
            setTimeout(() => {
              currentlyVisible.classList.add('hidden');
              currentlyVisible.classList.remove('block');
              
              if (selectedContent) {
                selectedContent.classList.remove('hidden');
                selectedContent.classList.add('block');
                selectedContent.style.opacity = '0';
                
                // Fade in new content
                setTimeout(() => {
                  selectedContent.style.opacity = '1';
                }, 50);
              }
            }, 400);
          } else {
            // No current content or same content, just show selected
            if (selectedContent) {
              allVersions.forEach(content => {
                if (content !== selectedContent) {
                  content.classList.add('hidden');
                  content.classList.remove('block');
                  content.style.opacity = '0';
                }
              });
              
              selectedContent.classList.remove('hidden');
              selectedContent.classList.add('block');
              selectedContent.style.opacity = '1';
            }
          }
          
          // Update tab styling
          document.querySelectorAll('[id^="version-tab-"]').forEach(tab => {
            tab.classList.remove('tab-active');
            tab.style.backgroundColor = '';
            tab.style.color = '';
            tab.style.border = '';
            tab.style.fontWeight = '';
          });
          
          if (selectedTab) {
            selectedTab.classList.add('tab-active');
            selectedTab.style.backgroundColor = 'rgba(59, 130, 246, 0.2)';
            selectedTab.style.color = 'rgba(59, 130, 246, 1)';
            selectedTab.style.border = '1px solid rgba(59, 130, 246, 0.4)';
            selectedTab.style.fontWeight = '600';
          }
          
          // Dispatch custom event
          setTimeout(() => {
            if (selectedContent) {
              const event = new CustomEvent('versionTabChanged', { 
                detail: { selectedIndex } 
              });
              selectedContent.dispatchEvent(event);
              window.dispatchEvent(event);
            }
          }, 450);
        }, 50);
      };
      
      // Initialize active styling and transitions
      function initializeVersionTabs() {
        const firstTab = document.querySelector('#version-tab-0');
        const firstContent = document.querySelector('#version-0');
        
        // Initialize first tab styling
        if (firstTab) {
          firstTab.classList.add('tab-active');
          firstTab.style.backgroundColor = 'rgba(59, 130, 246, 0.2)';
          firstTab.style.color = 'rgba(59, 130, 246, 1)';
          firstTab.style.border = '1px solid rgba(59, 130, 246, 0.4)';
          firstTab.style.fontWeight = '600';
        }
        
        // Set up all version content
        document.querySelectorAll('.version-content').forEach((content, _index) => {
          // Only apply transition to version content elements, not globally
          content.style.transition = 'opacity 0.4s ease-in-out';
          content.style.position = 'relative'; // Ensure proper positioning context
          if (content === firstContent) {
            content.style.opacity = '1';
            content.classList.remove('hidden');
            content.classList.add('block');
          } else {
            content.style.opacity = '0';
            content.classList.add('hidden');
            content.classList.remove('block');
          }
        });
      }
      
      // Run initialization
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeVersionTabs);
      } else {
        initializeVersionTabs();
      }
    </script>
    
    <!-- Navigation -->
    <div class="mt-12 pt-8 border-t border-base-300">
      <a href="/projects" class="btn btn-outline">
        ← Back to Projects
      </a>
    </div>

    <!-- Related Content -->
    {relatedContent.length > 0 && (
      <div class="mt-12 pt-8 border-t border-base-300">
        <h2 class="text-2xl font-bold mb-6">Related Content</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedContent.map(item => (
            <article class="card bg-base-100 shadow hover:shadow-lg transition-shadow duration-200 rounded-xl overflow-hidden border border-base-300">
              <a 
                href={`/${item.type === 'project' ? 'projects' : 'posts'}/${item.slug}/`}
                class="block"
              >
                <figure class="aspect-[4/3] rounded-t-xl overflow-hidden">
                  <Image 
                    src={item.data.cover}
                    alt={item.data.coverCaption || item.data.title}
                    width={300}
                    height={225}
                    class="w-full h-full object-cover"
                  />
                </figure>
                <div class="card-body p-4">
                  <div class="flex items-center gap-2 mb-2">
                    <div class={`badge badge-sm ${
                      item.type === 'project' ? 'badge-primary' : 'badge-secondary'
                    }`}>
                      {item.type}
                    </div>
                    <div class="text-xs text-base-content/60">
                      {item.sharedTags.length} shared tag{item.sharedTags.length !== 1 ? 's' : ''}
                    </div>
                  </div>
                  <h3 class="card-title text-base">
                    {item.data.title}
                  </h3>
                </div>
              </a>
              <div class="px-4 pb-4">
                <TagList tags={item.sharedTags} client:load />
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </article>
</Layout>
