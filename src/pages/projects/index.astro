---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { isMainEntry, sortProjectsOngoingFirst } from '../../utils/contentUtils';

const projects = await getCollection('projects');
const publishedProjects = sortProjectsOngoingFirst(
  projects.filter(p => !p.data.draft && isMainEntry(p))
);
---

<Layout 
  pageType="projects-index"
  seo={{
    title: "Projects",
    description: "Explore my robotics and engineering projects, from concept to completion."
  }}
>
  <div>
    <div class="prose prose-lg max-w-none mb-4">
      <h1 class="text-4xl font-bold mb-2">Projects</h1>
      <p class="text-lg text-base-content/70">
        A collection of my robotics, engineering, and maker projects. Each project showcases various aspects of design, problem-solving, and manufacturing.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {publishedProjects.map(project => (
        <ProjectCard project={project} showActions />
      ))}
    </div>

    {publishedProjects.length === 0 && (
      <div class="text-center py-12">
        <p class="text-lg text-base-content/60">No projects yet. Check back soon!</p>
      </div>
    )}
  </div>
</Layout>
