---
import Layout from '../../layouts/Layout.astro';
import { Image } from "astro:assets";
import { getCollection } from 'astro:content';
import { formatProjectDate, getSortableDate } from '../../utils/dateUtils';

const projects = await getCollection('projects');
const publishedProjects = projects
  .filter(project => {
    // Only show main project files (index.mdx), not version files (v1.mdx, v2.mdx, etc.)
    const fileName = project.id.split('/').pop();
    const baseName = fileName?.replace(/\.(mdx?|md)$/, '');
    return !project.data.draft && baseName === 'index';
  })
  .sort((a, b) => {
    // Prioritize ongoing projects (no end date) by most recent start date
    // Then completed projects by most recent end date
    const aHasEndDate = !!a.data.endDate;
    const bHasEndDate = !!b.data.endDate;
    
    // If one has no end date and the other does, prioritize the ongoing one
    if (!aHasEndDate && bHasEndDate) return -1;
    if (aHasEndDate && !bHasEndDate) return 1;
    
    // If both are ongoing (no end date), sort by most recent start date
    if (!aHasEndDate && !bHasEndDate) {
      const bStart = b.data.startDate ?? new Date(0);
      const aStart = a.data.startDate ?? new Date(0);
      return getSortableDate(bStart).getTime() - getSortableDate(aStart).getTime();
    }
    
    // If both have end dates, sort by most recent end date
  const bEnd = b.data.endDate ?? new Date(0);
  const aEnd = a.data.endDate ?? new Date(0);
  return getSortableDate(bEnd).getTime() - getSortableDate(aEnd).getTime();
  });
---

<Layout 
  pageType="projects-index"
  seo={{
    title: "Projects",
    description: "Explore my robotics and engineering projects, from concept to completion."
  }}
>
  <div>
    <div class="prose prose-lg max-w-none mb-8">
      <h1 class="text-4xl font-bold mb-4">Projects</h1>
      <p class="text-lg text-base-content/70">
        A collection of my robotics, engineering, and maker projects. Each project showcases multiple aspects of design, development, and problem-solving.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {publishedProjects.map(project => (
        <article 
          class="card bg-base-100 shadow-lg hover:shadow-xl transition-shadow duration-300 h-full rounded-xl overflow-hidden border border-base-300 cursor-pointer"
          onclick={`window.location.href='/projects/${project.slug}/'`}
        >
          <figure class="relative aspect-[4/3] rounded-t-xl overflow-hidden">
            {project.data.cover ? (
              <Image 
                src={project.data.cover}
                alt={(project.data.coverCaption || project.data.title || project.slug.replace(/-/g, ' '))}
                width={560}
                height={420}
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="w-full h-full bg-base-200 flex items-center justify-center">
                <span class="text-base-content/50 text-lg">No Image</span>
              </div>
            )}
            <div class="absolute top-2 right-2">
              <div class={`badge status-badge ${
                project.data.status === 'completed' ? 'badge-success' : 
                project.data.status === 'in-progress' ? 'badge-warning' : 
                'badge-info'
              }`}>
                {project.data.status === 'completed' ? 'Completed' : 
                 project.data.status === 'in-progress' ? 'In Progress' : 
                 'Planned'}
              </div>
            </div>
          </figure>
          
          <div class="card-body p-6">
            <h2 class="card-title text-xl mb-2">
              {project.data.title}
            </h2>
            
            <p class="text-sm text-base-content/70 mb-4">
              {project.data.description}
            </p>
            
            <!-- Tags -->
            {project.data.tags && project.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {project.data.tags.slice(0, 4).map(tag => (
                  <a href={`/tags/${tag}/`} class="badge badge-outline badge-sm tag-hover-light-blue transition-colors" onclick="event.stopPropagation()">
                    {tag}
                  </a>
                ))}
                {project.data.tags.length > 4 && (
                  <span class="badge badge-ghost badge-sm">+{project.data.tags.length - 4} more</span>
                )}
              </div>
            )}
            
            <div class="card-actions justify-between items-center">
              <div class="text-sm text-base-content/70">
                {project.data.status === 'completed' && project.data.endDate ? (
                  <time>
                    {formatProjectDate(project.data.endDate ?? new Date())}
                  </time>
                ) : project.data.status === 'in-progress' ? (
                  <time>
                    Started {formatProjectDate(project.data.startDate ?? new Date())}
                  </time>
                ) : (
                  <time>
                    Planned {formatProjectDate(project.data.startDate ?? new Date())}
                  </time>
                )}
              </div>
              
              <div class="flex gap-2">
                {project.data.githubUrl && (
                  <a 
                    href={project.data.githubUrl} 
                    class="btn btn-sm btn-outline"
                    target="_blank"
                    rel="noopener noreferrer"
                    onclick="event.stopPropagation()"
                  >
                    GitHub
                  </a>
                )}
                {project.data.liveUrl && (
                  <a 
                    href={project.data.liveUrl} 
                    class="btn btn-sm btn-outline"
                    target="_blank"
                    rel="noopener noreferrer"
                    onclick="event.stopPropagation()"
                  >
                    Live Demo
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    {publishedProjects.length === 0 && (
      <div class="text-center py-12">
        <p class="text-lg text-base-content/60">No projects yet. Check back soon!</p>
      </div>
    )}
  </div>
</Layout>
