---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getAllTags, getContentByTag } from '../../utils/tagUtils';
import { formatProjectDate, getSortableDate } from '../../utils/dateUtils';

export async function getStaticPaths() {
  const tags = await getAllTags();
  
  return Promise.all(
    tags.map(async (tag) => {
      const content = await getContentByTag(tag.name);
      return {
        params: { tag: tag.name },
        props: { 
          tag: tag.name, 
          projects: content.projects,
          posts: content.posts,
          totalCount: content.totalCount
        },
      };
    })
  );
}

const { tag, projects, posts, totalCount } = Astro.props;

// Sort projects by date
// Ensure we only sort main project files (index.mdx), though getContentByTag should already filter
const sortedProjects = projects
  .filter(p => p.id.split('/').pop()?.replace(/\.(mdx?|md)$/, '') === 'index')
  .sort((a, b) => {
  // Prioritize ongoing projects (no end date) by most recent start date
  // Then completed projects by most recent end date
  const aHasEndDate = !!a.data.endDate;
  const bHasEndDate = !!b.data.endDate;
  
  // If one has no end date and the other does, prioritize the ongoing one
  if (!aHasEndDate && bHasEndDate) return -1;
  if (aHasEndDate && !bHasEndDate) return 1;
  
  // If both are ongoing (no end date), sort by most recent start date
  if (!aHasEndDate && !bHasEndDate) {
    const bStart = b.data.startDate ?? new Date(0);
    const aStart = a.data.startDate ?? new Date(0);
    return getSortableDate(bStart).getTime() - getSortableDate(aStart).getTime();
  }
  
  // If both have end dates, sort by most recent end date
  const bEnd = b.data.endDate ?? new Date(0);
  const aEnd = a.data.endDate ?? new Date(0);
  return getSortableDate(bEnd).getTime() - getSortableDate(aEnd).getTime();
});

// Sort posts by date
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout 
  pageType="default"
  seo={{
    title: `${tag}`,
    description: `All projects and blog posts tagged with ${tag}. ${totalCount} ${totalCount === 1 ? 'item' : 'items'} found.`
  }}
>
  <div>
    <!-- Header -->
    <div class="prose prose-lg max-w-none mb-8">
      <div class="flex items-center gap-3 mb-4">
        <a href="/tags" class="btn btn-sm btn-outline">← All Tags</a>
        <div class="badge badge-primary badge-lg">{tag}</div>
      </div>
      <h1 class="text-4xl font-bold mb-2">Tagged: {tag}</h1>
      <p class="text-lg text-base-content/70">
        {totalCount} {totalCount === 1 ? 'item' : 'items'} found
        {projects.length > 0 && posts.length > 0 && 
          ` (${projects.length} ${projects.length === 1 ? 'project' : 'projects'}, ${posts.length} ${posts.length === 1 ? 'post' : 'posts'})`
        }
      </p>
    </div>

    <div class="space-y-12">
      <!-- Projects Section -->
      {projects.length > 0 && (
        <section>
          <h2 class="text-2xl font-semibold mb-6 flex items-center gap-2">
            Projects
            <div class="badge badge-secondary">{projects.length}</div>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            {sortedProjects.map(project => (
              <article 
                class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow duration-300 rounded-xl overflow-hidden border border-base-300 h-full relative"
              >
                <a 
                  href={`/projects/${project.slug}/`}
                  class="absolute inset-0 z-10"
                  aria-label={project.data.title}
                ></a>
                <figure class="relative aspect-[4/3] rounded-t-xl overflow-hidden">
                  {project.data.cover ? (
                    <Image 
                      src={project.data.cover}
                      alt={(project.data.coverCaption || project.data.title || project.slug.replace(/-/g, ' '))}
                      width={400}
                      height={300}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full bg-base-200 flex items-center justify-center">
                      <span class="text-base-content/50 text-lg">No Image</span>
                    </div>
                  )}
                  <div class="absolute top-2 right-2">
                    <div class={`badge status-badge ${
                      project.data.status === 'completed' ? 'badge-success' : 
                      project.data.status === 'in-progress' ? 'badge-warning' : 
                      'badge-info'
                    }`}>
                      {project.data.status === 'completed' ? 'Completed' : 
                       project.data.status === 'in-progress' ? 'In Progress' : 
                       'Planned'}
                    </div>
                  </div>
                </figure>
                
                <div class="card-body">
                  <h3 class="card-title">
                    {project.data.title}
                  </h3>
                  
                  <p class="text-sm text-base-content/70 mb-3">
                    {project.data.description}
                  </p>
                  
                  <div class="flex flex-wrap gap-1 mb-3">
                    {project.data.tags.map(projectTag => (
                      <a 
                        href={`/tags/${projectTag}/`} 
                        class={`badge badge-sm tag-hover-light-blue transition-colors relative z-20 ${
                          projectTag === tag ? 'badge-primary' : 'badge-outline'
                        }`}
                      >
                        {projectTag}
                      </a>
                    ))}
                  </div>
                  
                  <div class="card-actions justify-between items-center">
                    <div class="text-xs text-base-content/60">
                      {project.data.status === 'completed' && project.data.endDate ? (
                        <div>Completed: {formatProjectDate(project.data.endDate ?? new Date())}</div>
                      ) : project.data.status === 'in-progress' ? (
                        <div>Started: {formatProjectDate(project.data.startDate ?? new Date())}</div>
                      ) : (
                        <div>Planned: {formatProjectDate(project.data.startDate ?? new Date())}</div>
                      )}
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- Posts Section -->
      {posts.length > 0 && (
        <section>
          <h2 class="text-2xl font-semibold mb-6 flex items-center gap-2">
            Blog Posts
            <div class="badge badge-secondary">{posts.length}</div>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            {sortedPosts.map(post => (
              <article 
                class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow duration-300 rounded-xl overflow-hidden border border-base-300 h-full relative"
              >
                <a 
                  href={`/posts/${post.slug}/`}
                  class="absolute inset-0 z-10"
                  aria-label={post.data.title}
                ></a>
                <figure class="aspect-[4/3] rounded-t-xl overflow-hidden">
                  <Image 
                    src={post.data.cover}
                    alt={post.data.coverCaption || post.data.title}
                    width={400}
                    height={300}
                    class="w-full h-full object-cover"
                  />
                </figure>
                
                <div class="card-body">
                  <h3 class="card-title">
                    {post.data.title}
                  </h3>
                  
                  <p class="text-sm text-base-content/70 mb-3">
                    {post.data.description}
                  </p>
                  
                  <div class="flex flex-wrap gap-1 mb-3">
                    {post.data.tags.map(postTag => (
                      <a 
                        href={`/tags/${postTag}/`} 
                        class={`badge badge-sm tag-hover-light-blue transition-colors relative z-20 ${
                          postTag === tag ? 'badge-primary' : 'badge-outline'
                        }`}
                      >
                        {postTag}
                      </a>
                    ))}
                  </div>
                  
                  <div class="card-actions justify-between items-center">
                    <div class="text-xs text-base-content/60">
                      {new Date(post.data.date).toLocaleDateString()}
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- No content message -->
      {totalCount === 0 && (
        <div class="text-center py-12">
          <p class="text-lg text-base-content/60">No content found for tag {tag}</p>
          <a href="/tags" class="btn btn-primary mt-4">Browse All Tags</a>
        </div>
      )}
    </div>
  </div>
</Layout>
