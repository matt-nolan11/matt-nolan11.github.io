---
import Layout from '../../layouts/Layout.astro';
import { Image } from "astro:assets";
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const publishedPosts = posts
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout 
  pageType="posts-index"
  seo={{
    title: "Posts",
    description: "A collection of blog posts about stars and astronomy."
  }}
>
  <div>
    <div class="prose prose-lg max-w-none mb-4">
      <h1 class="text-4xl font-bold mb-2">Posts</h1>
      <p class="text-lg text-base-content/70">
        Insights and tutorials in robotics and engineering, as well as combat robotics event recaps. Dive into the technical details and creative processes behind innovative projects.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {publishedPosts.map(post => (
        <article 
          class="card bg-base-100 shadow-lg hover:shadow-xl transition-shadow duration-300 ease-in-out rounded-xl overflow-hidden border border-base-300 h-full relative"
        >
          <a 
            href={`/posts/${post.slug}/`}
            class="absolute inset-0 z-10"
            aria-label={post.data.title}
          ></a>
          <figure class="relative aspect-[4/3] rounded-t-xl overflow-hidden">
            <Image 
              src={post.data.cover}
              alt={post.data.coverCaption || post.data.title}
              width={560}
              height={420}
              class="w-full h-full object-cover"
            />
          </figure>
          
          <div class="card-body">
            <h2 class="card-title">
              {post.data.title}
            </h2>
            
            <p class="text-sm text-base-content/70 mb-2">
              {post.data.description}
            </p>
            
            <!-- Tags -->
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {post.data.tags.slice(0, 3).map(tag => (
                  <a href={`/tags/${tag}/`} class="badge badge-outline badge-sm tag-hover-light-blue transition-colors relative z-20">
                    {tag}
                  </a>
                ))}
                {post.data.tags.length > 3 && (
                  <span class="badge badge-ghost badge-sm">+{post.data.tags.length - 3} more</span>
                )}
              </div>
            )}
            
            <div class="flex justify-between items-center">
              <span class="text-sm text-base-content/60">
                {new Date(post.data.date).toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>

    {publishedPosts.length === 0 && (
      <div class="text-center py-12">
        <p class="text-lg text-base-content/60">No posts yet. Check back soon!</p>
      </div>
    )}
  </div>
</Layout>