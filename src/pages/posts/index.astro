---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const publishedPosts = posts
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout 
  pageType="posts-index"
  seo={{
    title: "Posts",
    description: "Insights and tutorials in robotics and engineering, plus combat robotics event recaps."
  }}
>
  <div>
    <div class="prose prose-lg max-w-none mb-4">
      <h1 class="text-4xl font-bold mb-2">Posts</h1>
      <p class="text-lg text-base-content/70">
        Insights and tutorials in robotics and engineering, as well as combat robotics event recaps. Dive into the technical details and creative processes behind innovative projects.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {publishedPosts.map(post => (
        <PostCard post={post} />
      ))}
    </div>

    {publishedPosts.length === 0 && (
      <div class="text-center py-12">
        <p class="text-lg text-base-content/60">No posts yet. Check back soon!</p>
      </div>
    )}
  </div>
</Layout>