---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import RelatedContent from '../../components/RelatedContent.astro';
import { getRelatedContent } from "../../utils/tagUtils.ts";
import { getEntrySlug } from "../../utils/contentUtils";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: getEntrySlug(post) },
    props: { entryId: post.id },
  }));
}

const { entryId } = Astro.props;
const post = await getEntry("posts", entryId);
if (!post) throw new Error(`Post entry "${entryId}" not found`);

const { Content } = await render(post);
const relatedContent = await getRelatedContent(post.data.tags, getEntrySlug(post), 3);
---

<Layout 
  pageType="post" 
  seo={{ title: post.data.title, description: post.data.description }}
  customMaxWidth={post.data.maxWidth}
>
  <article class="prose prose-lg max-w-none dark:prose-invert">
    <h1>{post.data.title}</h1>
    <p class="text-sm text-base-content/70 font-bold mb-4">
      {post.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })}
      {post.data.updated && (
        <span class="ml-2 font-normal italic">
          (Updated {post.data.updated.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })})
        </span>
      )}
    </p>
    
    <!-- Tags -->
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-6">
        {post.data.tags.map((tag) => (
          <a href={`/tags/${tag}`} class="badge badge-outline tag-hover-light-blue transition-colors">
            {tag}
          </a>
        ))}
      </div>
    )}
    
    <Content />
  </article>

  <RelatedContent items={relatedContent} />

  <!-- Navigation -->
  <div class="mt-12 pt-8 border-t border-base-300">
    <a href="/posts" class="btn btn-outline">
      ← Back to Posts
    </a>
  </div>
</Layout>
