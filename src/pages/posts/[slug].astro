---
import { getCollection, getEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getRelatedContent } from "../../utils/tagUtils.ts";
import TagList from '../../components/TagList.tsx';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await getEntry("posts", slug);
if (!post) throw new Error(`Post "${slug}" not found`);

const { Content } = await post.render();
const relatedContent = await getRelatedContent(post.data.tags, post.slug, 3);
---

<Layout seo={{ title: post.data.title, description: post.data.description }}>
  <article class="max-w-8xl mx-auto">
    <div class="prose max-w-2xl mx-auto">
      <h1>{post.data.title}</h1>
      <p class="text-sm text-base-content/70 font-bold mb-4">
        {post.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      
      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}`} class="badge badge-outline tag-hover-light-blue transition-colors">
              {tag}
            </a>
          ))}
        </div>
      )}
      
      <Content />
    </div>
  </article>

  <!-- Related Content -->
  {relatedContent.length > 0 && (
  <section class="max-w-8xl mx-auto mt-12 pt-8 border-t border-base-300">
      <h2 class="text-2xl font-bold mb-6">Related Content</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {relatedContent.map(item => (
          <article class="card bg-base-100 shadow hover:shadow-lg transition-shadow duration-200 rounded-xl overflow-hidden">
            <a 
              href={`/${item.type === 'project' ? 'projects' : 'posts'}/${item.slug}/`}
              class="block"
            >
              {item.data.cover && (
                <figure class="aspect-[4/3] rounded-t-xl overflow-hidden">
                  <Image 
                    src={item.data.cover}
                    alt={item.data.coverCaption || item.data.title || item.slug.replace(/-/g, ' ')}
                    width={300}
                    height={200}
                    class="w-full h-full object-cover"
                  />
                </figure>
              )}
              <div class="card-body p-4">
                <div class="flex items-center gap-2 mb-2">
                  <div class={`badge badge-sm ${
                    item.type === 'project' ? 'badge-primary' : 'badge-secondary'
                  }`}>
                    {item.type}
                  </div>
                  <div class="text-xs text-base-content/60">
                    {item.sharedTags.length} shared tag{item.sharedTags.length !== 1 ? 's' : ''}
                  </div>
                </div>
                <h3 class="card-title text-base">
                  {item.data.title}
                </h3>
              </div>
            </a>
            <div class="px-4 pb-4">
              <TagList tags={item.sharedTags} client:load />
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Navigation -->
  <div class="max-w-8xl mx-auto mt-12 pt-8 border-t border-base-300">
    <a href="/posts" class="btn btn-outline">
      ← Back to Posts
    </a>
  </div>
</Layout>
