---
import Landing from '../components/Landing.astro';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getFeaturedProjects } from '../utils/homepageUtils';

const projects = await getCollection('projects');
// getFeaturedProjects already filters to index.mdx, but keep inputs broad
const displayProjects = getFeaturedProjects(projects, 6);

const posts = await getCollection('posts');
const recentPosts = posts
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<Layout pageType="landing">
	<Landing />

    <!-- Featured Projects Section -->
    <section class="mt-12">
		<h2 class="text-2xl font-semibold mb-6">Featured Projects</h2>
		<p class="mb-4 text-base-content/70">Explore a selection of my robotics and engineering projects. View the full list on the Projects page.</p>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
		  {displayProjects.map(project => (
			<ProjectCard project={project} />
		  ))}
		</div>
		<div class="flex justify-center mt-8">
		  <a href="/projects" class="btn btn-primary">View All Projects</a>
		</div>
	  </section>

	<!-- Recent Posts Section -->
	<section class="mt-12">
		<h2 class="text-2xl font-semibold mb-6">Recent Posts</h2>
		<p class="mb-4 text-base-content/70">The latest from the blog — event recaps, tutorials, and engineering deep dives.</p>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
		  {recentPosts.map(post => (
			<PostCard post={post} />
		  ))}
		</div>
		<div class="flex justify-center mt-8">
		  <a href="/posts" class="btn btn-primary">View All Posts</a>
		</div>
	</section>
</Layout>
