---
interface Props {
  id: string; // YouTube video ID
  title?: string; // Accessible title for iframe
  aspect?: string; // e.g., "16:9", "4:3", defaults to 16:9
  start?: number; // seconds
  autoplay?: boolean;
  muted?: boolean;
  controls?: boolean;
  caption?: string;
  className?: string;
  poster?: string; // override the thumbnail (e.g. a local import's .src)
  eager?: boolean; // skip the facade and embed the player immediately
}

const {
  id,
  title = 'YouTube video',
  aspect = '16:9',
  start,
  autoplay = false,
  muted = false,
  controls = true,
  caption,
  className = '',
  poster,
  eager = false
} = Astro.props as Props;

// Parse aspect ratio into CSS aspect-ratio value (w/h)
let aspectStyle = '16 / 9';
try {
  if (typeof aspect === 'string' && aspect.includes(':')) {
    const [w, h] = aspect.split(':').map((n) => parseFloat(n));
    if (!isNaN(w) && !isNaN(h) && w > 0 && h > 0) {
      aspectStyle = `${w} / ${h}`;
    }
  }
} catch {}

const params = new URLSearchParams({
  rel: '0',
  modestbranding: '1',
  playsinline: '1',
  // Required so the player accepts postMessage commands — without it there is
  // no way to pause a video whose version tab has been switched away from.
  enablejsapi: '1',
  // booleans as 1/0
  autoplay: autoplay ? '1' : '0',
  mute: muted ? '1' : '0',
  controls: controls ? '1' : '0',
});

if (start && start > 0) params.set('start', String(start));

// Deliberately no way to request a starting quality. Tried and measured: the
// undocumented `vq` parameter (e.g. vq=hd1080) is ignored by the embed, and the
// official setPlaybackQuality() API is deprecated and documented as ignorable.
// Quality is chosen by adaptive bitrate, which ramps up from a low tier while
// it measures bandwidth — hence a video opening at 360p and climbing. The
// viewer's own quality menu is the only thing that overrides it.

const src = `https://www.youtube-nocookie.com/embed/${id}?${params.toString()}`;

// The facade loads the player on click, so autoplay is always appropriate
// there — the click is the user gesture browsers require.
const clickParams = new URLSearchParams(params);
clickParams.set('autoplay', '1');
const clickSrc = `https://www.youtube-nocookie.com/embed/${id}?${clickParams.toString()}`;

// hqdefault always exists for every video; maxresdefault 404s on older ones.
// It is 4:3 with letterboxing, which object-fit: cover crops back off.
const posterSrc = poster || `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;

// Only overlay a title the author actually supplied — the "YouTube video"
// default is placeholder text for the iframe's accessible name, not a caption.
// aria-hidden on the overlay, since the button's aria-label already says it.
const hasTitle = Boolean(Astro.props.title);
---
<style>
  /* Eliminate stray whitespace around iframes similar to gallery spacing fix */
  .yt-embed { margin: 0; padding: 0; line-height: 0; font-size: 0; }
  .yt-embed > div { margin: 0; padding: 0; }
  .yt-embed iframe { display: block; }
  .yt-embed figcaption { line-height: initial; font-size: 0.875rem; }

  /* The player is injected on click and carries no scope attribute, so it
     needs a :global() selector to pick up these styles. */
  .yt-frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .yt-facade {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: var(--color-base-200);
    display: block;
    overflow: hidden;
  }

  .yt-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Mirrors YouTube's own preview chrome: title over a top scrim. */
  .yt-title {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 0.7rem 0.9rem 1.6rem;
    text-align: left;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
    color: #fff;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.6);
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.72), transparent);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .yt-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 68px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgb(33 33 33 / 0.75);
    transition: background 0.15s ease-in-out;
  }

  .yt-facade:hover .yt-play,
  .yt-facade:focus-visible .yt-play {
    background: #f00;
  }

  .yt-play svg {
    width: 26px;
    height: 26px;
    fill: #fff;
    /* Nudge the triangle to look optically centred in the rounded plate. */
    margin-left: 3px;
  }
</style>

<figure class={`yt-embed w-full ${className}`}>
  <div
    style={`aspect-ratio: ${aspectStyle};`}
    class="yt-frame w-full rounded-lg overflow-hidden bg-base-200"
  >
    {eager ? (
      <iframe
        src={src}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        class="w-full h-full border-0 block"
        referrerpolicy="strict-origin-when-cross-origin"
      />
    ) : (
      <button
        type="button"
        class="yt-facade"
        data-yt-src={clickSrc}
        data-yt-title={title}
        aria-label={`Play video: ${title}`}
      >
        <img
          src={posterSrc}
          alt=""
          loading="lazy"
          decoding="async"
          class="yt-poster"
          width="480"
          height="360"
        />
        {hasTitle && <span class="yt-title" aria-hidden="true">{title}</span>}
        <span class="yt-play" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
        </span>
      </button>
    )}
  </div>
  {caption && (
    <figcaption class="mt-2 text-center text-base-content/60 text-sm">{caption}</figcaption>
  )}
</figure>

<script>
  /**
   * Click-to-load YouTube players.
   *
   * A real embed pulls roughly a megabyte of player JS and keeps working
   * through requestIdleCallback long after the page is interactive, competing
   * for the main thread during load. The facade is a thumbnail plus a play
   * button; the actual iframe is only created once someone asks for it, and
   * autoplays because the click is the required user gesture.
   *
   * Delegated from the document so one listener covers every embed on the
   * page, including any inside version tabs that were hidden at load.
   */
  function injectPlayer(facade: HTMLElement) {
    const src = facade.dataset.ytSrc;
    if (!src) return;

    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = facade.dataset.ytTitle || 'YouTube video';
    iframe.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    facade.replaceWith(iframe);
  }

  document.addEventListener('click', (event) => {
    const facade = (event.target as Element | null)?.closest<HTMLElement>(
      '.yt-facade'
    );
    if (facade) injectPlayer(facade);
  });

  // Warm up the connection on intent, so the click itself feels immediate.
  let warmed = false;
  function warmConnections() {
    if (warmed) return;
    warmed = true;
    for (const href of [
      'https://www.youtube-nocookie.com',
      'https://www.google.com',
      'https://googlevideo.com',
    ]) {
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = href;
      document.head.appendChild(link);
    }
  }

  for (const type of ['pointerover', 'focusin'] as const) {
    document.addEventListener(
      type,
      (event) => {
        if ((event.target as Element | null)?.closest('.yt-facade')) {
          warmConnections();
        }
      },
      { passive: true }
    );
  }

  /**
   * Pause a player whose version tab has been switched away from.
   *
   * Hidden tabs are display:none, so an embed keeps playing — audible with no
   * visible video. Watching for the element collapsing to zero size catches
   * exactly that, and deliberately not the case where the video is merely
   * scrolled out of view: an IntersectionObserver would pause that too, which
   * would interrupt anyone listening while they read further down the page.
   *
   * Never auto-resumes. Returning to the tab leaves the video paused where it
   * was, for the reader to restart.
   */
  function pausePlayersIn(frame: Element) {
    for (const iframe of frame.querySelectorAll('iframe')) {
      iframe.contentWindow?.postMessage(
        JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] }),
        'https://www.youtube-nocookie.com'
      );
    }
  }

  function watchForHiding(frame: HTMLElement) {
    if (frame.dataset.ytWatched) return;
    frame.dataset.ytWatched = 'true';

    new ResizeObserver(() => {
      const { width, height } = frame.getBoundingClientRect();
      if (width === 0 && height === 0) pausePlayersIn(frame);
    }).observe(frame);
  }

  function watchAllFrames() {
    document
      .querySelectorAll<HTMLElement>('.yt-frame')
      .forEach(watchForHiding);
  }

  watchAllFrames();
  document.addEventListener('astro:page-load', watchAllFrames);
</script>
