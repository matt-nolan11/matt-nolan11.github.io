---
import { formatProjectDate, calculateDuration } from '../utils/dateUtils';
import { placementBadgeClass, formatPlacement } from '../utils/placement';
import { markdown } from '../utils/markdown';
import { resolveLinks, type ProjectLink } from '../utils/linkButtons';
import LinkButtonIcon from './LinkButtonIcon.astro';

interface CompetitionEntry {
  name: string;
  date: string;
  placement: number | string;
  record?: string;
  url?: string;
  hoverText?: string;
}

interface MetricField {
  label: string;
  value: string | number;
  unit?: string;
  highlight?: boolean;
  color?: 'success' | 'warning' | 'error' | 'info';
}

interface Metrics {
  sectionTitle?: string;
  customFields?: MetricField[];
}

interface CompetitionsOptions {
  sectionTitle?: string;
  maxDisplay?: number;
}

interface Props {
  title: string;
  description?: string;
  startDate: string;
  endDate?: string;
  status: 'completed' | 'in-progress' | 'active' | 'paused' | 'planned';
  headerTitleSize?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl';
  metrics?: Metrics;
  competitions?: CompetitionEntry[];
  competitionsOptions?: CompetitionsOptions;
  tags?: string[]; // Legacy: tags in block config (deprecated in favor of frontmatterTags)
  frontmatterTags?: string[]; // Tags from page frontmatter (source of truth)
  showTags?: boolean; // Whether to display tags section (default: true if tags are available)
  /** Action buttons — repos, live demos, BOMs, videos, anything. */
  links?: ProjectLink[];
}

const {
  title,
  description,
  startDate,
  endDate,
  status,
  headerTitleSize = '2xl',
  metrics,
  competitions = [],
  competitionsOptions,
  tags = [],
  frontmatterTags,
  showTags,
  links
} = Astro.props;

// One list drives both the buttons and every "is there anything below me?"
// margin check further down, so the spacing cannot disagree with what renders.
const actionLinks = resolveLinks(links);
const hasActions = actionLinks.length > 0;

// Use frontmatter tags (source of truth) if available, otherwise fall back to block tags
const tagsToDisplay = frontmatterTags ?? tags;

// Determine if tags should be shown: must be explicitly set to true AND tags are available
const shouldShowTags = showTags === true && (frontmatterTags?.length || tags?.length);

const titleSizeClass = 
  headerTitleSize === 'sm' ? 'text-lg' :
  headerTitleSize === 'md' ? 'text-xl' :
  headerTitleSize === 'lg' ? 'text-2xl' :
  headerTitleSize === 'xl' ? 'text-3xl' :
  headerTitleSize === '2xl' ? 'text-4xl' :
  headerTitleSize === '3xl' ? 'text-5xl' :
  headerTitleSize === '4xl' ? 'text-6xl' :
  'text-4xl';

// Stat tile values go through the shared inline markdown parser, so a value can
// carry a link (or emphasis, or code) — `[ACS72981](https://…)` in a customField
// renders as a real anchor. parseInline rather than parse: the block parser
// would wrap every value in a <p> and break the tile's layout. Value and unit
// are joined first so the unit is not orphaned outside the parsed output.
const metricFields = (metrics?.customFields ?? []).map((field) => ({
  ...field,
  valueHtml: markdown.parseInline(
    `${field.value}${field.unit ? ` ${field.unit}` : ''}`,
  ) as string,
}));

// The widest tier normally goes to 3 columns, but a count like 8 leaves a
// dangling 3+3+2 with an empty cell. Picking whichever of 2 or 3 columns
// divides the tile count more evenly avoids that gap; ties favour 3 (more
// compact) to match the common divisible-by-3 case. Deliberately capped at
// 3 — a 4th tier would need a container width past the 768px cap on
// .summary-content, which the ModularSection height balancer below can
// never actually resolve to (see max-w-3xl on .summary-content).
const wideColumns = (() => {
  const n = metricFields.length;
  const emptyCells = (cols: number) => (cols - (n % cols)) % cols;
  return emptyCells(3) <= emptyCells(2) ? 3 : 2;
})();

// Calculate competitions to show
const maxDisplay = competitionsOptions?.maxDisplay ?? 3;
const competitionsToShow = maxDisplay === 0 ? competitions : competitions?.slice(0, maxDisplay);
const hasRecords = competitions.some(comp => comp.record);

// Shared with VideoPlaylists so a given placement always renders the same
// colour and ordinal wherever it appears.
---

<style>
  /* Let the parent container handle layout - just reset margins */
  .summary-content > :first-child {
    margin-top: 0 !important;
  }
  
  /* Ensure proper text color inheritance for DaisyUI themes */
  .summary-content {
    color: var(--fallback-bc, oklch(var(--bc)));
  }
</style>

{/*
  @container makes everything below respond to this column's own width rather
  than the viewport's. That is what lets the summary compress: in a narrow
  column the metrics stack and the tournament table drops to its compact
  layout, so the summary gets genuinely taller instead of just cramped. The
  ModularSection balancer needs that to be true — while these were viewport
  breakpoints, a wide screen forced 4-across metrics and the full table no
  matter how narrow the column was, so the balancer could never justify giving
  the visual column more room.
*/}
<div class="summary-content @container max-w-3xl">
{/* No per-block width caps anywhere below — the single max-w-3xl on
    .summary-content governs every block, so they all share one edge. Piecemeal
    caps (24ch here, 60ch there, 3xl elsewhere) left the heading and blurb
    visibly narrower than the tiles and tournaments beneath them. */}
<h1 class={`font-bold mb-4 text-base-content ${titleSizeClass}`}>
  {title}
</h1>
<p class="text-lg text-base-content/70 mb-6">{description}</p>
  
  <!-- Project Timeline -->
  <div class="mb-4">
    <div class="text-sm text-base-content/60">
      {status === 'completed' && endDate ? (
        <div class="flex items-center gap-4">
          <div class="tooltip tooltip-bottom tooltip-bottom-start" data-tip="This project is finished, and no new development is currently planned"><span class="badge status-badge badge-success">Completed</span></div>
          <span>{formatProjectDate(startDate)} → {formatProjectDate(endDate)}</span>
          <span class="font-medium">({calculateDuration(startDate, endDate)})</span>
        </div>
      ) : status === 'in-progress' ? (
        <div class="flex items-center gap-4">
          <div class="tooltip tooltip-bottom tooltip-bottom-start" data-tip="This project is under active development"><span class="badge status-badge badge-warning">In Progress</span></div>
          <span>Started {formatProjectDate(startDate)}</span>
        </div>
      ) : status === 'active' ? (
        <div class="flex items-center gap-4">
          <div class="tooltip tooltip-bottom tooltip-bottom-start" data-tip="This project is being maintained, but no new development is currently planned"><span class="badge status-badge badge-accent">Active</span></div>
          <span>Started {formatProjectDate(startDate)}</span>
        </div>
      ) : status === 'paused' ? (
        <div class="flex items-center gap-4">
          <div class="tooltip tooltip-bottom tooltip-bottom-start" data-tip="Development on this project is paused, and may resume in the future"><span class="badge status-badge badge-neutral">Paused</span></div>
          <span>
            {endDate
              ? <>{formatProjectDate(startDate)} → {formatProjectDate(endDate)}</>
              : <>Started {formatProjectDate(startDate)}</>}
          </span>
        </div>
      ) : (
        <div class="flex items-center gap-4">
          <div class="tooltip tooltip-bottom tooltip-bottom-start" data-tip="This project is in the planning stage, and has not started active development yet"><span class="badge status-badge badge-info">Planned</span></div>
          <span>Planned for {formatProjectDate(startDate)}</span>
        </div>
      )}
    </div>
  </div>
  
  <!-- Project Metrics -->
  {metrics?.customFields && metrics.customFields.length > 0 && (
    <div class={(competitions?.length || shouldShowTags || hasActions) ? "mb-6" : "mb-0"}>
      <h3 class="text-sm font-semibold mb-2 text-base-content">
        {metrics.sectionTitle || "Project Stats"}
      </h3>
      {/* Stat tiles: small-caps label over a large value, in a subtle tile.
          The column count must keep increasing with width — the balancer solves
          for the width where the two columns' heights meet, and it can only do
          that if height actually responds to width. */}
      <div class={`grid grid-cols-1 @xs:grid-cols-2 @2xl:grid-cols-${wideColumns} gap-2`}>
        {metricFields.map((field) => (
          <div class="stat-tile">
            <div class="stat-tile-label">{field.label}</div>
            <div
              class={`stat-tile-value ${
                field.highlight && field.color ? `text-${field.color}` : ''
              }`}
              set:html={field.valueHtml}
            />
          </div>
        ))}
      </div>
    </div>
  )}
  
  <!-- Competition History -->
  {competitions && competitions.length > 0 && (
    <div class={(shouldShowTags || hasActions) ? "mb-6" : "mb-0"}>
      {/* One layout that reflows rather than two swapped ones. Narrow: name
          stacked over date, two lines per row. Wide: they sit side by side,
          one line per row — half the height. That swing is what gives the
          balancer a height/width curve to solve against. The canyon the
          original table opened up between name and badges is prevented by the
          shared cap on .summary-content rather than a cap here. */}
      <div class="space-y-2">
        <div>
          <div class="flex items-center justify-between text-xs pb-1 border-b border-base-content/70">
            <span class="text-sm text-base-content/70">{competitionsOptions?.sectionTitle || "Competition History"}</span>
            <div class="flex items-center gap-4 text-sm text-base-content/70">
              {hasRecords && <span class="w-12 text-center">Record</span>}
              <span class="w-16.5 text-center whitespace-nowrap">Placement</span>
            </div>
          </div>
          
          {/* Mobile Entries */}
          {competitionsToShow.map(comp => (
            <div class="pt-1 pb-1 border-b border-base-content/25">
              <div class="flex items-center justify-between">
                <div class="flex flex-col @xl:flex-row @xl:items-center @xl:justify-between @xl:gap-4 flex-1 min-w-0">
                  <div class="mb-0.5 @xl:mb-0 min-w-0">
                    {comp.url ? (
                      <a 
                        href={comp.url} 
                        class="font-medium text-base-content hover:text-blue-400 transition-colors underline decoration-solid underline-offset-2 text-sm truncate"
                        title={comp.hoverText || `Read more about ${comp.name}`}
                      >
                        {comp.name}
                      </a>
                    ) : (
                      <span class="font-medium text-sm truncate text-base-content">{comp.name}</span>
                    )}
                  </div>
                  <div class="text-xs text-base-content/70 whitespace-nowrap @xl:text-right">{comp.date}</div>
                </div>
                
                <div class="flex items-center gap-4 flex-shrink-0 ml-3">
                  {comp.record && (
                    <div class="w-12 flex justify-center">
                      <span class="badge badge-sm badge-outline min-w-12 text-center text-base-content">{comp.record}</span>
                    </div>
                  )}
                  {!comp.record && hasRecords && (
                    <span class="w-12"></span>
                  )}
                  <div class="w-16.5 flex justify-center">
                    <span class={`badge badge-sm min-w-16 text-center ${placementBadgeClass(comp.placement)}`}>
                      {formatPlacement(comp.placement)}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  )}
  
  <!-- Tags -->
  {shouldShowTags && (
    <div class={hasActions ? "mb-6" : "mb-0"}>
      <h3 class="text-sm font-semibold mb-2 text-base-content">Tags</h3>
      <div class="flex flex-wrap gap-2">
        {tagsToDisplay.map(tag => (
          <a href={`/tags/${tag}/`} class="badge badge-outline tag-hover-light-blue transition-colors text-base-content no-underline font-normal">
            {tag}
          </a>
        ))}
      </div>
    </div>
  )}
  
  <!-- Action Buttons -->
  {hasActions && (
    <div class="mt-6 flex flex-wrap gap-3">
      {actionLinks.map(link => (
        <a href={link.url} class={`btn ${link.colorClass}`} target="_blank" rel="noopener noreferrer">
          {link.iconDef && <LinkButtonIcon icon={link.iconDef} />}
          {link.label}
        </a>
      ))}
    </div>
  )}

</div> <!-- Close summary-content -->
