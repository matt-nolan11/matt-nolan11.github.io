<style>
  /* Brand-tinted hover for the social icons, matching the About page's social
     buttons: the icon takes on its network's colour.

     GitHub is the one that cannot reuse the About page's treatment. There the
     button fills with near-black and the label turns white; an icon has no
     fill to trade against, and near-black is already what base-content is in
     the light theme, so a black hover would be invisible. GitHub's own accent
     purple gives feedback on both themes instead — the two values are the
     light/dark pair GitHub uses for it.

     `:global()` is required on the [data-theme] ancestor: it lives on <html>,
     which this component does not emit, so Astro would otherwise scope the
     attribute selector to an element in here and the rule would never match. */
  .social-link {
    transition: color 300ms ease;
  }

  .social-mail:hover {
    color: var(--color-success);
  }

  .social-linkedin:hover {
    color: var(--color-primary);
  }

  .social-github:hover {
    color: #6e5494;
  }

  :global([data-theme='business']) .social-github:hover {
    color: #a371f7;
  }

  .social-youtube:hover {
    color: #cc0000;
  }
</style>
