---
/**
 * RelatedContent – Shared related-content section for project and post detail pages.
 */
import { Image } from 'astro:assets';
import TagList from './TagList.tsx';

interface RelatedItem {
  type: 'project' | 'post';
  slug: string;
  data: {
    title?: string;
    cover?: any;
    coverCaption?: string;
    tags: string[];
    [key: string]: any;
  };
  sharedTags: string[];
  relevanceScore: number;
}

interface Props {
  items: RelatedItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="mt-16 pt-8 border-t border-base-300">
    <h2 class="text-2xl font-bold mb-6">Related Content</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map(item => (
        <article class="project-card card bg-base-100 shadow hover:shadow-lg transition-shadow duration-200 rounded-xl overflow-hidden relative">
          <a
            href={`/${item.type === 'project' ? 'projects' : 'posts'}/${item.slug}/`}
            class="block"
          >
            {item.data.cover && (
              <figure class="aspect-[4/3] rounded-t-xl overflow-hidden">
                <Image
                  src={item.data.cover}
                  alt={item.data.coverCaption || item.data.title || item.slug.replace(/-/g, ' ')}
                  width={300}
                  height={200}
                  class="w-full h-full object-cover"
                />
              </figure>
            )}
            <div class="card-body p-4">
              <div class="flex items-center gap-2 mb-2">
                <div class={`badge badge-sm ${item.type === 'project' ? 'badge-primary' : 'badge-secondary'}`}>
                  {item.type}
                </div>
                <div class="text-xs text-base-content/60">
                  {item.sharedTags.length} shared tag{item.sharedTags.length !== 1 ? 's' : ''}
                </div>
              </div>
              <h3 class="card-title text-base">{item.data.title || item.slug.replace(/-/g, ' ')}</h3>
            </div>
          </a>
          {/* z-20, not z-50 — see ProjectCard: z-50 ties with the sticky
              navbar and wins on DOM order, so the badge covers it. */}
          {item.type === 'project' && item.data.status && (
            <div class="absolute top-2 right-2 z-20">
              <div class="tooltip tooltip-bottom tooltip-bottom-end" data-tip={
                item.data.status === 'completed' ? 'This project is finished, and no new development is currently planned'
                : item.data.status === 'in-progress' ? 'This project is under active development'
                : item.data.status === 'active' ? 'This project is being maintained, but no new development is currently planned'
                : item.data.status === 'paused' ? 'Development on this project is paused, and may resume in the future'
                : 'This project is in the planning stage, and has not started active development yet'
              }>
                <div class={`badge status-badge ${
                  item.data.status === 'completed' ? 'badge-success'
                  : item.data.status === 'in-progress' ? 'badge-warning'
                  : item.data.status === 'active' ? 'badge-accent'
                  : item.data.status === 'paused' ? 'badge-neutral'
                  : 'badge-info'
                }`}>{
                  item.data.status === 'completed' ? 'Completed'
                  : item.data.status === 'in-progress' ? 'In Progress'
                  : item.data.status === 'active' ? 'Active'
                  : item.data.status === 'paused' ? 'Paused'
                  : 'Planned'
                }</div>
              </div>
            </div>
          )}
          <div class="px-4 pb-4">
            <TagList tags={item.sharedTags} size="xs" />
          </div>
        </article>
      ))}
    </div>
  </section>
)}
