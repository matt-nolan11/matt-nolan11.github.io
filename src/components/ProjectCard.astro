---
/**
 * ProjectCard – Reusable project card used on the homepage, projects index, and tag pages.
 *
 * Props:
 *   project      – A projects collection entry
 *   activeTag    – If set, this tag gets `badge-primary` styling (used on tag pages)
 *   maxTags      – Max tags to show before "+N more" (default: 3, use Infinity to show all)
 *   showActions  – Show the GitHub button and the project's `links` (default: false)
 *   headingLevel – 'h2' | 'h3' for the title element (default: 'h2')
 */
import { Image } from 'astro:assets';
import { formatProjectDate } from '../utils/dateUtils';
import { getEntrySlug } from '../utils/contentUtils';
import { resolveLinks } from '../utils/linkButtons';
import LinkButtonIcon from './LinkButtonIcon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  activeTag?: string;
  maxTags?: number;
  showActions?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const {
  project,
  activeTag,
  maxTags = 3,
  showActions = false,
  headingLevel = 'h2',
} = Astro.props;

const { data } = project;
const slug = getEntrySlug(project);
const visibleTags = maxTags === Infinity ? data.tags : data.tags.slice(0, maxTags);
const extraCount = data.tags.length - visibleTags.length;

const dateLabel =
  data.status === 'completed' && data.endDate
    ? `Completed: ${formatProjectDate(data.endDate ?? new Date())}`
    : data.status === 'in-progress' || data.status === 'active' || data.status === 'paused'
      ? `Started: ${formatProjectDate(data.startDate ?? new Date())}`
      : `Planned: ${formatProjectDate(data.startDate ?? new Date())}`;

const statusClass =
  data.status === 'completed' ? 'badge-success'
  : data.status === 'in-progress' ? 'badge-warning'
  : data.status === 'active' ? 'badge-accent'
  : data.status === 'paused' ? 'badge-neutral'
  : 'badge-info';

const statusLabel =
  data.status === 'completed' ? 'Completed'
  : data.status === 'in-progress' ? 'In Progress'
  : data.status === 'active' ? 'Active'
  : data.status === 'paused' ? 'Paused'
  : 'Planned';

const Heading = headingLevel;

// Same resolution the project page's Summary uses, so a link's label, colour
// and glyph match in the grid and on the page — only the sizing differs.
const actionLinks = resolveLinks(data.links);
---

<article
  class="project-card card bg-base-100 shadow-md border border-base-300 rounded-xl h-full relative"
>
  <a
    href={`/projects/${slug}/`}
    class="absolute inset-0 z-10"
    aria-label={data.title}
  ></a>

  <figure class="relative aspect-[4/3] rounded-t-xl overflow-hidden">
    {data.cover ? (
      <Image
        src={data.cover}
        alt={data.coverCaption || data.title || slug.replace(/-/g, ' ')}
        width={560}
        height={420}
        class="w-full h-full object-cover"
      />
    ) : (
      <div class="w-full h-full bg-base-200 flex items-center justify-center">
        <span class="text-base-content/50 text-lg">No Image</span>
      </div>
    )}
  </figure>

  {/* z-20 to clear the full-card overlay link (z-10), and no higher: at z-50
      this tied with the sticky navbar and, being later in the DOM, painted
      over it while scrolling. */}
  <div class="absolute top-2 right-2 z-20">
      <div class="tooltip tooltip-bottom tooltip-bottom-end" data-tip={
      data.status === 'completed' ? 'This project is finished, and no new development is currently planned'
      : data.status === 'in-progress' ? 'This project is under active development'
      : data.status === 'active' ? 'This project is being maintained, but no new development is currently planned'
      : data.status === 'paused' ? 'Development on this project is paused, and may resume in the future'
      : 'This project is in the planning stage, and has not started active development yet'
    }>
      <div class={`badge status-badge ${statusClass}`}>{statusLabel}</div>
    </div>
  </div>

  <div class="card-body">
    <Heading class="card-title">{data.title}</Heading>

    <p class="text-sm text-base-content/70 mb-2">{data.description}</p>

    {data.tags && data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {visibleTags.map(tag => (
          <a
            href={`/tags/${tag}/`}
            class:list={[
              'badge badge-sm tag-hover-light-blue transition-colors relative z-20',
              activeTag && tag === activeTag ? 'badge-primary' : 'badge-outline',
            ]}
          >
            {tag}
          </a>
        ))}
        {extraCount > 0 && (
          <span class="badge badge-ghost badge-sm">+{extraCount} more</span>
        )}
      </div>
    )}

    <div class="flex justify-between items-center">
      <span class="text-sm text-base-content/60">{dateLabel}</span>

      {/* Wraps: a project can carry more links than fit on one card row. */}
      {showActions && (
        <div class="flex flex-wrap justify-end gap-2">
          {actionLinks.map(link => (
            <a
              href={link.url}
              class={`btn btn-sm ${link.colorClass} relative z-20`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.iconDef && <LinkButtonIcon icon={link.iconDef} class="w-3.5 h-3.5" />}
              {link.label}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>
