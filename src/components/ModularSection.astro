---
import { Image } from 'astro:assets';
import { markdown } from '../utils/markdown';
import ProjectGallery from './ProjectGallery';
import ModelViewer from './ModelViewer';
import Summary from './Summary.astro';
import YouTube from './YouTube.astro';

const {
  columns,
  class: className,
  style: styleProp,
  autoBalance = true,
  // Wide enough that the solver settles on shape rather than on a clamp.
  //
  // Clamping was doing the work while Summary was short-and-wide: too wide a
  // range let it starve the visual column, too narrow a one pinned different
  // sections against opposite ends. Now that Summary is tall-and-narrow by
  // construction, the height curves actually cross inside this range.
  balanceRange = [30, 72],
  frontmatterTags,
} = Astro.props;

// Use provided frontmatterTags, or read from Astro.locals if available
const resolvedFrontmatterTags = frontmatterTags ?? (Astro.locals?.frontmatterTags || undefined);

if (!columns || columns.length === 0) {
  throw new Error('ModularSection requires a columns prop with at least one column');
}

// Height balancing only makes sense for a true two-column layout. The authored
// `width` still drives SSR/no-JS/mobile; the client just refines it from there.
const canBalance = autoBalance !== false && columns.length === 2;
const [balanceMin, balanceMax] = balanceRange;

/**
 * Strip the common leading indentation from a `content` string.
 *
 * Content is authored as a template literal inside the columns array, so every
 * line carries the indentation of the surrounding JS. Markdown treats any line
 * indented four or more spaces as a code block, so that prose rendered as one
 * big <pre> instead of formatted text. Nesting inside a `stack` makes it worse,
 * since the indentation is deeper still.
 *
 * Removing the shallowest indent preserves relative indentation, so nested
 * lists and intentional code blocks inside the content still work.
 */
function dedent(text: unknown): string {
  if (!text) return '';

  const lines = String(text).replace(/\t/g, '  ').split('\n');
  const indents = lines
    .filter((line) => line.trim())
    .map((line) => line.match(/^ */)?.[0].length ?? 0);
  const shallowest = indents.length ? Math.min(...indents) : 0;

  return lines.map((line) => line.slice(shallowest)).join('\n').trim();
}
---

<style>
  /* A note on what can and cannot be styled from here.
     ------------------------------------------------------------------
     These styles are scoped, so Astro rewrites every selector to require
     `[data-astro-cid-pvnfhpq6]` on *each* compound — `.column .project-gallery`
     compiles to `.column[…cid] .project-gallery[…cid]`. That attribute is only
     stamped on elements this component's template emits, plus the root element
     of any .astro child. It never reaches:

       - anything inside a client island (ProjectGallery, ModelViewer), which
         React renders in the browser with no knowledge of the scope,
       - <astro-island> itself (the scope is passed to the island as a prop),
       - descendants inside a child .astro component (only its root is stamped).

     So a rule aimed at `.project-gallery`, `model-viewer`,
     `.model-viewer-container` or `.summary-content` matches nothing, no matter
     how many !importants it carries. Several such rules used to live here; they
     were removed after checking in the browser that every one matched zero
     elements, and that force-applying them (via :global) made things worse
     rather than better — the gallery reset inflated thumbnails from 64px to
     109px, and the model-viewer-container reset added 18px to a model column.
     The islands size themselves correctly on their own.

     Style the wrappers below instead — `.gallery-col`, `.info-col`,
     `.model-col` are emitted here and are stamped — or use `:global()`
     deliberately, as the astro-island rule does. */

  /* Generic wrappers for column types */
  .gallery-col {
    width: 100%;
    padding: 0;
    margin: 0;
    display: block;
    position: relative;
    /* Collapses the whitespace between the gallery's inline children. Each
       piece of real text inside sets its own size via a utility class. */
    line-height: 0;
    font-size: 0;
  }

  .info-col {
    width: 100%;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  /* Gives the model island a real block box so its height is measurable. */
  .model-col {
    width: 100%;
    display: block;
  }

  /* <astro-island> is an unknown element and so inline by default, which
     collapses its box. :global is required — Astro passes the scope to the
     island as a prop, it does not stamp it on the <astro-island> element, so a
     scoped selector here would never match. */
  .model-col > :global(astro-island) {
    display: block;
    width: 100%;
  }

  /* Ensure regular columns have proper styling for components */
  .column {
    display: block;
    line-height: initial;
    font-size: initial;
    min-width: 0; /* Prevent overflow */
  }

  /* Responsive columns using CSS Grid with dynamic custom properties */
  .responsive-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  @media (min-width: 1024px) {
    .responsive-columns {
      grid-template-columns: var(--col1-width, 1fr) var(--col2-width, 1fr);
    }

    /* Hold the section back until the balancer has picked a split, so the
       authored seed split never paints first. Only applies side-by-side —
       below this breakpoint the grid is single-column and nothing is solved.
       The attribute is server-rendered (so there is no visible-then-hidden
       flash) and removed by script; the <noscript> block below and a
       setTimeout fallback both guarantee it cannot get stuck. */
    .responsive-columns[data-balance-pending] {
      visibility: hidden;
    }
  }
  
  .responsive-columns .column {
    min-width: 0; /* Important for grid items to allow shrinking */
  }

  /* Keeps a template-rendered image from overflowing a narrow column. Applies
     to `type: 'image'` blocks, whose <figure>/<Image> this component emits
     itself — unlike the island-rendered components above, these are stamped
     with the scope and so are genuinely reachable from here. */
  .responsive-columns .column figure,
  .responsive-columns .column img {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  /* Ensure figure/image spacing is predictable */
  .column figure {
    margin: 0;
    padding: 0;
  }
  
  .column img {
    display: block;
  }

  /* Ensure all columns stay within bounds without clipping */
  .column {
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

</style>

<script>
  /**
   * Auto-balance two-column ModularSections so both columns end up as close to
   * the same content height as possible at whatever width the visitor's screen
   * happens to be.
   *
   * Approach: sweep candidate splits and measure the real elements. Predicting
   * text height analytically is too fragile (fonts, headings, list items), and
   * it can't be done at build time anyway since it needs pixel widths.
   *
   * The sweep runs synchronously in a single task. The browser computes a
   * layout for each candidate but never paints an intermediate one, so the
   * whole search is invisible — only the final split is ever rendered.
   *
   * Getting *one* solve is the other half of the problem. Web fonts and
   * client:load islands (the gallery only renders thumbnails once hydrated)
   * both change content height after first paint, so solving eagerly and again
   * later paints a different split each time. Instead we wait for fonts, then
   * poll until heights stop moving, and solve exactly once. The section is
   * held at visibility:hidden until that lands so no intermediate split shows.
   */

  // Matches the min-width in the .responsive-columns media query. Below this
  // the grid collapses to one column and the widths are unused.
  const SIDE_BY_SIDE_MIN = 1024;

  // Column heights must be unchanged for this many consecutive frames before
  // we trust them enough to solve. One is enough now that nothing moves after
  // first paint (no web fonts, gallery thumbnails server-render); each extra
  // frame is ~16ms added to every page load.
  const SETTLE_FRAMES = 1;

  // ?balanceDebug on any URL logs where the time actually goes.
  const DEBUG =
    typeof location !== 'undefined' && location.search.includes('balanceDebug');

  // Caps on waiting for the layout to settle, and a last-resort reveal so a
  // section can never stay hidden because something upstream stalled.
  //
  // The settle cap can be short because the pieces that used to move after
  // first paint no longer do: there are no web fonts, and ProjectGallery now
  // server-renders its thumbnails so hydration does not change column height.
  // In the common case the poll confirms stability in ~2 frames and never
  // approaches this ceiling.
  const MAX_SETTLE_MS = 150;
  const REVEAL_FALLBACK_MS = 1000;

  // Keep the authored width if it's already within this many pixels of the best
  // split found — respects author intent and avoids pointless nudging.
  const DEADBAND_PX = 8;

  // Coarse sweep granularity. Halved repeatedly around the running winner
  // until it reaches 1%, so the range is covered in ~13 probes rather than the
  // ~19 a coarse-then-flat-fine pass needed.
  const COARSE_STEP = 8;

  /**
   * Height of a column's actual content.
   *
   * Note: we cannot measure the column element itself. Grid cells stretch to
   * the row height, so both columns would always report identical heights and
   * every candidate would tie. Measuring the children gives the natural height.
   */
  function contentHeight(col: Element): number {
    let top = Infinity;
    let bottom = -Infinity;
    for (const kid of Array.from(col.children)) {
      const r = kid.getBoundingClientRect();
      if (r.width === 0 && r.height === 0) continue; // skip collapsed nodes
      top = Math.min(top, r.top);
      bottom = Math.max(bottom, r.bottom);
    }
    return bottom > top ? bottom - top : 0;
  }

  function applySplit(section: HTMLElement, pct: number) {
    section.style.setProperty('--col1-width', `${pct}fr`);
    section.style.setProperty('--col2-width', `${100 - pct}fr`);
  }

  /**
   * Of everything measured so far, the split with the smallest height
   * mismatch. Among splits that are effectively tied, prefer the one nearest
   * the authored width so the result stays close to the intended proportions.
   */
  function bestSplit(results: Map<number, number>, seed: number): number {
    const minDiff = Math.min(...results.values());
    let best = seed;
    let found = false;
    for (const [pct, diff] of results) {
      if (diff > minDiff + 0.5) continue;
      if (!found || Math.abs(pct - seed) < Math.abs(best - seed)) {
        best = pct;
        found = true;
      }
    }
    return best;
  }

  function balance(section: HTMLElement) {
    if (window.innerWidth < SIDE_BY_SIDE_MIN) return;

    const cols = section.querySelectorAll<HTMLElement>(':scope > .column');
    if (cols.length !== 2) return;

    // A section inside an unselected version tab is display:none and measures
    // as zero. Skip it; the ResizeObserver re-runs us when the tab is shown.
    if (!section.getBoundingClientRect().width) return;

    const seed = Math.round(Number(section.dataset.balanceSeed) || 50);
    const min = Math.round(Number(section.dataset.balanceMin) || 30);
    const max = Math.round(Number(section.dataset.balanceMax) || 70);

    // Pin the section's outer height for the duration of the sweep.
    //
    // This is the single biggest cost saver. Each probe forces a synchronous
    // relayout, and without this the section's height changes on every one,
    // so the browser must re-lay-out the entire rest of the document each
    // time. With the outer box fixed, the work is confined to this section's
    // subtree. Children are still auto-height, so their measured content
    // heights are unaffected; overflow is clipped so the temporarily
    // oversized content cannot alter ancestor scroll height or width.
    const priorHeight = section.style.height;
    const priorOverflow = section.style.overflow;
    section.style.height = `${section.getBoundingClientRect().height}px`;
    section.style.overflow = 'hidden';

    const results = new Map<number, number>();
    const probe = (raw: number) => {
      const pct = Math.min(max, Math.max(min, Math.round(raw)));
      if (!results.has(pct)) {
        applySplit(section, pct);
        // Reading geometry here forces the layout we just asked for.
        results.set(
          pct,
          Math.abs(contentHeight(cols[0]) - contentHeight(cols[1]))
        );
      }
    };

    // Try the authored split first. Hand-tuned widths are usually close, and
    // if this one is already balanced within the deadband we are done after a
    // single probe instead of sweeping the entire range.
    probe(seed);
    if ((results.get(seed) ?? Infinity) <= DEADBAND_PX) {
      applySplit(section, seed);
      section.style.height = priorHeight;
      section.style.overflow = priorOverflow;
      return results.size;
    }

    // Otherwise sweep: one coarse pass over the whole range to find the right
    // basin, then successively halve the step around the running winner.
    //
    // Each probe costs a forced synchronous relayout of this section, so probe
    // count is the dominant cost of the whole feature. Halving reaches 1%
    // precision in roughly a third of the probes a flat fine pass needs, while
    // still starting from a full-range scan so a distant optimum is not missed.
    for (let pct = min; pct <= max; pct += COARSE_STEP) probe(pct);
    probe(max);

    let step = COARSE_STEP;
    while (step > 1) {
      const finer = Math.max(1, Math.floor(step / 2));
      const around = bestSplit(results, seed);
      probe(around - finer);
      probe(around + finer);
      step = finer;
    }

    const best = bestSplit(results, seed);
    const seedDiff = results.get(seed);
    const bestDiff = results.get(best) ?? Infinity;
    const keepSeed = seedDiff !== undefined && seedDiff <= bestDiff + DEADBAND_PX;

    const chosen = keepSeed ? seed : best;
    applySplit(section, chosen);

    // Release the height pin so the section resizes to the winning split.
    section.style.height = priorHeight;
    section.style.overflow = priorOverflow;

    if (DEBUG) {
      // The probe table is the ground truth for whether the search is sane.
      // If diff keeps falling toward one end but we stopped at the opposite
      // clamp, the search is wrong; if it genuinely bottoms out at the clamp,
      // the objective is wrong. These need different fixes.
      const table = [...results.entries()]
        .sort((a, b) => a[0] - b[0])
        .map(([pct, diff]) => `${pct}:${Math.round(diff)}`)
        .join('  ');
      console.info(`[balance]   probes (split:heightDiff)  ${table}`);

      // Re-measure a couple of splits one frame later. If these disagree with
      // the table above, the synchronous sweep is reading stale layout —
      // container queries not re-resolving inside a forced reflow.
      const recheck = [min, Math.round((min + max) / 2), max];
      const sync = recheck.map((pct) => results.get(pct));
      requestAnimationFrame(() => {
        const live = recheck.map((pct) => {
          applySplit(section, pct);
          return Math.round(
            Math.abs(contentHeight(cols[0]) - contentHeight(cols[1]))
          );
        });
        applySplit(section, chosen);
        console.info(
          `[balance]   recheck at ${recheck.join('/')} -> ` +
            `sweep said ${sync.map((v) => (v === undefined ? '?' : Math.round(v))).join('/')} | ` +
            `live says ${live.join('/')}` +
            `${sync.some((v, i) => v !== undefined && Math.abs(v - live[i]) > 20) ? '  <-- MISMATCH, sweep is reading stale layout' : '  (consistent)'}`
        );
      });

      console.info(
        `[balance]   ${Math.round(section.getBoundingClientRect().width)}px wide ` +
          `-> ${chosen}/${100 - chosen}` +
          `${chosen === min ? ' (AT MIN)' : chosen === max ? ' (AT MAX)' : ''}` +
          `${keepSeed ? ' (kept seed)' : ''} | ` +
          `heights ${Math.round(contentHeight(cols[0]))}/${Math.round(contentHeight(cols[1]))} | ` +
          `${results.size} probes`,
        section
      );
    }

    return results.size;
  }

  /** Cheap fingerprint of both columns' content heights. */
  function heightSignature(cols: HTMLElement[]): string {
    return cols.map((c) => Math.round(contentHeight(c))).join('|');
  }

  /**
   * Wait until the columns' heights hold steady across consecutive frames,
   * which is what tells us fonts have applied and any client:load island in
   * the section has finished hydrating. Bounded so a page that never settles
   * (e.g. an animation inside a column) still gets solved.
   */
  function whenSettled(cols: HTMLElement[], done: () => void) {
    const start = performance.now();
    let previous = '';
    let stableFrames = 0;

    const tick = () => {
      const signature = heightSignature(cols);
      if (signature === previous) {
        stableFrames++;
      } else {
        stableFrames = 0;
        previous = signature;
      }

      if (stableFrames >= SETTLE_FRAMES || performance.now() - start > MAX_SETTLE_MS) {
        done();
      } else {
        requestAnimationFrame(tick);
      }
    };

    requestAnimationFrame(tick);
  }

  function init() {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-auto-balance]')
    ).filter((section) => !section.dataset.balanceReady);

    if (!sections.length) return;
    sections.forEach((s) => (s.dataset.balanceReady = 'true'));

    const t0 = performance.now();
    const revealAll = () =>
      sections.forEach((s) => s.removeAttribute('data-balance-pending'));

    // Never leave the page hidden, whatever happens below.
    setTimeout(revealAll, REVEAL_FALLBACK_MS);

    sections.forEach((section) => {
      // Re-solve when the *container* width changes: viewport resize, or a
      // version tab going from display:none to visible. Deliberately ignores
      // height changes, which our own column edits cause — comparing width
      // only is what keeps this from feeding back into itself.
      let lastWidth = section.getBoundingClientRect().width;
      let frame = 0;
      new ResizeObserver(() => {
        const width = section.getBoundingClientRect().width;
        if (Math.abs(width - lastWidth) < 1) return;
        lastWidth = width;
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => balance(section));
      }).observe(section);
    });

    // Waiting on document.fonts.ready costs ~30-50ms because it does not
    // resolve until initial layout finishes, and we only care if a font swap
    // could still reflow text.
    //
    // Checking `size` is not enough: global.css imports KaTeX, which registers
    // 20 @font-face rules on every page whether or not any math is rendered.
    // `status` is the real signal — a registered face that nothing uses is
    // never fetched, so status stays 'loaded' and we can skip the wait. A page
    // that genuinely is downloading a font reports 'loading' and still waits.
    const fontsLoading = document.fonts?.status === 'loading';
    const fontsReady = fontsLoading ? document.fonts.ready : Promise.resolve();

    fontsReady
      .then(() => {
        const tFonts = performance.now();

        // One settle poll across every column on the page, then every sweep in
        // a single task. Per-section polling serialised badly: each section's
        // sweep blocked the frame the next section's poll needed to tick, so
        // their start times stacked up instead of overlapping.
        const allCols = sections.flatMap((section) =>
          Array.from(
            section.querySelectorAll<HTMLElement>(':scope > .column')
          )
        );

        whenSettled(allCols, () => {
          const tSettled = performance.now();
          let probes = 0;
          sections.forEach((section) => {
            probes += balance(section) ?? 0;
          });
          revealAll();

          if (DEBUG) {
            const now = performance.now();
            console.info(
              `[balance] ${sections.length} sections | ` +
                `fonts ${(tFonts - t0).toFixed(1)}ms | ` +
                `settle ${(tSettled - tFonts).toFixed(1)}ms | ` +
                `sweep ${(now - tSettled).toFixed(1)}ms (${probes} probes) | ` +
                `total ${(now - t0).toFixed(1)}ms`
            );
          }
        });
      })
      .catch(revealAll);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

{(() => {
  // Resolve the width percentage for column 1 (column 2 takes the remainder).
  const getCol1Width = (columns: any[]): number => {
    if (columns.length !== 2) return 50;

    const col1 = columns[0];
    const col2 = columns[1];

    let col1Width = 50; // Default

    // Check for explicit width on either column
    if (col1.width !== undefined) {
      col1Width = col1.width;
    } else if (col2.width !== undefined) {
      col1Width = 100 - col2.width;
    } else {
      // Check for layout options in gallery or other settings
      const layoutSource = (col1 && (col1.galleryOptions?.layout || col1.layout))
        || (col2 && (col2.galleryOptions?.layout || col2.layout));
      
      if (layoutSource) {
        // Handle ratio format: "55:45", "3:2", etc.
        if (typeof layoutSource === 'string' && layoutSource.includes(':')) {
          const [left, right] = layoutSource.split(':').map(Number);
          if (!isNaN(left) && !isNaN(right) && left > 0 && right > 0) {
            const total = left + right;
            col1Width = (left / total) * 100;
          }
        }
        
        // Handle percentage format: "60%"
        else if (typeof layoutSource === 'string' && layoutSource.endsWith('%')) {
          const percentage = parseFloat(layoutSource);
          if (!isNaN(percentage) && percentage > 0 && percentage < 100) {
            col1Width = percentage;
          }
        }
        
        // Handle named layouts
        else {
          const namedLayouts: { [key: string]: number } = {
            'narrow-wide': 33,
            'wide-narrow': 67,
            'equal': 50,
            'golden': 62, // Approximately golden ratio
            'sidebar': 75,
            'reverse-sidebar': 25,
          };
          
          if (namedLayouts[layoutSource]) {
            col1Width = namedLayouts[layoutSource];
          }
        }
      }
    }
    
    return col1Width;
  };

  const col1Width = getCol1Width(columns);
  const gridStyleStr = columns.length === 2
    ? `--col1-width: ${col1Width}fr; --col2-width: ${100 - col1Width}fr`
    : '';
  const finalStyle = styleProp ? `${gridStyleStr}; ${styleProp}` : gridStyleStr;

  // Renders a single content block (video, gallery, image, content, summary, model).
  // Used both for a column's own type and for each item inside a "stack" column.
  const renderBlock = (block: any, idx: number) => {
    // Image props: prefer new schema (src/alt/caption), fallback to legacy (image/imageAlt/imageCaption)
    const imgSrc = block?.src || block?.image;
    const imgAlt = block?.alt || block?.imageAlt || `Image ${idx + 1}`;
    const imgCaption = block?.caption || block?.imageCaption;
    // Gallery options: prefer nested galleryOptions, fallback to legacy top-level keys
    const gOpts = block?.galleryOptions || {};
    const galleryAutoplay = (gOpts.autoplay ?? block?.autoplay ?? (block?.gallery?.length > 1));
    const galleryInterval = (gOpts.autoplayInterval ?? block?.autoplayInterval ?? 5000);
    const galleryThumbs = (gOpts.showThumbnails ?? block?.showThumbnails ?? (block?.gallery?.length > 2));
    const galleryLoop = (gOpts.loop ?? block?.loop ?? true);
    const galleryAspect = (gOpts.aspectRatio ?? block?.aspectRatio);

    // ModelViewer derives its box from aspectRatio, so a model column with
    // neither aspectRatio nor an explicit height falls back to the component's
    // fixed 16rem — which is rarely the framing an author wanted. Default a
    // ratio in rather than leaving that to chance.
    const mOpts = block?.modelOptions || {};
    const modelOptions =
      mOpts.aspectRatio || mOpts.mobileAspectRatio || mOpts.height
        ? mOpts
        : { aspectRatio: '4:3', ...mOpts };

    return (
      <>
        {block.type === 'content' && (
          <div class="prose prose-lg max-w-none">
            {/* Unstyled on purpose: prose supplies the heading styling, so a
                column title renders identically to a `###` written in MDX or
                inside a content string. It was previously an <h2> carrying
                text-2xl/font-bold/mb-4, which rendered at h3's size while
                claiming h2's level — the utilities beat the prose rules on
                source order, since :where() gives those zero specificity. h3
                is also the truer level: these title sections rather than
                heading them. */}
            {block.title && <h3>{block.title}</h3>}
            {/* Fragment, not a <div>: a wrapper element would make the rendered
                markdown a grandchild of .prose, and Tailwind's
                `.prose > :first-child { margin-top: 0 }` only matches direct
                children. The leading <p> kept its 1.25em top margin, which
                looked like space reserved for an absent title. */}
            <Fragment set:html={markdown.parse(dedent(block.content))} />
          </div>
        )}

        {block.type === 'image' && imgSrc && (
          <figure>
            <Image
              src={imgSrc}
              alt={imgAlt}
              width={600}
              height={400}
              class="w-full h-auto object-cover rounded-lg shadow"
            />
            {imgCaption && (
              <figcaption class="mt-2 text-center text-base-content/60 text-sm" set:html={imgCaption}></figcaption>
            )}
          </figure>
        )}

        {block.type === 'gallery' && block.gallery && (
          <div class="gallery-col">
            <ProjectGallery
              images={block.gallery}
              autoplay={galleryAutoplay}
              autoplayInterval={galleryInterval}
              showThumbnails={galleryThumbs}
              loop={galleryLoop}
              aspectRatio={galleryAspect}
              client:load
            />
          </div>
        )}

        {block.type === 'summary' && (
          <div class="info-col">
            <Summary
              title={block.summaryTitle || block.title}
              description={block.summaryDescription || block.description}
              startDate={block.startDate}
              endDate={block.endDate}
              status={block.status}
              headerTitleSize={block.headerTitleSize}
              metrics={block.metrics}
              competitions={block.competitions}
              competitionsOptions={block.competitionsOptions}
              frontmatterTags={resolvedFrontmatterTags}
              showTags={block.showTags}
              tags={block.tags || []}
              githubUrl={block.githubUrl}
              liveUrl={block.liveUrl}
            />
          </div>
        )}

        {block.type === 'model' && block.modelSrc && (
          /* The wrapper is load-bearing, not cosmetic. A client:load island
             renders as <astro-island>, an unknown element that defaults to
             display:inline, so its bounding rect ignores the block content
             inside it. The balancer measures a column's children, so a bare
             island reported height 0 and the solver balanced against an empty
             column. Every other column type already has a block wrapper.

             modelOptions is spread last so a title/caption already living in
             there keeps winning — the column-level props below are a shorthand,
             not a replacement. */
          <div class="model-col">
            <ModelViewer
              src={block.modelSrc}
              alt={block.modelAlt || 'Interactive 3D model'}
              title={block.modelTitle || block.title}
              caption={block.modelCaption || block.caption}
              {...modelOptions}
              client:load
            />
          </div>
        )}

        {block.type === 'video' && block.videoId && (
          <YouTube
            id={block.videoId}
            title={block.videoTitle || block.title || 'Video'}
            aspect={block.videoAspect || '16:9'}
            start={block.videoStart}
            autoplay={block.videoAutoplay}
            muted={block.videoMuted}
            controls={block.videoControls}
            caption={block.videoCaption}
            poster={block.videoPoster}
            eager={block.videoEager}
          />
        )}
      </>
    );
  };

  return (
    <>
    <div class:list={[(
      columns.length <= 2 ? (columns.length === 2 ? 'responsive-columns' : 'flex flex-col lg:flex-row lg:items-start') :
      columns.length === 3 ? 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3' :
      columns.length === 4 ? 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4' :
      'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3' // Fallback for 5+ columns
    ), 'gap-6', 'modular-section', className]} style={finalStyle}
      data-auto-balance={canBalance ? 'true' : undefined}
      data-balance-pending={canBalance ? 'true' : undefined}
      data-balance-seed={canBalance ? String(col1Width) : undefined}
      data-balance-min={canBalance ? String(balanceMin) : undefined}
      data-balance-max={canBalance ? String(balanceMax) : undefined}
    >
      {columns.map((column: any, columnIndex: number) => {
        // Determine column class based on layout type
        let columnClass;
        if (columns.length === 1) {
          columnClass = 'w-full';
        } else if (columns.length === 2) {
          // Grid column - let CSS Grid handle sizing
          columnClass = 'column';
        } else {
          columnClass = 'min-w-0'; // Grid handles sizing for 3+ columns
        }
        
        return (
          <div class={columnClass}>
            {column.type === 'stack' && Array.isArray(column.items) ? (
              <div class="flex flex-col" style={`gap: ${column.stackGap || '1.5rem'}`}>
                {column.items.map((item: any, itemIndex: number) => (
                  <div class="stack-item">{renderBlock(item, itemIndex)}</div>
                ))}
              </div>
            ) : (
              renderBlock(column, columnIndex)
            )}
          </div>
        );
      })}
    </div>
    {canBalance && (
      <noscript
        set:html={
          '<style>main:has([data-balance-pending]),[data-balance-pending]{visibility:visible !important;animation:none !important}</style>'
        }
      />
    )}
    </>
  );
})()}
