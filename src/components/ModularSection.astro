---
import { Image, getImage } from 'astro:assets';
import { marked } from 'marked';
import ProjectGallery from './ProjectGallery';
import ModelViewer from './ModelViewer';

// Helper function to optimize gallery images using Astro's image optimization
async function optimizeGalleryImages(gallery: any[]) {
  if (!gallery || gallery.length === 0) return [];
  
  return await Promise.all(
    gallery.map(async (image: any) => {
      try {
        const optimizedImage = await getImage({
          src: image.src,
          width: 800,
          height: 600,
          quality: 80,
          format: 'webp'
        });
        
        return {
          src: optimizedImage.src,
          alt: image.alt,
          caption: image.caption
        };
      } catch (error) {
        // Fallback to original image if optimization fails
        console.warn('Failed to optimize image:', image.src, error);
        return {
          src: image.src,
          alt: image.alt,
          caption: image.caption
        };
      }
    })
  );
}

// Pre-optimize gallery images for all sections
async function optimizeSectionGalleries(sections: any[]) {
  if (!sections || sections.length === 0) return sections;
  
  return await Promise.all(
    sections.map(async (section: any) => {
      const optimizedColumns = await Promise.all(
        section.columns.map(async (col: any) => {
          if (col.type === 'gallery' && col.gallery) {
            const optimizedGallery = await optimizeGalleryImages(col.gallery);
            return { ...col, gallery: optimizedGallery };
          }
          return col;
        })
      );
      return { ...section, columns: optimizedColumns };
    })
  );
}

// Optimize the sections
const { sections, columns, depth = 0 } = Astro.props;

// Support both the old sections API and new columns API
let sectionsToProcess;
if (columns) {
  // New simplified API: just pass columns directly
  sectionsToProcess = [{ columns }];
} else if (sections) {
  // Backward compatibility: use the existing sections structure
  sectionsToProcess = sections;
} else {
  // No data provided
  sectionsToProcess = [];
}

// Optimize the sections
const optimizedSections = await optimizeSectionGalleries(sectionsToProcess);

// Calculate appropriate heading levels based on nesting depth
const getHeadingLevel = (depth: number) => {
  if (depth === 0) return 'h2';
  if (depth === 1) return 'h3'; 
  if (depth === 2) return 'h4';
  if (depth === 3) return 'h5';
  return 'h6';
};

const getHeadingClass = (depth: number) => {
  if (depth === 0) return 'text-3xl font-bold mb-4';
  if (depth === 1) return 'text-2xl font-bold mb-4';
  if (depth === 2) return 'text-xl font-bold mb-4';
  if (depth === 3) return 'text-lg font-bold mb-3';
  return 'text-base font-bold mb-3';
};

const headingLevel = getHeadingLevel(depth);
const headingClass = getHeadingClass(depth);

// Calculate responsive column widths using CSS custom properties
const getColumnWidthData = (section: any) => {
  if (section.columns.length !== 2) {
    return null; // Not a 2-column layout
  }
  
  const col1 = section.columns[0];
  const col2 = section.columns[1];
  
  // Method 1: Individual column width properties (highest priority)
  if (col1.width !== undefined || col2.width !== undefined) {
    const col1Width = col1.width || (100 - (col2.width || 50));
    const col2Width = col2.width || (100 - col1Width);
    
    // Ensure they add up to 100%
    const total = col1Width + col2Width;
    const col1Percent = (col1Width / total) * 100;
    const col2Percent = (col2Width / total) * 100;
    
    return {
      col1: col1Percent,
      col2: col2Percent
    };
  }
  
  // Method 2: Section-level layout property
  if (section.layout) {
    const layout = section.layout;
    
    // String format: "60:40", "2:1", "70:30"
    if (typeof layout === 'string' && layout.includes(':')) {
      const [ratio1, ratio2] = layout.split(':').map(Number);
      const total = ratio1 + ratio2;
      const col1Percent = (ratio1 / total) * 100;
      const col2Percent = (ratio2 / total) * 100;
      
      return {
        col1: col1Percent,
        col2: col2Percent
      };
    }
    
    // Array format: [70, 30] or [2, 1]
    if (Array.isArray(layout) && layout.length === 2) {
      const [width1, width2] = layout;
      const total = width1 + width2;
      const col1Percent = (width1 / total) * 100;
      const col2Percent = (width2 / total) * 100;
      
      return {
        col1: col1Percent,
        col2: col2Percent
      };
    }
    
    // Named layouts
    const namedLayouts: { [key: string]: { col1: number, col2: number } } = {
      'narrow-wide': { col1: 33.333, col2: 66.667 },
      'wide-narrow': { col1: 66.667, col2: 33.333 },
      'equal': { col1: 50, col2: 50 },
      'golden': { col1: 38.196, col2: 61.804 }, // Golden ratio
      'sidebar': { col1: 75, col2: 25 },
      'reverse-sidebar': { col1: 25, col2: 75 }
    };
    
    if (namedLayouts[layout]) {
      return namedLayouts[layout];
    }
  }
  
  // Method 3: Default equal width (50:50)
  return { col1: 50, col2: 50 };
};

---

<style>
  .responsive-columns {
    --col1-width: 50%;
    --col2-width: 50%;
  }
  
  .responsive-columns .column:first-child {
    width: 100%;
  }
  
  .responsive-columns .column:last-child {
    width: 100%;
  }
  
  @media (min-width: 1024px) {
    .responsive-columns .column:first-child {
      width: var(--col1-width);
    }
    
    .responsive-columns .column:last-child {
      width: var(--col2-width);
    }
  }
</style>

<div class={`modular-sections ${depth === 0 ? 'space-y-8' : 'space-y-6'}`}>
  {optimizedSections.map((section: any, _i: number) => {
    const columnWidths = getColumnWidthData(section);
    
    return (
    <div 
      class={`section gap-6 ${
        section.columns.length <= 2 ? 'flex flex-col lg:flex-row lg:items-start' :
        'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-' + section.columns.length
      } ${section.columns.length === 2 && columnWidths ? 'responsive-columns' : ''}`}
      style={columnWidths ? `--col1-width: ${columnWidths.col1}%; --col2-width: ${columnWidths.col2}%;` : ''}
    >
      {section.columns.map((col: any, _j: number) => {
        let columnClass;
        
        if (section.columns.length === 1) {
          columnClass = 'w-full';
        } else if (section.columns.length === 2) {
          // Use responsive column class with CSS custom properties
          columnClass = 'column lg:flex-none';
        } else {
          columnClass = 'min-w-0'; // Grid handles sizing for 3+ columns
        }
        
        return (
        <div class={columnClass}>
          {col.type === 'content' && (
            <>
              {col.title && (
                <Fragment>
                  {headingLevel === 'h2' && <h2 class={headingClass}>{col.title}</h2>}
                  {headingLevel === 'h3' && <h3 class={headingClass}>{col.title}</h3>}
                  {headingLevel === 'h4' && <h4 class={headingClass}>{col.title}</h4>}
                  {headingLevel === 'h5' && <h5 class={headingClass}>{col.title}</h5>}
                  {headingLevel === 'h6' && <h6 class={headingClass}>{col.title}</h6>}
                </Fragment>
              )}
              <div class="prose prose-lg max-w-none" set:html={marked(col.content || '')} />
            </>
          )}
          
          {col.type === 'image' && col.src && (
            <figure class="flex flex-col items-center mb-2">
              <Image 
                src={col.src} 
                alt={col.alt || col.caption || ''} 
                width={600} 
                height={400} 
                class="w-full h-auto rounded-xl shadow-lg" 
              />
              {col.caption && (
                <figcaption class="mt-2 text-center text-base-content/60 text-sm" set:html={col.caption}></figcaption>
              )}
            </figure>
          )}
          
          {col.type === 'model' && col.modelSrc && (
            <>
              {col.title && (
                <Fragment>
                  {headingLevel === 'h2' && <h2 class={headingClass}>{col.title}</h2>}
                  {headingLevel === 'h3' && <h3 class={headingClass}>{col.title}</h3>}
                  {headingLevel === 'h4' && <h4 class={headingClass}>{col.title}</h4>}
                  {headingLevel === 'h5' && <h5 class={headingClass}>{col.title}</h5>}
                  {headingLevel === 'h6' && <h6 class={headingClass}>{col.title}</h6>}
                </Fragment>
              )}
              <ModelViewer
                src={col.modelSrc}
                alt={col.alt}
                poster={col.poster}
                environmentImage={col.environmentImage}
                caption={col.caption}
                autoRotate={col.modelOptions?.autoRotate}
                cameraControls={col.modelOptions?.cameraControls}
                ar={col.modelOptions?.ar}
                exposureCompensation={col.modelOptions?.exposureCompensation}
                shadowIntensity={col.modelOptions?.shadowIntensity}
                shadowSoftness={col.modelOptions?.shadowSoftness}
                interactionPrompt={col.modelOptions?.interactionPrompt}
                loading={col.modelOptions?.loading}
                rotationPerSecond={col.modelOptions?.rotationPerSecond}
                autoRotateDelay={col.modelOptions?.autoRotateDelay}
                cameraOrbit={col.modelOptions?.cameraOrbit}
                mobileCameraOrbit={col.modelOptions?.mobileCameraOrbit}
                fieldOfView={col.modelOptions?.fieldOfView}
                minCameraOrbit={col.modelOptions?.minCameraOrbit}
                minFieldOfView={col.modelOptions?.minFieldOfView}
                maxFieldOfView={col.modelOptions?.maxFieldOfView}
                aspectRatio={col.modelOptions?.aspectRatio}
                mobileAspectRatio={col.modelOptions?.mobileAspectRatio}
                width={col.modelOptions?.width}
                height={col.modelOptions?.height}
                client:load
              />
            </>
          )}
          
          {col.type === 'gallery' && col.gallery && (
            <ProjectGallery
              images={col.gallery}
              autoplay={col.galleryOptions?.autoplay}
              autoplayInterval={col.galleryOptions?.autoplayInterval}
              showThumbnails={col.galleryOptions?.showThumbnails}
              client:load
            />
          )}
          
          {col.type === 'sections' && col.sections && (
            <div class={`nested-sections ${
              depth > 0 ? 'border-l-4 border-base-300/30 pl-6 ml-2 mt-4' : 'mt-6'
            }`}>
              <Astro.self 
                sections={col.sections} 
                depth={depth + 1} 
              />
            </div>
          )}
        </div>
        );
      })}
    </div>
    );
  })}
</div>

<style>
  /* Basic layout for sections */
  .section.lg\\:flex-row {
    align-items: flex-start;
  }
  
  /* Ensure all columns stay within bounds */
  .column {
    min-width: 0; /* Prevent overflow */
    overflow: hidden; /* Ensure content doesn't spill out */
  }
  
  /* Ensure galleries and models respect their column width */
  .column .project-gallery,
  .column .model-viewer-container {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  
  /* Support for arbitrary width values */
  .column[class*="lg:w-["] {
    flex-shrink: 0;
  }
</style>

<script>
  // Simple responsive layout for numeric model sections
  // The layout is handled by CSS classes, this just ensures proper initialization
  document.addEventListener('DOMContentLoaded', function() {
    // Force a layout recalculation to ensure responsive classes work correctly
    window.dispatchEvent(new Event('resize'));
  });
</script>