---
import { Image } from 'astro:assets';
import { marked } from 'marked';
import ProjectGallery from './ProjectGallery';
import ModelViewer from './ModelViewer';
import Summary from './Summary.astro';
import YouTube from './YouTube.astro';

const { columns } = Astro.props;

if (!columns || columns.length === 0) {
  throw new Error('ModularSection requires a columns prop with at least one column');
}
---

<style>
  /* Generic wrappers for column types */
  .gallery-col {
    width: 100%;
    padding: 0;
    margin: 0;
    display: block;
    position: relative;
  }

  /* Tidy ProjectGallery spacing within a gallery column */
  .gallery-col .project-gallery {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    font-size: initial !important;
    line-height: initial !important;
  }

  .gallery-col > :first-child {
    margin-top: 0 !important;
  }
  .gallery-col {
    line-height: 0;
    font-size: 0;
  }

  .info-col {
    width: 100%;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .info-col .summary-content {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  .info-col > :first-child {
    margin-top: 0 !important;
  }
  
  /* Ensure regular columns have proper styling for components */
  .column {
    display: block;
    line-height: initial;
    font-size: initial;
    min-width: 0; /* Prevent overflow */
  }

  /* Responsive columns using CSS Grid with dynamic custom properties */
  .responsive-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  @media (min-width: 1024px) {
    .responsive-columns {
      grid-template-columns: var(--col1-width, 1fr) var(--col2-width, 1fr);
    }
  }
  
  .responsive-columns .column {
    min-width: 0; /* Important for grid items to allow shrinking */
  }

  /* Model viewer specific constraints */
  .responsive-columns .column .model-viewer-container {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    min-width: 0 !important;
    overflow: hidden !important;
    display: block !important;
  }
  
  /* Ensure the actual model-viewer element respects constraints */
  .responsive-columns .column model-viewer {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    min-width: 0 !important;
    height: auto !important;
  }
  
  /* Ensure other components also respect constraints */
  .responsive-columns .column .project-gallery,
  .responsive-columns .column figure,
  .responsive-columns .column img {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  /* Additional constraint for direct model-viewer elements */
  .responsive-columns .column > model-viewer {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
  }
  
  /* Ensure ModelViewer components render cleanly within columns */
  .column model-viewer {
    line-height: initial !important;
    font-size: initial !important;
    display: block !important;
    min-height: 300px !important;
  }
  
  /* Ensure ModelViewer containers maintain proper dimensions */
  .column .model-viewer-container {
    line-height: initial !important;
    font-size: initial !important;
    display: block !important;
    width: 100% !important;
    min-height: 300px !important;
  }
  
  /* Ensure figure/image spacing is predictable */
  .column figure {
    margin: 0;
    padding: 0;
  }
  
  .column img {
    display: block;
  }

</style>

<!-- Additional CSS to ensure content stays within bounds (from working version) -->
<style>
  /* Basic layout for sections */
  .section.lg\\:flex-row {
    align-items: flex-start;
  }
  
  /* Ensure all columns stay within bounds without clipping */
  .column {
    min-width: 0; /* Prevent overflow */
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
  
  /* Ensure galleries and models respect their column width */
  .column .project-gallery,
  .column .model-viewer-container {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  
  /* Support for arbitrary width values */
  .column[class*="lg:w-["] {
    flex-shrink: 0;
  }
</style>

{(() => {
  // Calculate CSS custom properties for responsive CSS Grid
  const getGridStyles = (columns: any[]) => {
    if (columns.length !== 2) return {};
    
    const col1 = columns[0];
    const col2 = columns[1];
    
    let col1Width = 50; // Default
    
    // Check for explicit width on either column
    if (col1.width !== undefined) {
      col1Width = col1.width;
    } else if (col2.width !== undefined) {
      col1Width = 100 - col2.width;
    } else {
      // Check for layout options in gallery or other settings
      const layoutSource = (col1 && (col1.galleryOptions?.layout || col1.layout))
        || (col2 && (col2.galleryOptions?.layout || col2.layout));
      
      if (layoutSource) {
        // Handle ratio format: "55:45", "3:2", etc.
        if (typeof layoutSource === 'string' && layoutSource.includes(':')) {
          const [left, right] = layoutSource.split(':').map(Number);
          if (!isNaN(left) && !isNaN(right) && left > 0 && right > 0) {
            const total = left + right;
            col1Width = (left / total) * 100;
          }
        }
        
        // Handle percentage format: "60%"
        else if (typeof layoutSource === 'string' && layoutSource.endsWith('%')) {
          const percentage = parseFloat(layoutSource);
          if (!isNaN(percentage) && percentage > 0 && percentage < 100) {
            col1Width = percentage;
          }
        }
        
        // Handle named layouts
        else {
          const namedLayouts: { [key: string]: number } = {
            'narrow-wide': 33,
            'wide-narrow': 67,
            'equal': 50,
            'golden': 62, // Approximately golden ratio
            'sidebar': 75,
            'reverse-sidebar': 25,
          };
          
          if (namedLayouts[layoutSource]) {
            col1Width = namedLayouts[layoutSource];
          }
        }
      }
    }
    
    const col2Width = 100 - col1Width;
    
    return {
      '--col1-width': `${col1Width}fr`,
      '--col2-width': `${col2Width}fr`
    };
  };
  
  const gridStyles = getGridStyles(columns);
  
  return (
    <div class={`${
      columns.length <= 2 ? (columns.length === 2 ? 'responsive-columns' : 'flex flex-col lg:flex-row lg:items-start') :
      columns.length === 3 ? 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3' :
      columns.length === 4 ? 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4' :
      'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3' // Fallback for 5+ columns
    } gap-6 mb-8`}
         style={gridStyles}>
      {columns.map((column: any, columnIndex: number) => {
        // Determine column class based on layout type
        let columnClass;
        if (columns.length === 1) {
          columnClass = 'w-full';
        } else if (columns.length === 2) {
          // Grid column - let CSS Grid handle sizing
          columnClass = 'column';
        } else {
          columnClass = 'min-w-0'; // Grid handles sizing for 3+ columns
        }
        
        // Image props: prefer new schema (src/alt/caption), fallback to legacy (image/imageAlt/imageCaption)
        const imgSrc = column?.src || column?.image;
        const imgAlt = column?.alt || column?.imageAlt || `Image ${columnIndex + 1}`;
        const imgCaption = column?.caption || column?.imageCaption;
        // Gallery options: prefer nested galleryOptions, fallback to legacy top-level keys
        const gOpts = column?.galleryOptions || {};
        const galleryAutoplay = (gOpts.autoplay ?? column?.autoplay ?? (column?.gallery?.length > 1));
        const galleryInterval = (gOpts.autoplayInterval ?? column?.autoplayInterval ?? 5000);
        const galleryThumbs = (gOpts.showThumbnails ?? column?.showThumbnails ?? (column?.gallery?.length > 2));
        
        return (
          <div class={columnClass}>
            {column.type === 'content' && (
              <div class="prose prose-lg max-w-none">
                {column.title && (
                  <h2 class="text-2xl font-bold mb-4">{column.title}</h2>
                )}
                <div set:html={marked(column.content || '')} />
              </div>
            )}
            
            {column.type === 'image' && imgSrc && (
              <figure>
                <Image 
                  src={imgSrc}
                  alt={imgAlt}
                  width={600}
                  height={400}
                  class="w-full h-auto object-cover rounded-lg shadow"
                />
                {imgCaption && (
                  <figcaption class="mt-2 text-center text-base-content/60 text-sm" set:html={imgCaption}></figcaption>
                )}
              </figure>
            )}
            
    {column.type === 'gallery' && column.gallery && (
              <div class="gallery-col">
                <ProjectGallery 
                  images={column.gallery}
      autoplay={galleryAutoplay}
      autoplayInterval={galleryInterval}
      showThumbnails={galleryThumbs}
                  client:load
                />
              </div>
            )}
            
            {column.type === 'summary' && (
              <div class="info-col">
                <Summary 
                  title={column.summaryTitle || column.title}
                  description={column.summaryDescription || column.description}
                  startDate={column.startDate}
                  endDate={column.endDate}
                  status={column.status}
                  headerTitleSize={column.headerTitleSize}
                  metrics={column.metrics}
                  competitions={column.competitions}
                  competitionsOptions={column.competitionsOptions}
                  tags={column.tags || []}
                  githubUrl={column.githubUrl}
                  liveUrl={column.liveUrl}
                />
              </div>
            )}
            
            {column.type === 'model' && column.modelSrc && (
              <ModelViewer 
                src={column.modelSrc}
                alt={column.modelAlt || 'Interactive 3D model'}
                {...(column.modelOptions || {})}
                client:load
              />
            )}

            {column.type === 'video' && column.videoId && (
              <YouTube 
                id={column.videoId}
                title={column.videoTitle || column.title || 'Video'}
                aspect={column.videoAspect || '16:9'}
                start={column.videoStart}
                autoplay={column.videoAutoplay}
                muted={column.videoMuted}
                controls={column.videoControls}
                caption={column.videoCaption}
              />
            )}
          </div>
        );
      })}
    </div>
  );
})()}
