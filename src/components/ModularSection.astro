---
import { Image } from 'astro:assets';
import { marked } from 'marked';
import ProjectGallery from './ProjectGallery';
import ModelViewer from './ModelViewer';
import Summary from './Summary.astro';
import YouTube from './YouTube.astro';

const { columns } = Astro.props;

if (!columns || columns.length === 0) {
  throw new Error('ModularSection requires a columns prop with at least one column');
}

// Note: No special-case cover handling. All layouts use the same responsive system.

/**
 * Calculate responsive width percentages for two-column layouts (generic).
 * Returns numeric percentages [left, right] that the common flex calc will use.
 */
function getResponsiveTwoColPercents(options: any): { left: number; right: number } {
  if (!options?.layout) {
    return { left: 50, right: 50 }; // Default 50:50
  }

  const layout = options.layout;

  // Percentage format: "60%"
  if (typeof layout === 'string' && layout.endsWith('%')) {
    const percentage = parseFloat(layout);
    if (!isNaN(percentage) && percentage > 0 && percentage < 100) {
      return { left: percentage, right: 100 - percentage };
    }
  }

  // Ratio format: "55:45", "3:2", etc.
  if (typeof layout === 'string' && layout.includes(':')) {
    const [left, right] = layout.split(':').map(Number);
    if (!isNaN(left) && !isNaN(right) && left > 0 && right > 0) {
      const total = left + right;
      return { left: (left / total) * 100, right: (right / total) * 100 };
    }
  }

  // Named layouts
  const namedLayouts: { [key: string]: { left: number; right: number } } = {
    'narrow-wide': { left: 33.333, right: 66.667 },
    'wide-narrow': { left: 66.667, right: 33.333 },
    'equal': { left: 50, right: 50 },
    'golden': { left: 61.804, right: 38.196 },
    'sidebar': { left: 25, right: 75 },
    'reverse-sidebar': { left: 75, right: 25 },
  };

  if (namedLayouts[layout]) {
    return namedLayouts[layout];
  }

  // Fallback to 50:50
  return { left: 50, right: 50 };
}
---

<style>
  /* Generic wrappers for column types */
  .gallery-col {
    width: 100%;
    padding: 0;
    margin: 0;
    display: block;
    position: relative;
  }

  /* Tidy ProjectGallery spacing within a gallery column */
  .gallery-col .project-gallery {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    font-size: initial !important;
    line-height: initial !important;
  }

  .gallery-col > :first-child {
    margin-top: 0 !important;
  }
  .gallery-col {
    line-height: 0;
    font-size: 0;
  }

  .info-col {
    width: 100%;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .info-col .summary-content {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  .info-col > :first-child {
    margin-top: 0 !important;
  }
  
  /* Ensure regular columns have proper styling for components */
  .column {
    display: block;
    line-height: initial;
    font-size: initial;
  }
  
  /* Ensure ModelViewer components render cleanly within columns */
  .column model-viewer {
    line-height: initial !important;
    font-size: initial !important;
    display: block !important;
    min-height: 300px !important;
  }
  
  /* Ensure ModelViewer containers maintain proper dimensions */
  .column .model-viewer-container {
    line-height: initial !important;
    font-size: initial !important;
    display: block !important;
    width: 100% !important;
    min-height: 300px !important;
  }
  
  /* Ensure figure/image spacing is predictable */
  .column figure {
    margin: 0;
    padding: 0;
  }
  
  .column img {
    display: block;
  }

</style>

{(() => {
  // Common responsive layout for all combinations
  const columnCount = columns.length;
  const gap = '2rem'; // Match gap-8 (32px)
  
  // Calculate column widths based on custom widths or equal distribution
  const columnWidths = (() => {
    // Check if any columns have custom widths
    const customWidthColumns = columns.filter((col: any) => col.width !== undefined);
    
    if (customWidthColumns.length === 0) {
      // If no explicit widths but two columns with a layout string, use the generic two-col parser
      if (columnCount === 2) {
        // Try to discover a layout string from any column's known options
        const layoutSource = (columns[0] && (columns[0].galleryOptions?.layout || columns[0].layout))
          || (columns[1] && (columns[1].galleryOptions?.layout || columns[1].layout));
        if (layoutSource) {
          const { left, right } = getResponsiveTwoColPercents({ layout: layoutSource });
          return [left, right];
        }
      }
      // No custom widths, distribute equally
      return columns.map(() => 100 / columnCount);
    }
    
    if (customWidthColumns.length === columns.length) {
      // All columns have custom widths - calculate proportionally
      const widthValues = columns.map((col: any) => col.width);
      const totalWidth = widthValues.reduce((sum: number, width: number) => sum + width, 0);
      
      // Convert to percentages based on proportional relationship
      return widthValues.map((width: number) => (width / totalWidth) * 100);
    }
    
    // Mixed case: some have custom widths, some don't
    // This is more complex - for now, treat unspecified as equal distribution of remaining space
    const specifiedWidths = customWidthColumns.map((col: any) => col.width);
    const totalSpecified = specifiedWidths.reduce((sum: number, width: number) => sum + width, 0);
    const unspecifiedCount = columns.length - customWidthColumns.length;
    
    // Assume specified widths are proportional parts, calculate what percentage they represent
    const totalProportionalUnits = totalSpecified + unspecifiedCount; // Assume unspecified columns get 1 unit each
    
    return columns.map((col: any) => {
      if (col.width !== undefined) {
        return (col.width / totalProportionalUnits) * 100;
      } else {
        return (1 / totalProportionalUnits) * 100; // 1 unit for unspecified columns
      }
    });
  })();
  
  return (
    <div class="flex flex-col md:flex-row gap-8 mb-8 items-start">
      {columns.map((column: any, columnIndex: number) => {
  const width = columnWidths[columnIndex];
  // Image props: prefer new schema (src/alt/caption), fallback to legacy (image/imageAlt/imageCaption)
  const imgSrc = column?.src || column?.image;
  const imgAlt = column?.alt || column?.imageAlt || `Image ${columnIndex + 1}`;
  const imgCaption = column?.caption || column?.imageCaption;
  // Gallery options: prefer nested galleryOptions, fallback to legacy top-level keys
  const gOpts = column?.galleryOptions || {};
  const galleryAutoplay = (gOpts.autoplay ?? column?.autoplay ?? (column?.gallery?.length > 1));
  const galleryInterval = (gOpts.autoplayInterval ?? column?.autoplayInterval ?? 5000);
  const galleryThumbs = (gOpts.showThumbnails ?? column?.showThumbnails ?? (column?.gallery?.length > 2));
        return (
          <div 
            class="column" 
            style={`flex: 0 0 calc(${width}% - ${gap} * ${(100 - width) / 100}); max-width: calc(${width}% - ${gap} * ${(100 - width) / 100});`}
          >
            {column.type === 'content' && (
              <div class="prose prose-lg max-w-none">
                {column.title && (
                  <h2 class="text-2xl font-bold mb-4">{column.title}</h2>
                )}
                <div set:html={marked(column.content || '')} />
              </div>
            )}
            
            {column.type === 'image' && imgSrc && (
              <figure>
                <Image 
                  src={imgSrc}
                  alt={imgAlt}
                  width={600}
                  height={400}
                  class="w-full h-auto object-cover rounded-lg shadow"
                />
                {imgCaption && (
                  <figcaption class="mt-2 text-center text-base-content/60 text-sm" set:html={imgCaption}></figcaption>
                )}
              </figure>
            )}
            
    {column.type === 'gallery' && column.gallery && (
              <div class="gallery-col">
                <ProjectGallery 
                  images={column.gallery}
      autoplay={galleryAutoplay}
      autoplayInterval={galleryInterval}
      showThumbnails={galleryThumbs}
                  client:load
                />
              </div>
            )}
            
            {column.type === 'summary' && (
              <div class="info-col">
                <Summary 
                  title={column.summaryTitle || column.title}
                  description={column.summaryDescription || column.description}
                  startDate={column.startDate}
                  endDate={column.endDate}
                  status={column.status}
                  headerTitleSize={column.headerTitleSize}
                  metrics={column.metrics}
                  competitions={column.competitions}
                  competitionsOptions={column.competitionsOptions}
                  tags={column.tags || []}
                  githubUrl={column.githubUrl}
                  liveUrl={column.liveUrl}
                />
              </div>
            )}
            
            {column.type === 'model' && column.modelSrc && (
              <ModelViewer 
                src={column.modelSrc}
                alt={column.modelAlt || 'Interactive 3D model'}
                {...(column.modelOptions || {})}
                client:load
              />
            )}

            {column.type === 'video' && column.videoId && (
              <YouTube 
                id={column.videoId}
                title={column.videoTitle || column.title || 'Video'}
                aspect={column.videoAspect || '16:9'}
                start={column.videoStart}
                autoplay={column.videoAutoplay}
                muted={column.videoMuted}
                controls={column.videoControls}
                caption={column.videoCaption}
              />
            )}
          </div>
        );
      })}
    </div>
  );
})()}
