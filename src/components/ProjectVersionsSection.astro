---
import { getProjectVersions, hasMultipleVersions } from '../utils/versionUtils';

interface Props {
  projectSlug?: string;
  className?: string;
  sectionTitle?: string;
  showTitle?: boolean;
  titleDepth?: number; // 0-4 like ModularSection (0=h2/text-3xl, 1=h3/text-2xl, etc.)
  titleSpacing?: string; // Spacing between title and tabs
  contentSpacing?: string; // Spacing between tabs and content
  // Tab styling
  tabSize?: 'sm' | 'md' | 'lg' | 'xl';
  tabStyle?: 'boxed' | 'bordered' | 'lifted';
  // Custom overrides (use these sparingly)
  tabWidth?: string;
  tabHeight?: string;
  tabPadding?: string;
  fontSize?: string;
}

const { 
  projectSlug: providedSlug, 
  className = '', 
  sectionTitle = 'Evolution Timeline',
  showTitle = true,
  titleDepth = 1,
  titleSpacing = '1.5rem',
  contentSpacing = '2rem',
  tabSize = 'lg',
  tabStyle = 'boxed',
  tabWidth,
  tabHeight,
  tabPadding,
  fontSize
} = Astro.props;

// Auto-detect project slug from file path if not provided
let projectSlug = providedSlug;
if (!projectSlug) {
  // Get the current file's URL path and extract project slug
  const urlParts = Astro.url.pathname.split('/');
  const projectIndex = urlParts.indexOf('projects');
  if (projectIndex !== -1 && urlParts[projectIndex + 1]) {
    projectSlug = urlParts[projectIndex + 1];
  } else {
    // Fallback: try to get from request URL or throw error
    throw new Error('ProjectVersionsSection: Unable to auto-detect project slug. Please provide projectSlug prop.');
  }
}

// Get versions and check if multiple exist
let versions: Array<{
  version: string;
  title: string;
  tabTitle: string;
  data: any;
  Content: any;
}> = [];
try {
  if (await hasMultipleVersions(projectSlug)) {
    const projectVersions = await getProjectVersions(projectSlug);
    // Create array with version content rendered
    versions = await Promise.all(
      projectVersions.map(async (version) => {
        const { Content } = await version.content.render();
        return {
          version: version.content.data.version || version.version,
          title: version.content.data.title,
          tabTitle: version.content.data.tabTitle || version.content.data.version || version.version,
          data: version.content.data, // Include the frontmatter data
          Content
        };
      })
    );
  }
} catch (error) {
  console.error('ProjectVersionsSection: Error:', error);
}

// Title formatting functions matching ModularSection approach
const getHeadingLevel = (depth: number) => {
  if (depth === 0) return 'h2';
  if (depth === 1) return 'h3'; 
  if (depth === 2) return 'h4';
  if (depth === 3) return 'h5';
  return 'h6';
};

const getHeadingClass = (depth: number) => {
  // Base classes without margin-bottom since we'll use custom spacing
  if (depth === 0) return 'text-3xl font-bold';
  if (depth === 1) return 'text-2xl font-bold';
  if (depth === 2) return 'text-xl font-bold';
  if (depth === 3) return 'text-lg font-bold';
  return 'text-base font-bold';
};

const headingLevel = getHeadingLevel(titleDepth);
const headingClass = getHeadingClass(titleDepth);
---

<style>
  .version-tabs {
    display: block;
  }
  
  /* Hidden radio inputs for state management */
  .version-tabs input[type="radio"] {
    display: none;
  }
  
  /* Base tab button styling */
  .version-tabs .tab-buttons {
    display: flex;
    gap: 0.5rem;
    border-radius: 0.75rem;
    padding: 0.5rem;
  }

  /* Default boxed style */
  .version-tabs.style-boxed .tab-buttons {
    background-color: hsl(var(--b2));
    border: none;
  }

  /* Bordered style - clean outline look using theme-appropriate primary colors */
  .version-tabs.style-bordered .tab-buttons {
    background: transparent;
    border: 2px solid #0082ce; /* Light mode primary */
    padding: 0.75rem;
  }

  /* Dark mode bordered style - try multiple selectors */
  [data-theme="business"] .version-tabs.style-bordered .tab-buttons,
  html[data-theme="business"] .version-tabs.style-bordered .tab-buttons,
  :root[data-theme="business"] .version-tabs.style-bordered .tab-buttons {
    border: 2px solid #1c4e7f !important; /* Dark mode primary */
  }

  /* Lifted style - elevated with shadow and background */
  .version-tabs.style-lifted .tab-buttons {
    background: hsl(var(--b1));
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.1), 
                0 2px 6px -1px rgba(0, 0, 0, 0.05);
    border: 1px solid #0082ce; /* Light mode primary */
    border-radius: 1rem;
  }

  /* Dark mode lifted style - try multiple selectors */
  [data-theme="business"] .version-tabs.style-lifted .tab-buttons,
  html[data-theme="business"] .version-tabs.style-lifted .tab-buttons,
  :root[data-theme="business"] .version-tabs.style-lifted .tab-buttons {
    border: 1px solid #1c4e7f !important; /* Dark mode primary */
  }

  .version-tabs .tab-buttons .tab-button {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 0.5rem;
    transition: all 0.25s cubic-bezier(0.4, 0.0, 0.2, 1);
    font-weight: 500;
    border: 2px solid transparent;
    white-space: nowrap;
  }

  /* Size variants */
  .version-tabs.size-sm .tab-buttons .tab-button { 
    font-size: 0.875rem; 
    padding: 0.5rem 1rem; 
  }
  .version-tabs.size-md .tab-buttons .tab-button { 
    font-size: 1rem; 
    padding: 0.75rem 1.25rem; 
  }
  .version-tabs.size-lg .tab-buttons .tab-button { 
    font-size: 1.125rem; 
    padding: 1rem 1.5rem; 
  }
  .version-tabs.size-xl .tab-buttons .tab-button { 
    font-size: 1.25rem; 
    padding: 1.25rem 2rem; 
  }

  /* Custom dimensions support - overrides size variants */
  .version-tabs.custom-dimensions .tab-buttons .tab-button {
    font-size: var(--tab-font-size, 1.125rem);
    width: var(--tab-width, auto);
    height: var(--tab-height, auto);
    padding: var(--tab-padding, 1rem 1.5rem);
    min-width: var(--tab-width, auto);
    min-height: var(--tab-height, auto);
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .version-tabs .tab-buttons {
      gap: 0.25rem;
      padding: 0.375rem;
      flex-wrap: wrap;
    }
    
    /* Smaller default sizes on mobile */
    .version-tabs.size-sm .tab-buttons .tab-button { 
      font-size: 0.75rem; 
      padding: 0.375rem 0.75rem; 
    }
    .version-tabs.size-md .tab-buttons .tab-button { 
      font-size: 0.875rem; 
      padding: 0.5rem 1rem; 
    }
    .version-tabs.size-lg .tab-buttons .tab-button { 
      font-size: 1rem; 
      padding: 0.75rem 1.25rem; 
    }
    .version-tabs.size-xl .tab-buttons .tab-button { 
      font-size: 1.125rem; 
      padding: 1rem 1.5rem; 
    }

    /* Mobile custom dimensions - scale down if too large */
    .version-tabs.custom-dimensions .tab-buttons .tab-button {
      font-size: min(var(--tab-font-size, 1rem), 1rem);
      width: var(--tab-width, auto);
      height: var(--tab-height, auto);
      max-width: calc(50vw - 1rem); /* Prevent tabs from being too wide on mobile */
      padding: var(--tab-padding, 0.75rem 1rem);
    }
  }

  /* Extra small mobile devices */
  @media (max-width: 480px) {
    .version-tabs .tab-buttons {
      gap: 0.125rem;
      padding: 0.25rem;
    }
    
    .version-tabs.custom-dimensions .tab-buttons .tab-button {
      font-size: min(var(--tab-font-size, 0.875rem), 0.875rem);
      max-width: calc(45vw - 0.5rem);
      padding: var(--tab-padding, 0.5rem 0.75rem);
    }
  }

  /* Active tab styling using radio button state */
  .version-tabs input[type="radio"]:nth-of-type(1):checked ~ .tab-buttons .tab-button:nth-of-type(1),
  .version-tabs input[type="radio"]:nth-of-type(2):checked ~ .tab-buttons .tab-button:nth-of-type(2),
  .version-tabs input[type="radio"]:nth-of-type(3):checked ~ .tab-buttons .tab-button:nth-of-type(3),
  .version-tabs input[type="radio"]:nth-of-type(4):checked ~ .tab-buttons .tab-button:nth-of-type(4),
  .version-tabs input[type="radio"]:nth-of-type(5):checked ~ .tab-buttons .tab-button:nth-of-type(5) {
    background-color: #0082ce; /* Light mode primary */
    color: white;
    border: 2px solid #0082ce;
    font-weight: 600;
  }

  /* Dark mode active tabs - try multiple selectors */
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(1):checked ~ .tab-buttons .tab-button:nth-of-type(1),
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(2):checked ~ .tab-buttons .tab-button:nth-of-type(2),
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(3):checked ~ .tab-buttons .tab-button:nth-of-type(3),
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(4):checked ~ .tab-buttons .tab-button:nth-of-type(4),
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(5):checked ~ .tab-buttons .tab-button:nth-of-type(5),
  html[data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(1):checked ~ .tab-buttons .tab-button:nth-of-type(1),
  html[data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(2):checked ~ .tab-buttons .tab-button:nth-of-type(2),
  html[data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(3):checked ~ .tab-buttons .tab-button:nth-of-type(3),
  html[data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(4):checked ~ .tab-buttons .tab-button:nth-of-type(4),
  html[data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(5):checked ~ .tab-buttons .tab-button:nth-of-type(5),
  :root[data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(1):checked ~ .tab-buttons .tab-button:nth-of-type(1),
  :root[data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(2):checked ~ .tab-buttons .tab-button:nth-of-type(2),
  :root[data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(3):checked ~ .tab-buttons .tab-button:nth-of-type(3),
  :root[data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(4):checked ~ .tab-buttons .tab-button:nth-of-type(4),
  :root[data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(5):checked ~ .tab-buttons .tab-button:nth-of-type(5) {
    background-color: #1c4e7f !important; /* Dark mode primary */
    color: white !important;
    border: 2px solid #1c4e7f !important;
  }

  /* Hover effects */
  .version-tabs .tab-buttons .tab-button:hover {
    background-color: rgba(0, 130, 206, 0.1);
    border-color: rgba(0, 130, 206, 0.3);
  }

  [data-theme="business"] .version-tabs .tab-buttons .tab-button:hover,
  html[data-theme="business"] .version-tabs .tab-buttons .tab-button:hover,
  :root[data-theme="business"] .version-tabs .tab-buttons .tab-button:hover {
    background-color: rgba(28, 78, 127, 0.1) !important;
    border-color: rgba(28, 78, 127, 0.3) !important;
  }

  /* Tab content styling */
  .version-tabs .tab-contents {
    margin-top: var(--content-spacing, 2rem);
  }

  .version-tabs .tab-content {
    display: none;
    animation: fadeIn 0.3s ease-in-out;
  }

  /* Show content based on radio state */
  .version-tabs input[type="radio"]:nth-of-type(1):checked ~ .tab-contents .tab-content:nth-of-type(1),
  .version-tabs input[type="radio"]:nth-of-type(2):checked ~ .tab-contents .tab-content:nth-of-type(2),
  .version-tabs input[type="radio"]:nth-of-type(3):checked ~ .tab-contents .tab-content:nth-of-type(3),
  .version-tabs input[type="radio"]:nth-of-type(4):checked ~ .tab-contents .tab-content:nth-of-type(4),
  .version-tabs input[type="radio"]:nth-of-type(5):checked ~ .tab-contents .tab-content:nth-of-type(5) {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Custom dimensions support - overrides size variants */
  .version-tabs.custom-dimensions .tab-buttons .tab-button {
    font-size: var(--tab-font-size, 1.125rem);
    width: var(--tab-width, auto);
    height: var(--tab-height, auto);
    padding: var(--tab-padding, 1rem 1.5rem);
    min-width: var(--tab-width, auto);
    min-height: var(--tab-height, auto);
  }
</style>

{versions.length > 0 && (
  <section class={`project-versions ${className}`}>
    <div 
      class={`version-tabs size-${tabSize} style-${tabStyle} ${(tabWidth || tabHeight || tabPadding || fontSize) ? 'custom-dimensions' : ''}`}
      style={{
        ...(tabWidth && { '--tab-width': tabWidth }),
        ...(tabHeight && { '--tab-height': tabHeight }),
        ...(tabPadding && { '--tab-padding': tabPadding }),
        ...(fontSize && { '--tab-font-size': fontSize }),
        '--content-spacing': contentSpacing
      }}
    >
      {/* Optional Section Title */}
      {showTitle && sectionTitle && (
        <div style={`margin-bottom: ${titleSpacing};`}>
          {headingLevel === 'h2' && <h2 class={headingClass} set:html={sectionTitle} />}
          {headingLevel === 'h3' && <h3 class={headingClass} set:html={sectionTitle} />}
          {headingLevel === 'h4' && <h4 class={headingClass} set:html={sectionTitle} />}
          {headingLevel === 'h5' && <h5 class={headingClass} set:html={sectionTitle} />}
          {headingLevel === 'h6' && <h6 class={headingClass} set:html={sectionTitle} />}
        </div>
      )}

      <!-- Radio inputs for state management -->
      {versions.map((version, index) => (
        <input 
          type="radio" 
          name="version_tabs" 
          id={`tab-${index}`}
          checked={index === 0}
        />
      ))}

      <!-- Tab buttons -->
      <div class="tab-buttons">
        {versions.map((version, index) => (
          <label 
            for={`tab-${index}`}
            class="tab-button"
          >
            <span class="font-semibold">{version.tabTitle}</span>
          </label>
        ))}
      </div>

      <!-- Tab content sections -->
      <div class="tab-contents">
        {versions.map((version, index) => (
          <div class="tab-content">
            <div class="prose prose-lg max-w-none dark:prose-invert">
              <version.Content />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
