---
import { getProjectVersions, hasMultipleVersions } from '../utils/versionUtils';
import { getSortableDate } from '../utils/dateUtils';
import { render } from 'astro:content';

interface Props {
  projectSlug?: string;
  className?: string;
  sectionTitle?: string;
  showTitle?: boolean;
  titleDepth?: number; // 0-4 like ModularSection (0=h2/text-3xl, 1=h3/text-2xl, etc.)
  titleSpacing?: string; // Spacing between title and tabs
  contentSpacing?: string; // Spacing between tabs and content
  // Tab styling
  tabSize?: 'sm' | 'md' | 'lg' | 'xl';
  tabStyle?: 'boxed' | 'bordered' | 'lifted';
  // Custom overrides (use these sparingly)
  tabWidth?: string;
  tabHeight?: string;
  tabPadding?: string;
  fontSize?: string;
  // Default tab selection: can be a version name (string like "v2") or index (number)
  defaultTab?: string | number;
}

const { 
  projectSlug: providedSlug, 
  className = '', 
  sectionTitle = 'Evolution Timeline',
  showTitle = true,
  titleDepth = 1,
  titleSpacing = '1.5rem',
  contentSpacing = '2rem',
  tabSize = 'lg',
  tabStyle = 'boxed',
  tabWidth,
  tabHeight,
  tabPadding,
  fontSize,
  defaultTab = 0
} = Astro.props;

// Auto-detect project slug from file path if not provided
let projectSlug = providedSlug;
if (!projectSlug) {
  // Get the current file's URL path and extract project slug
  const urlParts = Astro.url.pathname.split('/');
  const projectIndex = urlParts.indexOf('projects');
  if (projectIndex !== -1 && urlParts[projectIndex + 1]) {
    projectSlug = urlParts[projectIndex + 1];
  } else {
    // Fallback: try to get from request URL or throw error
    throw new Error('ProjectVersionsSection: Unable to auto-detect project slug. Please provide projectSlug prop.');
  }
}

// Get versions and check if multiple exist
let versions: Array<{
  tabTitle: string;
  data: any;
  Content: any;
}> = [];
try {
  if (await hasMultipleVersions(projectSlug)) {
    const projectVersions = await getProjectVersions(projectSlug);
    // Create array with version content rendered
    versions = await Promise.all(
      projectVersions.map(async (v) => {
        const { Content } = await render(v.content);
        const fm = v.content.data;
        return {
          tabTitle: fm.tabTitle ?? 'Version',
          data: fm,
          Content
        };
      })
    );

    // Sort by semantic version in tabTitle (desc) when available; otherwise by most recent date; then stable index
    versions = versions
      .map((v, idx) => ({
        ...v,
        __i: idx,
        __d: (v.data && (v.data.endDate || v.data.startDate)) || null,
        __ver: parseVersionFromTitle(v.tabTitle)
      }))
      .sort((a, b) => {
        const av = a.__ver;
        const bv = b.__ver;
        if (av && bv) {
          const cmp = compareSemverDesc(av, bv);
          if (cmp !== 0) return cmp;
        } else if (av && !bv) {
          return -1; // items with versions come first
        } else if (!av && bv) {
          return 1;
        }
        if (a.__d && b.__d) {
          return getSortableDate(b.__d as any).getTime() - getSortableDate(a.__d as any).getTime();
        }
        if (a.__d && !b.__d) return -1;
        if (!a.__d && b.__d) return 1;
        return a.__i - b.__i;
      })
      .map(({ __i, __d, __ver, ...rest }) => rest);
  }
} catch (error) {
  console.error('ProjectVersionsSection: Error:', error);
}

// Determine which tab should be selected by default
let activeTabIndex = 0; // fallback to first tab
if (defaultTab !== undefined) {
  if (typeof defaultTab === 'number') {
    // Direct index provided
    activeTabIndex = Math.max(0, Math.min(defaultTab, versions.length - 1));
  } else if (typeof defaultTab === 'string') {
    // Version name provided - find matching tab
    const found = versions.findIndex(v => 
      v.tabTitle.toLowerCase() === defaultTab.toLowerCase() ||
      v.tabTitle.toLowerCase().includes(defaultTab.toLowerCase())
    );
    activeTabIndex = found >= 0 ? found : 0;
  }
}

// Pairing radio N with tab button N and pane N takes one selector per version,
// so those rules are generated instead of hand-written. The hand-written block
// this replaces stopped at :nth-of-type(5), so a sixth version rendered a tab
// that never highlighted and a pane that never appeared, with nothing to say why.
//
// Everything here is keyed to a per-instance id. `is:inline` keeps Astro from
// hoisting and scoping the tag (it cannot scope markup it never parses), so the
// id is what stops these rules from leaking to other tab groups on the page.
const tabsId = `version-tabs-${projectSlug.replace(/[^a-zA-Z0-9_-]/g, '-')}`;

const pairRules = (themePrefix: string, container: string, child: string) =>
  versions
    .map(
      (_, i) =>
        `${themePrefix}#${tabsId} input[type="radio"]:nth-of-type(${i + 1}):checked ~ ${container} ${child}:nth-of-type(${i + 1})`,
    )
    .join(',');

// The dark rules carry an extra attribute selector, so they outrank the light
// ones on specificity alone — no !important needed to make the theme swap take.
const tabStateCss = versions.length === 0 ? '' : [
  `${pairRules('', '.tab-buttons', '.tab-button')}{background-color:#0082ce;color:#fff;border:2px solid #0082ce;font-weight:600}`,
  `${pairRules('[data-theme="business"] ', '.tab-buttons', '.tab-button')}{background-color:#1c4e7f;color:#fff;border:2px solid #1c4e7f}`,
  `${pairRules('', '.tab-contents', '.tab-content')}{display:block}`,
].join('\n');

// Title formatting functions matching ModularSection approach
const getHeadingLevel = (depth: number) => {
  if (depth === 0) return 'h2';
  if (depth === 1) return 'h3'; 
  if (depth === 2) return 'h4';
  if (depth === 3) return 'h5';
  return 'h6';
};

const getHeadingClass = (depth: number) => {
  // Base classes without margin-bottom since we'll use custom spacing
  if (depth === 0) return 'text-3xl font-bold';
  if (depth === 1) return 'text-2xl font-bold';
  if (depth === 2) return 'text-xl font-bold';
  if (depth === 3) return 'text-lg font-bold';
  return 'text-base font-bold';
};

const headingLevel = getHeadingLevel(titleDepth);
const headingClass = getHeadingClass(titleDepth);

// Version parsing helpers for semver-like titles (v1, v2.1, v1.3.1, Version 2.0, 2.0.1)
function parseVersionFromTitle(title: string): number[] | null {
  if (!title) return null;
  const t = String(title).trim();
  // Prefer a leading v/Version prefix; otherwise first numeric dot sequence
  let m = t.match(/^(?:v|version)\s*([0-9]+(?:\.[0-9]+)*)\b/i) || t.match(/([0-9]+(?:\.[0-9]+)*)/);
  if (!m) return null;
  const parts = m[1].split('.').map((n) => {
    const num = parseInt(n, 10);
    return Number.isFinite(num) ? num : 0;
  });
  // Trim trailing zeros for stable comparisons
  for (let i = parts.length - 1; i > 0; i--) {
    if (parts[i] === 0) parts.pop();
    else break;
  }
  return parts.length ? parts : [0];
}

function compareSemverDesc(a: number[], b: number[]): number {
  const len = Math.max(a.length, b.length);
  for (let i = 0; i < len; i++) {
    const ai = a[i] ?? 0;
    const bi = b[i] ?? 0;
    if (ai !== bi) return bi - ai; // descending
  }
  return 0;
}
---

<style>
  .version-tabs {
    display: block;
  }
  
  /* Hidden radio inputs for state management */
  .version-tabs input[type="radio"] {
    display: none;
  }
  
  /* Base tab button styling */
  .version-tabs .tab-buttons {
    display: flex;
    gap: 0.5rem;
    border-radius: 0.75rem;
    padding: 0.5rem;
  }

  /* Default boxed style */
  .version-tabs.style-boxed .tab-buttons {
    background-color: hsl(var(--b2));
    border: none;
  }

  /* Bordered style - clean outline look using theme-appropriate primary colors */
  .version-tabs.style-bordered .tab-buttons {
    background: transparent;
    border: 2px solid #0082ce; /* Light mode primary */
    padding: 0.75rem;
  }

  /* Dark mode bordered style - try multiple selectors */
  [data-theme="business"] .version-tabs.style-bordered .tab-buttons,
  html[data-theme="business"] .version-tabs.style-bordered .tab-buttons,
  :root[data-theme="business"] .version-tabs.style-bordered .tab-buttons {
    border: 2px solid #1c4e7f !important; /* Dark mode primary */
  }

  /* Lifted style - elevated with shadow and background */
  .version-tabs.style-lifted .tab-buttons {
    background: hsl(var(--b1));
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.1), 
                0 2px 6px -1px rgba(0, 0, 0, 0.05);
    border: 1px solid #0082ce; /* Light mode primary */
    border-radius: 1rem;
  }

  /* Dark mode lifted style - try multiple selectors */
  [data-theme="business"] .version-tabs.style-lifted .tab-buttons,
  html[data-theme="business"] .version-tabs.style-lifted .tab-buttons,
  :root[data-theme="business"] .version-tabs.style-lifted .tab-buttons {
    border: 1px solid #1c4e7f !important; /* Dark mode primary */
  }

  .version-tabs .tab-buttons .tab-button {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 0.5rem;
    transition: all 0.25s cubic-bezier(0.4, 0.0, 0.2, 1);
    font-weight: 500;
    border: 2px solid transparent;
    white-space: nowrap;
  }

  /* Size variants */
  .version-tabs.size-sm .tab-buttons .tab-button { 
    font-size: 0.875rem; 
    padding: 0.5rem 1rem; 
  }
  .version-tabs.size-md .tab-buttons .tab-button { 
    font-size: 1rem; 
    padding: 0.75rem 1.25rem; 
  }
  .version-tabs.size-lg .tab-buttons .tab-button { 
    font-size: 1.125rem; 
    padding: 1rem 1.5rem; 
  }
  .version-tabs.size-xl .tab-buttons .tab-button { 
    font-size: 1.25rem; 
    padding: 1.25rem 2rem; 
  }

  /* Custom dimensions support - overrides size variants */
  .version-tabs.custom-dimensions .tab-buttons .tab-button {
    font-size: var(--tab-font-size, 1.125rem);
    width: var(--tab-width, auto);
    height: var(--tab-height, auto);
    padding: var(--tab-padding, 1rem 1.5rem);
    min-width: var(--tab-width, auto);
    min-height: var(--tab-height, auto);
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .version-tabs .tab-buttons {
      gap: 0.25rem;
      padding: 0.375rem;
      display: flex; /* Keep horizontal layout */
    }
    
    .version-tabs .tab-buttons .tab-button {
      flex: 1; /* Equal width buttons that fill available space */
      min-width: 0; /* Allow buttons to shrink below content width */
      justify-content: center;
    }
    
    /* Smaller default sizes on mobile */
    .version-tabs.size-sm .tab-buttons .tab-button { 
      font-size: 0.75rem; 
      padding: 0.375rem 0.75rem; 
    }
    .version-tabs.size-md .tab-buttons .tab-button { 
      font-size: 0.875rem; 
      padding: 0.5rem 1rem; 
    }
    .version-tabs.size-lg .tab-buttons .tab-button { 
      font-size: 1rem; 
      padding: 0.75rem 1.25rem; 
    }
    .version-tabs.size-xl .tab-buttons .tab-button { 
      font-size: 1.125rem; 
      padding: 1rem 1.5rem; 
    }

    /* Mobile custom dimensions - flexible width with controlled height */
    .version-tabs.custom-dimensions .tab-buttons .tab-button {
      font-size: min(var(--tab-font-size, 1rem), 1rem);
      flex: 1; /* Use flex instead of fixed width */
      height: var(--tab-height, auto);
      padding: var(--tab-padding, 0.75rem 1rem);
      min-width: 0; /* Allow shrinking */
    }
  }

  /* Extra small mobile devices */
  @media (max-width: 480px) {
    .version-tabs .tab-buttons {
      gap: 0.125rem;
      padding: 0.25rem;
      display: flex; /* Keep horizontal layout for very small screens too */
    }
    
    .version-tabs .tab-buttons .tab-button {
      flex: 1; /* Equal width distribution */
      min-width: 0; /* Allow buttons to shrink */
    }
    
    .version-tabs.custom-dimensions .tab-buttons .tab-button {
      font-size: min(var(--tab-font-size, 0.875rem), 0.875rem);
      flex: 1; /* Use flex instead of fixed width */
      padding: var(--tab-padding, 0.5rem 0.75rem);
      min-width: 0; /* Allow shrinking below content */
    }
  }

  /* Active tab and active pane styling is generated per version — see the
     tabStateCss block in the frontmatter. It cannot live here because each
     version needs its own :nth-of-type pair and the count is not known until
     the versions are loaded. */

  /* Hover effects. Gated on a real hovering pointer: on touch devices the
     :hover state sticks to the last-tapped element, so an ungated rule left the
     tab you just selected wearing the faint hover fill instead of the solid
     active fill. The business rules also drop !important for the same reason —
     with it, hover outranked the generated active-tab rule. */
  @media (hover: hover) and (pointer: fine) {
    .version-tabs .tab-buttons .tab-button:hover {
      background-color: rgba(0, 130, 206, 0.1);
      border-color: rgba(0, 130, 206, 0.3);
    }

    [data-theme="business"] .version-tabs .tab-buttons .tab-button:hover,
    html[data-theme="business"] .version-tabs .tab-buttons .tab-button:hover,
    :root[data-theme="business"] .version-tabs .tab-buttons .tab-button:hover {
      background-color: rgba(28, 78, 127, 0.1);
      border-color: rgba(28, 78, 127, 0.3);
    }
  }

  /* Tab content styling */
  .version-tabs .tab-contents {
    margin-top: var(--content-spacing, 2rem);
  }

  .version-tabs .tab-content {
    display: none;
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

</style>

{versions.length > 0 && (
  <section class={`project-versions ${className}`}>
    <style is:inline set:html={tabStateCss}></style>
    <div
      id={tabsId}
      class={`version-tabs size-${tabSize} style-${tabStyle} ${(tabWidth || tabHeight || tabPadding || fontSize) ? 'custom-dimensions' : ''}`}
      style={{
        ...(tabWidth && { '--tab-width': tabWidth }),
        ...(tabHeight && { '--tab-height': tabHeight }),
        ...(tabPadding && { '--tab-padding': tabPadding }),
        ...(fontSize && { '--tab-font-size': fontSize }),
        '--content-spacing': contentSpacing
      }}
    >
      {/* Optional Section Title */}
      {showTitle && sectionTitle && (
        <div style={`margin-bottom: ${titleSpacing};`}>
          {headingLevel === 'h2' && <h2 class={headingClass} set:html={sectionTitle} />}
          {headingLevel === 'h3' && <h3 class={headingClass} set:html={sectionTitle} />}
          {headingLevel === 'h4' && <h4 class={headingClass} set:html={sectionTitle} />}
          {headingLevel === 'h5' && <h5 class={headingClass} set:html={sectionTitle} />}
          {headingLevel === 'h6' && <h6 class={headingClass} set:html={sectionTitle} />}
        </div>
      )}

      <!-- Radio inputs for state management -->
      {versions.map((version, index) => (
        <input
          type="radio"
          name={tabsId}
          id={`${tabsId}-tab-${index}`}
          checked={index === activeTabIndex}
        />
      ))}

      <!-- Tab buttons -->
      <div class="tab-buttons">
        {versions.map((version, index) => (
          <label
            for={`${tabsId}-tab-${index}`}
            class="tab-button"
          >
            <span class="font-semibold">{version.tabTitle}</span>
          </label>
        ))}
      </div>

      <!-- Tab content sections -->
      <div class="tab-contents">
        {versions.map((version, index) => (
          <div class="tab-content">
            <div class="prose prose-lg max-w-none dark:prose-invert">
              <version.Content />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
