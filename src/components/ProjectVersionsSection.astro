---
import { getProjectVersions, hasMultipleVersions } from '../utils/versionUtils';
import ProjectGallery from './ProjectGallery';
import { Image } from 'astro:assets';
import { formatProjectDate, calculateDuration } from '../utils/dateUtils';

interface Props {
  projectSlug?: string;
  className?: string;
  sectionTitle?: string;
  showTitle?: boolean;
  titleDepth?: number; // 0-4 like ModularSection (0=h2/text-3xl, 1=h3/text-2xl, etc.)
  titleSpacing?: string; // Spacing between title and tabs
  contentSpacing?: string; // Spacing between tabs and content
  // Tab styling
  tabSize?: 'sm' | 'md' | 'lg' | 'xl';
  tabStyle?: 'boxed' | 'bordered' | 'lifted';
  // Custom overrides (use these sparingly)
  tabWidth?: string;
  tabHeight?: string;
  tabPadding?: string;
  fontSize?: string;
}

const { 
  projectSlug: providedSlug, 
  className = '', 
  sectionTitle = 'Evolution Timeline',
  showTitle = true,
  titleDepth = 1,
  titleSpacing = '1.5rem',
  contentSpacing = '2rem',
  tabSize = 'lg',
  tabStyle = 'boxed',
  tabWidth,
  tabHeight,
  tabPadding,
  fontSize
} = Astro.props;

// Auto-detect project slug from file path if not provided
let projectSlug = providedSlug;
if (!projectSlug) {
  // Get the current file's URL path and extract project slug
  const urlParts = Astro.url.pathname.split('/');
  const projectIndex = urlParts.indexOf('projects');
  if (projectIndex !== -1 && urlParts[projectIndex + 1]) {
    projectSlug = urlParts[projectIndex + 1];
  } else {
    // Fallback: try to get from request URL or throw error
    throw new Error('ProjectVersionsSection: Unable to auto-detect project slug. Please provide projectSlug prop.');
  }
}

/**
 * Calculate responsive width percentages for version header gallery layout
 * Reuses the same logic as the main project header
 */
function getVersionHeaderWidths(version: any) {
  const gap = '2rem'; // This should match the gap-8 class (2rem = 32px)
  
  // Check for cover options first, then gallery options
  const layoutSource = version?.coverOptions?.width || version?.galleryOptions?.layout;
  
  if (!layoutSource) {
    return { gallery: `calc(50% - ${gap} / 2)`, info: `calc(50% - ${gap} / 2)` }; // Default 50:50
  }
  
  const layout = layoutSource;
  
  // Percentage format: "60%"
  if (typeof layout === 'string' && layout.endsWith('%')) {
    const percentage = parseFloat(layout);
    if (!isNaN(percentage) && percentage > 0 && percentage < 100) {
      const galleryPercent = percentage;
      const infoPercent = 100 - percentage;
      return {
        gallery: `calc(${galleryPercent}% - ${gap} * ${infoPercent / 100})`,
        info: `calc(${infoPercent}% - ${gap} * ${galleryPercent / 100})`
      };
    }
  }
  
  // Ratio format: "55:45", "3:2", etc.
  if (typeof layout === 'string' && layout.includes(':')) {
    const [left, right] = layout.split(':').map(Number);
    if (!isNaN(left) && !isNaN(right) && left > 0 && right > 0) {
      const total = left + right;
      const galleryPercent = (left / total) * 100;
      const infoPercent = (right / total) * 100;
      
      return {
        gallery: `calc(${galleryPercent}% - ${gap} * ${infoPercent / 100})`,
        info: `calc(${infoPercent}% - ${gap} * ${galleryPercent / 100})`
      };
    }
  }
  
  // Named layouts
  const namedLayouts: { [key: string]: { gallery: string, info: string } } = {
    'narrow-wide': { 
      gallery: `calc(33.333% - ${gap} * 0.66667)`, 
      info: `calc(66.667% - ${gap} * 0.33333)` 
    },
    'wide-narrow': { 
      gallery: `calc(66.667% - ${gap} * 0.33333)`, 
      info: `calc(33.333% - ${gap} * 0.66667)` 
    },
    'equal': { 
      gallery: `calc(50% - ${gap} / 2)`, 
      info: `calc(50% - ${gap} / 2)` 
    },
    'golden': { 
      gallery: `calc(61.804% - ${gap} * 0.38196)`, 
      info: `calc(38.196% - ${gap} * 0.61804)` 
    },
    'sidebar': { 
      gallery: `calc(25% - ${gap} * 0.75)`, 
      info: `calc(75% - ${gap} * 0.25)` 
    },
    'reverse-sidebar': { 
      gallery: `calc(75% - ${gap} * 0.25)`, 
      info: `calc(25% - ${gap} * 0.75)` 
    }
  };
  
  if (namedLayouts[layout]) {
    return namedLayouts[layout];
  }
  
  // Fallback to 50:50
  return { gallery: `calc(50% - ${gap} / 2)`, info: `calc(50% - ${gap} / 2)` };
}

// Check if this project has multiple versions
let hasVersions = false;
let versionContents: any[] = [];

try {
  hasVersions = await hasMultipleVersions(projectSlug);
  
  if (hasVersions) {
    const versions = await getProjectVersions(projectSlug);
    
    versionContents = await Promise.all(
      versions.map(async (version) => {
        const { Content } = await version.content.render();
        return {
          version: version.version,
          title: version.title,
          data: version.content.data, // Include the full frontmatter data
          Content
        };
      })
    );
  }
} catch (error) {
  console.error('ProjectVersionsSection: Error:', error);
}

// Title formatting functions matching ModularSection approach
const getHeadingLevel = (depth: number) => {
  if (depth === 0) return 'h2';
  if (depth === 1) return 'h3'; 
  if (depth === 2) return 'h4';
  if (depth === 3) return 'h5';
  return 'h6';
};

const getHeadingClass = (depth: number) => {
  // Base classes without margin-bottom since we'll use custom spacing
  if (depth === 0) return 'text-3xl font-bold';
  if (depth === 1) return 'text-2xl font-bold';
  if (depth === 2) return 'text-xl font-bold';
  if (depth === 3) return 'text-lg font-bold';
  return 'text-base font-bold';
};

const headingLevel = getHeadingLevel(titleDepth);
const headingClass = getHeadingClass(titleDepth);
---

<style>
  .version-tabs {
    display: block;
  }
  
  /* Responsive cover layout for version headers */
  .responsive-cover-layout {
    --gallery-width: calc(50% - 1rem);
    --info-width: calc(50% - 1rem);
  }
  
  .cover-gallery-col {
    width: 100%;
    /* Remove any default padding/margin that might cause extra space */
    padding: 0;
    margin: 0;
    /* Make container fit content exactly */
    display: inline-block;
    line-height: 0;
    vertical-align: top;
  }
  
  .cover-info-col {
    width: 100%;
    /* Remove any default padding/margin */
    padding: 0;
    margin: 0;
    /* Ensure the container fits its content exactly */
    display: flex;
    flex-direction: column;
  }
  
  @media (min-width: 1024px) {
    .cover-gallery-col {
      width: var(--gallery-width);
    }
    
    .cover-info-col {
      width: var(--info-width);
    }
  }
  
  .version-tabs input[type="radio"] {
    display: none;
  }
  
  .version-tabs .tab-content {
    display: none;
  }

  /* Show content when corresponding radio is checked */
  .version-tabs input[type="radio"]:nth-of-type(1):checked ~ .tab-contents .tab-content:nth-of-type(1),
  .version-tabs input[type="radio"]:nth-of-type(2):checked ~ .tab-contents .tab-content:nth-of-type(2),
  .version-tabs input[type="radio"]:nth-of-type(3):checked ~ .tab-contents .tab-content:nth-of-type(3),
  .version-tabs input[type="radio"]:nth-of-type(4):checked ~ .tab-contents .tab-content:nth-of-type(4),
  .version-tabs input[type="radio"]:nth-of-type(5):checked ~ .tab-contents .tab-content:nth-of-type(5) {
    display: block;
  }

  /* Enhanced active tab button styling using DaisyUI primary colors */
  .version-tabs input[type="radio"]:nth-of-type(1):checked ~ .tab-buttons .tab-button:nth-of-type(1),
  .version-tabs input[type="radio"]:nth-of-type(2):checked ~ .tab-buttons .tab-button:nth-of-type(2),
  .version-tabs input[type="radio"]:nth-of-type(3):checked ~ .tab-buttons .tab-button:nth-of-type(3),
  .version-tabs input[type="radio"]:nth-of-type(4):checked ~ .tab-buttons .tab-button:nth-of-type(4),
  .version-tabs input[type="radio"]:nth-of-type(5):checked ~ .tab-buttons .tab-button:nth-of-type(5) {
    background-color: #0082ce; /* Light mode primary */
    color: white;
    border: 2px solid #0082ce;
    transform: translateY(-1px);
    font-weight: 600;
  }

  /* Dark mode override */
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(1):checked ~ .tab-buttons .tab-button:nth-of-type(1),
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(2):checked ~ .tab-buttons .tab-button:nth-of-type(2),
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(3):checked ~ .tab-buttons .tab-button:nth-of-type(3),
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(4):checked ~ .tab-buttons .tab-button:nth-of-type(4),
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(5):checked ~ .tab-buttons .tab-button:nth-of-type(5) {
    background-color: #1c4e7f; /* Dark mode primary */
    color: white;
    border: 2px solid #1c4e7f;
  }

  /* Hover effects for inactive tabs using theme-appropriate colors */
  .version-tabs .tab-buttons .tab-button:hover {
    background-color: rgba(0, 130, 206, 0.1); /* Light mode primary with transparency */
    border-color: rgba(0, 130, 206, 0.3);
    transform: translateY(-0.5px);
    transition: all 0.2s ease;
  }

  /* Dark mode hover effects */
  [data-theme="business"] .version-tabs .tab-buttons .tab-button:hover {
    background-color: rgba(28, 78, 127, 0.1); /* Dark mode primary with transparency */
    border-color: rgba(28, 78, 127, 0.3);
  }

  /* Override hover for active tabs - maintain primary color styling */
  .version-tabs input[type="radio"]:nth-of-type(1):checked ~ .tab-buttons .tab-button:nth-of-type(1):hover,
  .version-tabs input[type="radio"]:nth-of-type(2):checked ~ .tab-buttons .tab-button:nth-of-type(2):hover,
  .version-tabs input[type="radio"]:nth-of-type(3):checked ~ .tab-buttons .tab-button:nth-of-type(3):hover,
  .version-tabs input[type="radio"]:nth-of-type(4):checked ~ .tab-buttons .tab-button:nth-of-type(4):hover,
  .version-tabs input[type="radio"]:nth-of-type(5):checked ~ .tab-buttons .tab-button:nth-of-type(5):hover {
    background-color: rgba(0, 130, 206, 0.9); /* Slightly lighter primary on hover */
    color: white;
    border-color: rgba(0, 130, 206, 0.9);
    transform: translateY(-1px);
  }

  /* Dark mode active tab hover */
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(1):checked ~ .tab-buttons .tab-button:nth-of-type(1):hover,
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(2):checked ~ .tab-buttons .tab-button:nth-of-type(2):hover,
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(3):checked ~ .tab-buttons .tab-button:nth-of-type(3):hover,
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(4):checked ~ .tab-buttons .tab-button:nth-of-type(4):hover,
  [data-theme="business"] .version-tabs input[type="radio"]:nth-of-type(5):checked ~ .tab-buttons .tab-button:nth-of-type(5):hover {
    background-color: rgba(28, 78, 127, 0.9); /* Slightly lighter primary on hover */
    color: white;
    border-color: rgba(28, 78, 127, 0.9);
  }

  /* Base tab button styling that works with all sizes */
  .version-tabs .tab-buttons {
    display: flex;
    gap: 0.5rem;
    border-radius: 0.75rem;
    padding: 0.5rem;
  }

  /* Default boxed style */
  .version-tabs.style-boxed .tab-buttons {
    background-color: hsl(var(--b2));
    border: none;
  }

  /* Bordered style - clean outline look using theme-appropriate primary colors */
  .version-tabs.style-bordered .tab-buttons {
    background: transparent;
    border: 2px solid #0082ce; /* Light mode primary */
    padding: 0.75rem;
  }

  /* Dark mode bordered style */
  [data-theme="business"] .version-tabs.style-bordered .tab-buttons {
    border: 2px solid #1c4e7f; /* Dark mode primary */
  }

  /* Lifted style - elevated with shadow and background using theme-appropriate primary colors */
  .version-tabs.style-lifted .tab-buttons {
    background: hsl(var(--b1));
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.1), 
                0 2px 6px -1px rgba(0, 0, 0, 0.05);
    border: 1px solid #0082ce; /* Light mode primary */
    border-radius: 1rem;
  }

  /* Dark mode lifted style */
  [data-theme="business"] .version-tabs.style-lifted .tab-buttons {
    border: 1px solid #1c4e7f; /* Dark mode primary */
  }

  .version-tabs .tab-buttons .tab-button {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 0.5rem;
    transition: all 0.25s cubic-bezier(0.4, 0.0, 0.2, 1);
    font-weight: 500;
    border: 2px solid transparent;
    white-space: nowrap;
  }

  /* Size variants - with mobile responsiveness */
  .version-tabs.size-sm .tab-buttons .tab-button { 
    font-size: 0.875rem; 
    padding: 0.5rem 1rem; 
  }
  .version-tabs.size-md .tab-buttons .tab-button { 
    font-size: 1rem; 
    padding: 0.75rem 1.25rem; 
  }
  .version-tabs.size-lg .tab-buttons .tab-button { 
    font-size: 1.125rem; 
    padding: 1rem 1.5rem; 
  }
  .version-tabs.size-xl .tab-buttons .tab-button { 
    font-size: 1.25rem; 
    padding: 1.25rem 2rem; 
  }

  /* Mobile responsiveness - smaller tabs on mobile */
  @media (max-width: 768px) {
    .version-tabs .tab-buttons {
      gap: 0.25rem;
      padding: 0.375rem;
      flex-wrap: wrap;
    }
    
    .version-tabs.size-sm .tab-buttons .tab-button { 
      font-size: 0.8rem; 
      padding: 0.375rem 0.75rem; 
    }
    .version-tabs.size-md .tab-buttons .tab-button { 
      font-size: 0.875rem; 
      padding: 0.5rem 1rem; 
    }
    .version-tabs.size-lg .tab-buttons .tab-button { 
      font-size: 0.9rem; 
      padding: 0.625rem 1rem; 
    }
    .version-tabs.size-xl .tab-buttons .tab-button { 
      font-size: 1rem; 
      padding: 0.75rem 1.25rem; 
    }

    /* Force full width on mobile for better usability */
    .version-tabs .tab-buttons {
      width: 100%;
    }
    
    .version-tabs .tab-buttons .tab-button {
      flex: 1;
      text-align: center;
      min-width: 0; /* Allow text to wrap if needed */
    }

    /* Adjust custom dimensions for mobile */
    .version-tabs.custom-dimensions .tab-buttons .tab-button {
      width: auto;
      height: auto;
      min-width: 0;
      flex: 1;
      font-size: calc(var(--tab-font-size, 1.125rem) * 0.85); /* Slightly smaller text on mobile */
    }
  }
  
  .version-tabs .tab-contents {
    margin-top: var(--content-spacing, 2rem);
  }

  /* Custom dimension overrides - these take precedence over size presets */
  .version-tabs.custom-dimensions .tab-buttons .tab-button {
    width: var(--tab-width, auto);
    height: var(--tab-height, auto);
    padding: var(--tab-padding, 1rem 1.5rem);
    font-size: var(--tab-font-size, 1.125rem);
    min-width: var(--tab-width, auto);
    min-height: var(--tab-height, auto);
  }
</style>

{hasVersions && versionContents.length > 0 && (
  <section class={`project-versions ${className}`}>
    <div 
      class={`version-tabs size-${tabSize} style-${tabStyle} ${(tabWidth || tabHeight || tabPadding || fontSize) ? 'custom-dimensions' : ''} ${className}`}
      style={{
        ...(tabWidth && { '--tab-width': tabWidth }),
        ...(tabHeight && { '--tab-height': tabHeight }),
        ...(tabPadding && { '--tab-padding': tabPadding }),
        ...(fontSize && { '--tab-font-size': fontSize }),
        '--content-spacing': contentSpacing
      }}
    >
      {showTitle && (
        <div style={{ marginBottom: titleSpacing }}>
          {headingLevel === 'h2' && <h2 class={headingClass}>{sectionTitle}</h2>}
          {headingLevel === 'h3' && <h3 class={headingClass}>{sectionTitle}</h3>}
          {headingLevel === 'h4' && <h4 class={headingClass}>{sectionTitle}</h4>}
          {headingLevel === 'h5' && <h5 class={headingClass}>{sectionTitle}</h5>}
          {headingLevel === 'h6' && <h6 class={headingClass}>{sectionTitle}</h6>}
        </div>
      )}
      <!-- Radio inputs for state management -->
      {versionContents.map((version, index) => (
        <input 
          type="radio" 
          name="version_tabs" 
          id={`tab-${index}`}
          checked={index === 0}
        />
      ))}

      <!-- Tab buttons -->
      <div class="tab-buttons">
        {versionContents.map((version, index) => (
          <label 
            for={`tab-${index}`}
            class="tab-button"
          >
            <span class="font-semibold">{version.data.tabTitle || version.data.title}</span>
          </label>
        ))}
      </div>

      <!-- Tab content sections -->
      <div class="tab-contents">
        {versionContents.map((version, index) => {
          const versionHeaderWidths = getVersionHeaderWidths(version.data);
          
          return (
          <div class="tab-content">
            {/* Optional Version Header - same format as main project header */}
            {(version.data.headerTitle || version.data.headerDescription || version.data.cover || (version.data.gallery && version.data.gallery.length > 0) || version.data.metrics || version.data.competitions) && (
              <header class="mb-8">
                <div 
                  class="flex flex-col lg:flex-row gap-8 responsive-cover-layout items-start"
                  style={`--gallery-width: ${versionHeaderWidths.gallery}; --info-width: ${versionHeaderWidths.info};`}
                >
                  {/* Version Image/Gallery */}
                  <div class="cover-gallery-col lg:flex-none">
                    {version.data.gallery && version.data.gallery.length > 0 ? (
                      <ProjectGallery 
                        images={version.data.gallery as any}
                        autoplay={version.data.galleryOptions?.autoplay ?? true}
                        autoplayInterval={version.data.galleryOptions?.autoplayInterval ?? 4000}
                        showThumbnails={version.data.galleryOptions?.showThumbnails ?? true}
                        loop={version.data.galleryOptions?.loop ?? true}
                        client:load
                      />
                    ) : version.data.cover ? (
                      <Image 
                        src={version.data.cover}
                        alt={version.data.coverCaption || version.data.headerTitle || version.data.title}
                        width={600}
                        height={400}
                        class="w-full h-auto rounded-lg shadow-lg"
                      />
                    ) : (
                      /* Spacer div to maintain layout when only info side has content */
                      <div class="aspect-[4/3] bg-base-200/30 rounded-lg flex items-center justify-center">
                        <span class="text-base-content/40">No image available</span>
                      </div>
                    )}
                  </div>
                  
                  {/* Version Header Info */}
                  <div class="cover-info-col lg:flex-none">
                    <h1 class={`font-bold mb-4 ${
                      version.data.headerTitleSize === 'sm' ? 'text-lg' :
                      version.data.headerTitleSize === 'md' ? 'text-xl' :
                      version.data.headerTitleSize === 'lg' ? 'text-2xl' :
                      version.data.headerTitleSize === 'xl' ? 'text-3xl' :
                      version.data.headerTitleSize === '2xl' ? 'text-4xl' :
                      version.data.headerTitleSize === '3xl' ? 'text-5xl' :
                      version.data.headerTitleSize === '4xl' ? 'text-6xl' :
                      'text-4xl' // default
                    }`}>{version.data.headerTitle || version.data.title}</h1>
                    <p class="text-lg text-base-content/70 mb-6">{version.data.headerDescription || version.data.description}</p>
                    
                    {/* Version Timeline */}
                    <div class="mb-4">
                      <div class="text-sm text-base-content/60">
                        {version.data.status === 'completed' && version.data.endDate ? (
                          <div class="flex items-center gap-4">
                            <span class="badge badge-success">Completed</span>
                            <span>{formatProjectDate(version.data.startDate)} → {formatProjectDate(version.data.endDate)}</span>
                            <span class="font-medium">({calculateDuration(version.data.startDate, version.data.endDate)})</span>
                          </div>
                        ) : version.data.status === 'in-progress' ? (
                          <div class="flex items-center gap-4">
                            <span class="badge badge-warning">In Progress</span>
                            <span>Started {formatProjectDate(version.data.startDate)}</span>
                          </div>
                        ) : (
                          <div class="flex items-center gap-4">
                            <span class="badge badge-info">Planned</span>
                            <span>Planned for {formatProjectDate(version.data.startDate)}</span>
                          </div>
                        )}
                      </div>
                    </div>
                    
                    {/* Version Metrics */}
                    {version.data.metrics && version.data.metrics.customFields && version.data.metrics.customFields.length > 0 && (
                      <div class="mb-6">
                        <h3 class="text-sm font-semibold mb-2">{version.data.metrics.sectionTitle || "Version Stats"}</h3>
                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 text-sm">
                          {version.data.metrics.customFields.map((field: any) => (
                            <div class="stat-item text-left">
                              <div class="text-base-content/60">{field.label}:</div>
                              <div class={`font-medium ${
                                field.highlight && field.color ? `text-${field.color}` : ''
                              }`}>
                                {field.value}{field.unit ? ` ${field.unit}` : ''}
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                    
                    {/* Version Competition History */}
                    {version.data.competitions && version.data.competitions.length > 0 && (
                      <div class="mb-6">
                        {(() => {
                          const hasRecords = version.data.competitions.some((comp: any) => comp.record);
                          const maxDisplay = version.data.competitionsOptions?.maxDisplay ?? 3;
                          const competitionsToShow = maxDisplay === 0 ? version.data.competitions : version.data.competitions.slice(0, maxDisplay);
                          
                          return (
                            <div class="space-y-2">
                              {/* Mobile Layout */}
                              <div class="lg:hidden">
                                {/* Mobile Headers */}
                                <div class="flex items-center justify-between text-xs pb-1 border-b border-base-content/70">
                                  <span class="text-sm text-base-content/70">{version.data.competitionsOptions?.sectionTitle || "Competition History"}</span>
                                  <div class="flex items-center gap-4 text-sm text-base-content/70">
                                    {hasRecords && <span class="w-12 text-center">Record</span>}
                                    <span class="w-16 text-center">Placement</span>
                                  </div>
                                </div>
                                
                                {/* Mobile Entries */}
                                {competitionsToShow.map((comp: any) => (
                                  <div class="pt-1 pb-1 border-b border-base-content/25">
                                    <div class="flex items-center justify-between">
                                      <div class="flex flex-col flex-1 min-w-0">
                                        <div class="mb-0.5">
                                          {comp.url ? (
                                            <a 
                                              href={comp.url} 
                                              class="font-medium text-base-content hover:text-blue-400 transition-colors underline decoration-solid underline-offset-2 text-sm truncate"
                                              target="_blank"
                                              rel="noopener noreferrer"
                                              title={`Read more about ${comp.name}`}
                                            >
                                              {comp.name}
                                            </a>
                                          ) : (
                                            <span class="font-medium text-sm truncate">{comp.name}</span>
                                          )}
                                        </div>
                                        <div class="text-xs text-base-content/70">{comp.date}</div>
                                      </div>
                                      
                                      <div class="flex items-center gap-4 flex-shrink-0 ml-3">
                                        {comp.record && (
                                          <div class="w-12 flex justify-center">
                                            <span class="badge badge-sm badge-outline min-w-12 text-center">{comp.record}</span>
                                          </div>
                                        )}
                                        {!comp.record && hasRecords && (
                                          <span class="w-12"></span>
                                        )}
                                        <div class="w-16 flex justify-center">
                                          <span class={`badge badge-sm min-w-16 text-center ${
                                            typeof comp.placement === 'number' && comp.placement === 1 ? 'badge-warning' :
                                            typeof comp.placement === 'string' && (comp.placement.toLowerCase().includes('1st') || comp.placement.toLowerCase().includes('champion')) ? 'badge-warning' :
                                            typeof comp.placement === 'number' && comp.placement === 2 ? 'badge-silver' :
                                            typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('2nd') ? 'badge-silver' :
                                            typeof comp.placement === 'number' && comp.placement === 3 ? 'badge-accent' :
                                            typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('3rd') ? 'badge-accent' :
                                            'badge-info'
                                          }`}>
                                            {typeof comp.placement === 'number' ? 
                                              comp.placement === 1 ? '1st' :
                                              comp.placement === 2 ? '2nd' :
                                              comp.placement === 3 ? '3rd' :
                                              `${comp.placement}th` :
                                              comp.placement
                                            }
                                          </span>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                ))}
                              </div>

                              {/* Desktop Layout */}
                              <div class="hidden lg:block">
                                {/* Desktop Headers */}
                                <div class="flex items-center justify-between text-xs pb-1 border-b border-base-content/70">
                                  <span class="text-sm text-base-content/70">{version.data.competitionsOptions?.sectionTitle || "Competition History"}</span>
                                  <div class="flex items-center gap-6 text-sm text-base-content/70">
                                    <span class="w-32 text-right">Date</span>
                                    {hasRecords && <span class="w-12 text-center">Record</span>}
                                    <span class="w-16 text-center">Placement</span>
                                  </div>
                                </div>
                                
                                {/* Desktop Entries */}
                                {competitionsToShow.map((comp: any) => (
                                  <div class="flex items-center justify-between text-sm py-2 border-b border-base-content/25">
                                    <div class="flex items-center gap-3">
                                      {comp.url ? (
                                        <a 
                                          href={comp.url} 
                                          class="font-medium text-base-content hover:text-blue-400 transition-colors underline decoration-solid underline-offset-2"
                                          target="_blank"
                                          rel="noopener noreferrer"
                                          title={`Read more about ${comp.name}`}
                                        >
                                          {comp.name}
                                        </a>
                                      ) : (
                                        <span class="font-medium">{comp.name}</span>
                                      )}
                                    </div>
                                    <div class="flex items-center gap-6">
                                      <span class="w-32 text-right text-base-content">{comp.date}</span>
                                      {comp.record && (
                                        <span class="badge badge-sm badge-outline w-12 text-center">{comp.record}</span>
                                      )}
                                      {!comp.record && hasRecords && (
                                        <span class="w-12"></span>
                                      )}
                                      <span class={`badge badge-sm w-16 text-center ${
                                        typeof comp.placement === 'number' && comp.placement === 1 ? 'badge-warning' :
                                        typeof comp.placement === 'string' && (comp.placement.toLowerCase().includes('1st') || comp.placement.toLowerCase().includes('champion')) ? 'badge-warning' :
                                        typeof comp.placement === 'number' && comp.placement === 2 ? 'badge-silver' :
                                        typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('2nd') ? 'badge-silver' :
                                        typeof comp.placement === 'number' && comp.placement === 3 ? 'badge-accent' :
                                        typeof comp.placement === 'string' && comp.placement.toLowerCase().includes('3rd') ? 'badge-accent' :
                                        'badge-info'
                                      }`}>
                                        {typeof comp.placement === 'number' ? 
                                          comp.placement === 1 ? '1st' :
                                          comp.placement === 2 ? '2nd' :
                                          comp.placement === 3 ? '3rd' :
                                          `${comp.placement}th` :
                                          comp.placement
                                        }
                                      </span>
                                    </div>
                                  </div>
                                ))}
                              </div>
                              
                              {version.data.competitions.length > (version.data.competitionsOptions?.maxDisplay ?? 3) && (version.data.competitionsOptions?.maxDisplay ?? 3) > 0 && (
                                <div class="text-xs text-base-content/60 text-center mt-2">
                                  And {version.data.competitions.length - (version.data.competitionsOptions?.maxDisplay ?? 3)} more competition{version.data.competitions.length - (version.data.competitionsOptions?.maxDisplay ?? 3) !== 1 ? 's' : ''}...
                                </div>
                              )}
                            </div>
                          );
                        })()}
                      </div>
                    )}
                    
                    {/* Version Action Links */}
                    <div class="flex flex-wrap gap-3">
                      {version.data.githubUrl && (
                        <a 
                          href={version.data.githubUrl} 
                          class="btn btn-outline"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          View on GitHub
                        </a>
                      )}
                      {version.data.liveUrl && (
                        <a 
                          href={version.data.liveUrl} 
                          class="btn btn-primary"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Live Demo
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </header>
            )}

            {/* Content (always shown) */}
            <div class="prose prose-lg max-w-none dark:prose-invert">
              <version.Content />
            </div>
          </div>
          );
        })}
      </div>
    </div>
  </section>
)}
