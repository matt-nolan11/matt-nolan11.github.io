---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import logo from "../assets/logo.svg";
import { navLinks } from '../config/navLinks';

import { SEO } from "astro-seo";

export interface Props {
  /** Optional granular SEO overrides coming from .astro pages or components */
  seo?: {
    title?: string;
    description?: string;
  };
  /** Standard front‑matter fields coming from Markdown/MDX pages */
  title?: string;
  description?: string;
  /** Page type for width control - determines which CSS variables to use */
  pageType?: 'landing' | 'project' | 'post' | 'projects-index' | 'posts-index' | 'about' | 'default';
  /** Optional custom max-width override (CSS value like "80rem", "1200px", "calc(100vw - 10rem)") */
  customMaxWidth?: string;
}

// Destructure front‑matter fields as well as the existing `seo` object
const { seo = {}, title, description, pageType = 'default', customMaxWidth } = Astro.props;

/** Merge explicit `seo` overrides with any front‑matter fields.
 *  Values defined in `seo` win over front‑matter, preserving backward compatibility.
 */
const seoConfig = {
  ...seo,
  title: seo.title ?? title,
  description: seo.description ?? description,
};

// Get CSS variables based on page type
const getPageStyles = (type: string) => {
  const baseVars: Record<string, Record<string, string>> = {
    'default': {
      '--page-max-width': 'var(--content-max-width)',
      '--page-px': 'var(--content-px)',
      '--page-py': 'var(--content-py)'
    },
    'landing': {
      '--page-max-width': 'var(--landing-max-width)',
      '--page-px': 'var(--landing-px)',
      '--page-py': 'var(--landing-py)'
    },
    'project': {
      '--page-max-width': 'var(--project-max-width)',
      '--page-px': 'var(--project-px)',
      '--page-py': 'var(--project-py)'
    },
    'post': {
      '--page-max-width': 'var(--post-max-width)',
      '--page-px': 'var(--post-px)',
      '--page-py': 'var(--post-py)'
    },
    'projects-index': {
      '--page-max-width': 'var(--projects-index-max-width)',
      '--page-px': 'var(--projects-index-px)',
      '--page-py': 'var(--projects-index-py)'
    },
    'posts-index': {
      '--page-max-width': 'var(--posts-index-max-width)',
      '--page-px': 'var(--posts-index-px)',
      '--page-py': 'var(--posts-index-py)'
    },
    'about': {
      '--page-max-width': 'var(--about-max-width)',
      '--page-px': 'var(--about-px)',
      '--page-py': 'var(--about-py)'
    }
  };
  
  return baseVars[type] || baseVars['default'];
};
---

<!doctype html>
<html lang="en" data-theme="business">
  <head>
    <meta charset="utf-8" />
    <!-- Persisted theme (dark / light) is applied as early as possible -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme') || 'business';
      document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
    <SEO
      {...seoConfig}
      title={seoConfig.title}
      description={seoConfig.description ??
        "Matt Nolan – Robotics Engineer & Maker"}
      titleTemplate="%s – Matt Nolan"
      titleDefault="Matt Nolan – Robotics Engineer"
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Matt Nolan",
        jobTitle: "Robotics Engineer",
        url: Astro.site,
        image: new URL(logo.src, Astro.site).href,
        description: "Robotics engineer and maker passionate about autonomous systems, robotic manipulation, and space technology",
        sameAs: [
          "https://github.com/matt-nolan11",
          "https://linkedin.com/in/matt-nolan11",
          "https://youtube.com/@matt-nolan11"
        ],
      })}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Comprehensive favicon support -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body
    class="bg-base-100 text-base-content min-h-dvh overflow-x-hidden"
    style={`${Object.entries(getPageStyles(pageType)).map(([key, value]) => `${key}: ${value}`).join('; ')}`}
    data-pagetype={pageType}
  >
  <div class="drawer">
    <input id="nav-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content flex flex-col min-h-dvh">
      <Navbar />

      <!-- Main page content -->
      <!-- w-full is load-bearing: `mx-auto` sets auto side margins, which
           suppresses the cross-axis stretch this would otherwise get as an item
           of the column flexbox above. Without an explicit width, main is then
           sized shrink-to-fit from its content's max-content width, so a page
           whose content happens to be narrow (a project whose default version
           tab holds only a short banner, say) renders main narrower than
           --page-max-width and its margins stop lining up with the navbar. -->
      <main 
        class="flex-1 mx-auto w-full"
        style={`max-width: ${customMaxWidth || 'var(--page-max-width)'}; padding-left: var(--page-px); padding-right: var(--page-px); padding-top: var(--page-py); padding-bottom: var(--page-py);`}
      >
        <slot />
      </main>

      <Footer />
    </div>
    <div class="drawer-side lg:hidden">
      <label for="nav-drawer" class="drawer-overlay"></label>
      <!-- w-80 (20rem) is nearly the full width of a narrow phone, so cap it
           at half the viewport. Effective width is min(20rem, 50vw). -->
      <ul class="menu p-4 w-80 max-w-[50vw] bg-base-100 min-h-full">
        {navLinks.map(link => (
          <li><a href={link.href} class="normal-case font-bold text-xl">{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <style>
    /* Ensure drawer appears above header and has proper background */
    .drawer-side {
      z-index: 1000;
    }

    /* While the drawer is open, neither the page behind it nor pull-to-refresh
       responds to a vertical drag. That is the behaviour we want, but the cause
       is only partly understood: daisyUI's `overscroll-behavior: contain` on
       .drawer-side is one contributor, yet overriding it to `auto` changed
       neither behaviour, so something further up the scroll chain is also
       swallowing the gesture and has not been pinned down. Worth re-measuring
       from scratch rather than trusting this note if it ever needs to change. */

    /* Deliberately no `body { overflow: hidden }` scroll lock while the drawer
       is open. It removes the root scroller, which also removes pull-to-refresh
       on mobile. It is unnecessary anyway: daisyUI gives .drawer-side
       `overscroll-behavior: contain`, so a drag on the drawer cannot chain
       through to the document, and the panel itself now fits its container
       exactly (see the 100dvh note below) so it has nothing of its own to
       scroll. */
    
    .drawer-overlay {
      z-index: 999;
    }
    
    .drawer-side .menu {
      /* dvh, not vh. daisyUI sizes .drawer-side as height:100dvh with
         overflow-y:auto, and on mobile 100vh is taller than 100dvh because vh
         ignores the retractable browser chrome. Forcing the menu to 100vh made
         it overflow its own scroll container by exactly the URL-bar height, so
         the drawer scrolled even with only a handful of links in it. */
      min-height: 100dvh;
      position: relative;
      z-index: 1001;
    }

    /* Theme-specific backgrounds */
    [data-theme="business"] .drawer-side .menu {
      background-color: #202020 !important;
    }

    [data-theme="corporate"] .drawer-side .menu {
      background-color: #ffffff !important;
    }

    /* Smooth window resize transitions that preserve drawer animations */
    .window-resizing {
      transition: none !important;
    }
  </style>

  <!-- Ultra smooth window resize transitions that preserve drawer animations -->
  <script is:inline>
    // Smooth layout transitions during window resize - carefully avoiding drawer interference
    let isResizing = false;
    let resizeTimeout;
    let transitionsEnabled = false;
    
    // Enable smooth transitions 5 seconds after page load to prevent interference with initial layout
    setTimeout(() => {
      transitionsEnabled = true;
      document.body.classList.add('transitions-enabled');
    }, 5000);
    
    function handleResize() {
      // Skip if drawer is open to avoid any interference, or if transitions aren't enabled yet
      const drawerOpen = document.getElementById('nav-drawer')?.checked;
      if (drawerOpen || !transitionsEnabled) return;
      
      if (!isResizing) {
        isResizing = true;
        document.body.classList.add('window-resizing');
      }
      
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        isResizing = false;
        document.body.classList.remove('window-resizing');
      }, 400);
    }
    
    window.addEventListener('resize', handleResize);
    window.addEventListener('orientationchange', handleResize);
    
    // Ensure drawer state changes immediately clear resize transitions
    const drawerToggle = document.getElementById('nav-drawer');
    if (drawerToggle) {
      drawerToggle.addEventListener('change', () => {
        document.body.classList.remove('window-resizing');
        clearTimeout(resizeTimeout);
        isResizing = false;
      });
    }
  </script>

  </body>
</html>
