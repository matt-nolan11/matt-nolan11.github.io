{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "*.astro",
    "*.ts",
    "*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*_backup*",
    "**/*_fixed*",
    "**/*.backup.*",
    "**/*.temp.*"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}